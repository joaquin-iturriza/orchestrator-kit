#!/usr/bin/env python3
"""site -- one interface to every cluster that has GPUs for us.

    site list                          what exists, and is it reachable
    site status <site>                 queue, idle GPUs, my jobs
    site sync   <site> <project>       push local commits, fast-forward the site
    site submit <site> <project> <job> [--est-gpu-hours N] -> run id
    site poll   [<run>...]             update run states from the scheduler
    site logs   <run> [-n N]
    site fetch  <run> [--what tier0|all]
    site runs   [--project P] [--site S] [--state S]
    site where  <artifact-or-run>      where a result actually lives
    site shell  <site> [--gpu]

Design:
  * The working copy is LOCAL. Code reaches a site by git, never by a mount.
    Only scheduler traffic crosses the wire.
  * A run has an identity of its own (project @ commit x config @ site), so
    "where is that model" is a lookup, not a memory.
  * Tier 0 (metrics, configs, logs, small plots) is pulled home on completion
    and is readable with every cluster down. Big checkpoints stay put and are
    recorded with their locations.
"""
import argparse, base64, datetime, json, os, re, shlex, sqlite3, subprocess, sys, time, uuid

try:
    import tomllib
except ModuleNotFoundError:            # py<3.11 (Jean Zay ships 3.9)
    import tomli as tomllib

CFG_DIR = os.path.expanduser("~/.config/ccorch")
SITES   = os.path.join(CFG_DIR, "sites.toml")
PROJS   = os.path.join(CFG_DIR, "projects.toml")
HOME    = os.environ.get("CCORCH_HOME") or os.path.expanduser("~/.local/share/ccorch")   # tests: a copy
# the kit's state directory under $HOME on every site (gate, wrappers, CPU-job results): another name keeps a second
# installation on the same cluster account from overwriting the first one's gate
REMOTE_DIR = os.environ.get("CCORCH_REMOTE_DIR", ".ccorch")


def _rd(text):
    """`text` with the default remote state dir replaced by REMOTE_DIR."""
    return text.replace("$HOME/.ccorch", "$HOME/" + REMOTE_DIR).replace('".ccorch"', '"%s"' % REMOTE_DIR)
DB      = os.path.join(HOME, "runs.db")
STORE   = os.path.join(HOME, "artifacts")      # tier-0 mirror, always local

TIER0 = ["metrics.json", "*metrics*.json", "summary.json", "config.yaml", "config.json",
         "*.log", "*.out", "*.err", "results*.json", "*.csv", "*.png", "*.pdf"]


# ------------------------------------------------------------------ config
def load(path):
    with open(path, "rb") as f:
        return tomllib.load(f)


def cfg_sites():
    return load(SITES)


def site_of(name):
    s = cfg_sites().get("sites", {})
    if name not in s:
        die("unknown site %r (have: %s)" % (name, ", ".join(sorted(s))))
    return s[name]


def cfg_projects():
    return load(PROJS).get("projects", {}) if os.path.exists(PROJS) else {}


def project_of(name):
    p = cfg_projects()
    if name not in p:
        die("unknown project %r (have: %s)" % (name, ", ".join(sorted(p))))
    return p[name]


# Policies as settings: projects.toml [defaults.policy], overridden by [projects.<P>.policy] (see config/).
POLICY_DEFAULTS = {"gpu_cap_h": 30.0, "gpu_cap_scarce_h": 10.0}


def policy(project):
    cfg = load(PROJS) if os.path.exists(PROJS) else {}
    p = dict(POLICY_DEFAULTS, **((cfg.get("defaults") or {}).get("policy") or {}))
    p.update(((cfg.get("projects") or {}).get(project) or {}).get("policy") or {})
    return p


def die(msg, code=2):
    sys.stderr.write("site: %s\n" % msg)
    raise SystemExit(code)


# ------------------------------------------------------------------ registry
SCHEMA = """
CREATE TABLE IF NOT EXISTS runs (
  id TEXT PRIMARY KEY, project TEXT, site TEXT, branch TEXT, commit_sha TEXT,
  job TEXT, sched_id TEXT, state TEXT, remote_path TEXT,
  submitted INTEGER, finished INTEGER, est_gpu_hours REAL, note TEXT);
CREATE TABLE IF NOT EXISTS artifacts (
  run_id TEXT, name TEXT, tier INTEGER, bytes INTEGER, sha TEXT,
  locations TEXT, PRIMARY KEY (run_id, name));
CREATE INDEX IF NOT EXISTS runs_proj ON runs(project);
"""


def db():
    os.makedirs(HOME, exist_ok=True)
    c = sqlite3.connect(DB, timeout=60)   # several site processes (waiters, submits) share the registry
    c.executescript(SCHEMA)
    return c


# ------------------------------------------------------------------ ssh
def ssh_cmd(sc, inner, tty=False, gpu=False):
    inner = _rd(inner)
    alias = sc.get("ssh_gpu" if gpu else "ssh")
    # The command's own output starts after OUT_MARK: anything the remote shell prints before it (CC-IN2P3's login
    # notice, profile noise) is dropped by strip_banner whatever its wording. Not for an interactive tty.
    env = sc.get("env") or {}
    prefix = "" if tty else "echo %s; " % OUT_MARK
    prefix += "".join("export %s=%s; " % (k, shlex.quote(str(v))) for k, v in env.items())
    # Per-site preamble (sites.toml `preamble`): lxplus sessions multiplexed over the
    # long-lived 2FA master keep a renewable Kerberos TGT but come up without an AFS
    # token, so nothing under /afs is writable until `kinit -R; aklog` runs.
    if sc.get("preamble"):
        prefix += sc["preamble"].rstrip("; ") + "; "
    # Some sites (Jean Zay) only have outbound HTTPS and a full PATH in a LOGIN
    # shell; ssh's default command shell is not one.
    if sc.get("login_shell"):
        inner = "bash -lc %s" % shlex.quote(prefix + inner)
        prefix = ""
    cmd = ["ssh"]
    if tty:
        cmd.append("-t")
    else:
        cmd += ["-o", "BatchMode=yes"]
    return cmd + [alias, prefix + inner]


# A multiplexing master whose TCP connection died keeps its socket: every later ssh reports "read from master failed:
# Broken pipe" / "ControlSocket ... already exists", falls back to a direct connection and, through a jump host, times
# out, for hours, while the login nodes answer. The master is ours, on this laptop: drop it.
DEAD_MASTER = ("read from master failed", "already exists, disabling multiplexing", "Control socket connect")


def reconnect(sc, gpu=False):
    """Close this site's ssh master and open a fresh one. Not for a 2FA site: only the user can open that one.
    Returns (ok, message)."""
    alias = sc.get("ssh_gpu" if gpu else "ssh")
    if sc.get("two_factor"):
        return False, "%s needs 2FA: only the user can reopen it (`cluster_up`)" % alias
    subprocess.run(["ssh", "-O", "exit", alias], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    cp = next((l.split(None, 1)[1] for l in local(["ssh", "-G", alias], check=False).splitlines()
               if l.startswith("controlpath ")), None)
    if cp and os.path.exists(cp) and not master_alive(alias):
        try:
            os.remove(cp)                   # the socket of a master that no longer answers, local to this laptop
        except FileNotFoundError:
            pass                            # gone meanwhile (its master exited, or another reconnect removed it)
    try:
        os.remove(os.path.join(BACKOFF_DIR, alias))
    except OSError:
        pass
    try:
        p = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=60", alias, "true"],
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180)
    except subprocess.TimeoutExpired:
        return False, "%s: a fresh connection timed out" % alias
    if p.returncode:
        return False, "%s: %s" % (alias, (strip_banner(p.stdout.decode("utf-8", "replace")).strip().splitlines()
                                          or ["?"])[-1][:120])
    return True, "%s: reconnected (master %s)" % (alias, "up" if master_alive(alias) else "not kept")


def _ssh_up(alias, remote, timeout):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", alias, remote], stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, timeout=timeout)


def _long_cmd(sc, cmd, timeout, gpu=False):
    """Jean Zay's ssh path stalls on any upload above ~1.4 KB (a long command line hangs where a short
    one answers): a longer command goes up gzip+base64 in 900-byte pieces to a file, then runs from it."""
    import base64, gzip, uuid
    alias = sc.get("ssh_gpu" if gpu else "ssh")
    blob = base64.b64encode(gzip.compress(cmd[-1].encode(), 9, mtime=0)).decode()
    f = "$HOME/.ccorch/cmd.%s" % uuid.uuid4().hex[:10]
    _ssh_up(alias, "mkdir -p $HOME/.ccorch; : > %s.b64" % f, 60)
    for k in range(0, len(blob), 900):
        _ssh_up(alias, "printf %%s %s >> %s.b64" % (blob[k:k + 900], f), 60)
    return _ssh_up(alias, "base64 -d %s.b64 | gunzip > %s.sh; rm -f %s.b64; bash %s.sh; r=$?; rm -f %s.sh; exit $r"
                   % (f, f, f, f, f), timeout)


def run_ssh(sc, inner, timeout=120, tty=False, gpu=False, check=False, _retry=True):
    _cmd = ssh_cmd(sc, inner, tty=tty, gpu=gpu)
    if sc.get("login_shell") and not tty and len(_cmd[-1]) > 1200:
        p = _long_cmd(sc, _cmd, timeout, gpu=gpu)
    else:
        p = subprocess.run(_cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    raw = p.stdout.decode("utf-8", "replace")
    out = strip_banner(raw, sc)
    if p.returncode == 255 and _retry and not tty and any(m in raw for m in DEAD_MASTER) and reconnect(sc, gpu=gpu)[0]:
        return run_ssh(sc, inner, timeout=timeout, gpu=gpu, check=check, _retry=False)
    if check and p.returncode:
        die("%s failed (exit %d):\n%s" % (sc.get("ssh"), p.returncode, out.strip()))
    return p.returncode, out


# CC-IN2P3 prints a login notice on every connection (its login shell, on stdout, before the command runs; through
# nested ssh hops or a login shell started by the command it can also come mid-output). Every parser here (job state,
# #SBATCH header, queue counts, the sha after a sync) reads the output from its first line, and the notice must never
# reach the caller. Two layers, so a change of its wording cannot let it through:
#   1. OUT_MARK: ssh_cmd starts every remote command with `echo OUT_MARK`; everything before the first marker line is
#      the remote shell's start-up output and is dropped, whatever it says.
#   2. the notice's frame, anywhere in the text (the hops and nested shells that carry no marker): a block from a line
#      naming the tools it bans (BANNER_FIRST) to its closing line (BANNER_LAST) at most BANNER_SPAN lines later.
OUT_MARK = "__CCORCH_OUT__"
BANNER_FIRST = re.compile(r"Claude/Gemini|Copilot/ChatGPT|generative AI|IA g[\u00e9e]n[\u00e9e]rative", re.I)
BANNER_LAST = re.compile(r"Login nodes are for interactive work|n[\u0153o]euds? de connexion", re.I)
BANNER_SPAN = 20


def strip_banner(out, sc=None):
    """`out` without the site's login notice, on both streams (callers merge stderr into stdout). `sc`: the site,
    marked `_notice` when anything was dropped (cmd_sync then sends a bundle, as git's protocol would break on it)."""
    dropped = False
    lines = out.splitlines(keepends=True)
    k = next((i for i, l in enumerate(lines) if l.rstrip("\r\n") == OUT_MARK), None)
    if k is not None:
        dropped = k > 0
        lines = lines[k + 1:]
    keep, i = [], 0
    while i < len(lines):
        m = BANNER_FIRST.search(lines[i])
        end = None
        if m:
            end = next((j for j in range(i, min(len(lines), i + BANNER_SPAN))
                        if BANNER_LAST.search(lines[j])), None)
        if end is None:
            keep.append(lines[i])
            i += 1
            continue
        dropped = True                       # the whole first line: the banned tools' names are not its start
        i = end + 1
    text = "".join(keep)
    if dropped and sc is not None:
        sc["_notice"] = True
    return text


def local(cmd, cwd=None, timeout=600, check=True):
    p = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, timeout=timeout, shell=isinstance(cmd, str))
    out = p.stdout.decode("utf-8", "replace")
    if check and p.returncode:
        die("command failed (exit %d): %s\n%s" % (p.returncode, cmd, out.strip()))
    return out


# ------------------------------------------------------------------ verbs
def cmd_list(a):
    sites = cfg_sites().get("sites", {})
    for name, sc in sorted(sites.items()):
        rc, out = run_ssh(sc, "echo ok", timeout=a.timeout)
        state = "up" if rc == 0 and "ok" in out else "UNREACHABLE"
        flags = []
        if sc.get("budget") == "scarce":
            flags.append("hours-limited")
        if sc.get("two_factor"):
            flags.append("2FA")
        if not sc.get("compute_net", True):
            flags.append("no-net-on-compute")
        print("  %-10s %-12s %-9s %s" % (name, state, sc.get("scheduler"),
                                         " ".join(flags)))


def cmd_reconnect(a):
    ok, msg = reconnect(site_of(a.site), gpu=a.gpu)
    print("  " + msg)
    sys.exit(0 if ok else 1)


def cmd_status(a):
    sc = site_of(a.site)
    if sc["scheduler"] == "slurm":
        q = ("squeue --me -o '%.10i %.9P %.2t %.10M %j' 2>&1 | head -20; "
             "echo '--- idle gpu nodes ---'; "
             "sinfo -p " + str(sc.get("partition", "")) + " -o '%.12P %.6a %.10A' 2>&1 | head -5")
    else:
        q = ("condor_q -nobatch 2>&1 | head -20; echo '--- my running/idle ---'; "
             "condor_q -totals 2>&1 | tail -2")
    rc, out = run_ssh(sc, q, timeout=a.timeout)
    print(out.rstrip())
    if sc.get("budget") == "scarce":
        print("\n  NOTE: %s hours are limited -- only use when needed or asked." % a.site)


# ------------------------------------------------- job scripts, unedited
# A job's RESOURCES are already in its #SBATCH header. Its SITE settings are in
# sites.toml. Keeping them apart is the whole trick: no new file format, no edit
# to a script that already works.
SBATCH_RE = re.compile(r"^#SBATCH\s+(--[\w-]+)(?:[=\s]+(\S+))?")
# these are the site's business, never the job's -- dropped when re-rendering
SITE_OWNED = {"--partition", "-p", "--account", "-A", "--qos", "--gres",
              "--mem", "--mem-per-cpu", "--constraint", "-C"}
# a job's flavour is the shortest whose limit covers its --time (never the site's default flavour)
FLAVOURS = [(20 * 60, "espresso"), (3600, "microcentury"), (2 * 3600, "longlunch"), (8 * 3600, "workday"),
            (24 * 3600, "tomorrow"), (3 * 86400, "testmatch"), (7 * 86400, "nextweek")]


def read_sbatch(text):
    """The #SBATCH header of an existing script -> {flag: value}."""
    out = {}
    lines = text.splitlines()
    # a login banner printed before the file (CC-IN2P3 prints one on every connection) is not
    # part of the script: start at the shebang or the first #SBATCH line
    start = next((i for i, l in enumerate(lines) if l.startswith("#!") or SBATCH_RE.match(l)), 0)
    for line in lines[start:]:
        if line.strip() and not line.startswith("#") and not line.startswith("#!"):
            break                       # header ends at the first real command
        m = SBATCH_RE.match(line)
        if m:
            out[m.group(1)] = m.group(2) or ""
    return out


def project_site(pr, site):
    """The project's own view of a site (sites/sites.yaml in its checkout), or {}."""
    try:
        import yaml
        p = os.path.join(os.path.expanduser(pr["local"]), "sites", "sites.yaml")
        with open(p) as f:
            return (yaml.safe_load(f) or {}).get(site) or {}
    except Exception:
        return {}


SCHED_KEYS = ("partition", "account", "qos", "constraint", "gpu_flag", "gres",
              "mem", "max_cpus_per_gpu", "partition_gpu_mem")


def gpu_partitions(part, sc, gmin_mb):
    """The comma list of SLURM partitions `part` cut to those whose GPUs hold gmin_mb (--hdr=--gpu-min-mem=80G):
    a memory floor, not a model pin. Needs the site's partition_gpu_mem map ({partition: 32G, ...}); a partition
    missing from the map, or no floor, keeps the list as it is. Dies when no partition meets the floor."""
    pm = sc.get("partition_gpu_mem") or {}
    if not gmin_mb or not part or not pm:
        return part
    keep = [p for p in str(part).split(",") if p not in pm or _mem_mb(pm[p], 0) >= gmin_mb]
    if not keep:
        die("no partition of %s has GPUs of %d MB (partition_gpu_mem %s)" % (part, gmin_mb, pm))
    return ",".join(keep)


def merge_site(sc, pr, site):
    """Scheduler flags for this project at this site.

    The project's sites/sites.yaml cluster block is authoritative: a key it
    leaves out is meant to be absent (Jean Zay A100 = -C a100 and NO partition),
    not inherited from the global default. Only a project with no cluster block
    for the site falls back to ~/.config/ccorch/sites.toml.
    """
    ps = project_site(pr, site)
    cl = dict(ps.get("cluster") or {})
    out = dict(sc)
    if not cl:
        return out
    for k in SCHED_KEYS:
        out.pop(k, None)
    for k in SCHED_KEYS:
        if k in cl:
            out[k] = cl[k]
    if "gres" in cl and "gpu_flag" not in cl:
        out["gres"] = cl["gres"]
    if ps.get("cpu"):
        out["_cpu"] = dict(ps["cpu"])
    return out


def site_flags(sc, hdr):
    """The site-specific half of the header, as sbatch COMMAND-LINE flags.
    Command-line options beat in-script #SBATCH, so the script is left alone."""
    f = []
    # How many GPUs is the JOB's business; how to ask for them is the SITE's.
    want = hdr.get("--gres", "") or hdr.get("--gpus", "")
    cpu = sc.get("_cpu") or {}
    if not want and cpu:
        # a CPU job: the project's cpu partition/account, no GPU qos, no --gpus
        for key, val in (("--partition", cpu.get("partition")),
                         ("--account", cpu.get("account") or sc.get("account")),
                         ("--qos", cpu.get("qos"))):
            if val:
                f.append("%s=%s" % (key, val))
        if cpu.get("mem_per_cpu") and not hdr.get("--mem"):
            f.append("--mem-per-cpu=%s" % cpu["mem_per_cpu"])
        elif sc.get("mem") is not None:
            f.append("--mem=%s" % (hdr.get("--mem") or sc["mem"]))
        return f
    for key, val in (("--partition", gpu_partitions(sc.get("partition"), sc, _mem_mb(hdr.get(GPU_MIN_MEM)))),
                     ("--account", sc.get("account")), ("--qos", sc.get("qos"))):
        if val:
            f.append("%s=%s" % (key, val))
    if sc.get("constraint"):
        f.append("-C %s" % sc["constraint"])
    if want:
        tail = want.split(":")[-1]
        n = tail if tail.isdigit() else "1"
        if sc.get("gpu_flag"):
            f.append(sc["gpu_flag"].format(n=n))
        elif sc.get("gres"):
            gres = sc["gres"]
            if gres.count(":") == 2:
                gres = ":".join(gres.split(":")[:2] + [n])
            f.append("--gres=%s" % gres)
    # CC-IN2P3 REJECTS a job with no --mem; Jean Zay rejects the flag itself.
    if sc.get("mem") is not None:
        f.append("--mem=%s" % (hdr.get("--mem") or sc["mem"]))

    # A per-GPU CPU ceiling is a site policy, not a job property. Clamping only
    # slows the input pipeline, never changes a result -- but say so out loud.
    cap = sc.get("max_cpus_per_gpu")
    if cap and want:
        asked = int(hdr.get("--cpus-per-task") or 1)
        allowed = int(cap) * int(n)
        if asked > allowed:
            sys.stderr.write("  note: %s allows %d cpus per gpu; clamping "
                             "--cpus-per-task %d -> %d\n" % (sc.get("ssh"), int(cap),
                                                             asked, allowed))
            f.append("--cpus-per-task=%d" % allowed)
    return f


def _secs(t):
    """Seconds of a SLURM --time: HH:MM:SS, HH:MM, D-HH[:MM[:SS]] (a day prefix used to fall to 1 h)."""
    t = str(t)
    days = 0
    try:
        if "-" in t:
            d, t = t.split("-", 1)
            days = int(d)
        p = [int(x) for x in t.split(":")]
    except ValueError:
        return 3600
    while len(p) < 3:
        p.append(0)
    return days * 86400 + p[0] * 3600 + p[1] * 60 + p[2]


def condor_sub(hdr, script, log_dir="logs", env=None, args=""):
    """Wrap an unedited job script in a Condor submit file.

    `script` must be a path the schedd can read: AFS at CERN, never EOS.
    `env` (dict) is passed through `environment = ...` -- Condor's --export."""
    name = hdr.get("--job-name") or os.path.basename(script).rsplit(".", 1)[0]
    mem_mb = _mem_mb(hdr.get("--mem") or "8G")  # MB, so "12000M" works too (the old "%sGB" turned it into 12000MGB)
    secs = _secs(hdr.get("--time", "01:00:00"))
    flav = next((n for lim, n in FLAVOURS if secs <= lim), "nextweek")
    gpus = 0
    if "--gres" in hdr:
        tail = hdr["--gres"].split(":")[-1]
        gpus = int(tail) if tail.isdigit() else 1
    cpus = int(hdr.get("--cpus-per-task") or 4)
    if gpus and mem_mb > CONDOR_MB_PER_CPU * cpus:
        sys.exit("lxplus gives 3000 MB per CPU: this job asks %d MB with %d CPUs, which lxplus raises to %d CPUs and no GPU "
                 "slot matches; ask for at most %d MB or %d CPUs explicitly"
                 % (mem_mb, cpus, -(-mem_mb // CONDOR_MB_PER_CPU), CONDOR_MB_PER_CPU * cpus, -(-mem_mb // CONDOR_MB_PER_CPU)))
    lines = ["executable = %s" % script] + (["arguments = %s" % args] if args else []) + [
             "output = %s/%s.$(ClusterId).$(ProcId).out" % (log_dir, name),
             "error  = %s/%s.$(ClusterId).$(ProcId).err" % (log_dir, name),
             "log    = %s/%s.$(ClusterId).log" % (log_dir, name),
             "request_cpus = %d" % cpus,
             # new syntax, each value in single quotes: a value may hold commas or spaces
             'environment = "%s"' % " ".join("%s='%s'" % (k, str(v).replace("'", "''").replace('"', '""'))
                                             for k, v in sorted((env or {}).items())),
             "request_memory = %d" % mem_mb,
             '+JobFlavour = "%s"' % flav,
             "+MaxRuntime = %d" % secs]  # the gate costs the job's own limit, not its flavour's full time
    if hdr.get("--tmp"):
        # --hdr=--tmp=8G: node-local scratch ($_CONDOR_SCRATCH_DIR), SLURM's --tmp; HTCondor's request_disk
        # lxplus slots advertise ~2-4 MB of Disk and do not enforce it, and 8G
        # cut the matching 8-cpu/24G slots from 9020 to 679: pass it only where a site enforces disk
        lines.append("request_disk = %s" % hdr["--tmp"])
    if gpus:
        # a MIG slice is not a whole GPU; training on one silently crawls (the regexp below once let
        # "A100 MIG" through and kept every H100/H200 out, while those were the free whole GPUs)
        req = CONDOR_GPU_REQ
        if hdr.get(GPU_MODEL):
            # --hdr=--gpu-model=V100: only that model (a regexp on GPUs_DeviceName), e.g. a per-model step-rate smoke
            req += ' && regexp("%s", TARGET.GPUs_DeviceName)' % hdr[GPU_MODEL].replace('"', '')
        lines += ["request_gpus = %d" % gpus,
                  'requirements = %s' % req]
        gmin = _mem_mb(hdr.get(GPU_MIN_MEM))
        if gmin:
            # --hdr=--gpu-min-mem=24G: a job whose peak does not fit a small GPU (T4 16 GB) keeps off it
            lines.append("gpus_minimum_memory = %d" % gmin)
    lines.append("queue 1")
    return name, "\n".join(lines) + "\n"


# a job's own minimum GPU memory (--hdr=--gpu-min-mem=24G): HTCondor's gpus_minimum_memory; never an sbatch flag:
# on SLURM it cuts the site's partition list to those whose GPUs hold it (partition_gpu_mem, gpu_partitions)
GPU_MIN_MEM = "--gpu-min-mem"
# a job pinned to one GPU model (--hdr=--gpu-model=<regexp on GPUs_DeviceName>): HTCondor only, never an sbatch flag
GPU_MODEL = "--gpu-model"

# whole GPUs only, on HTCondor: the same expression in the submit file and in site pick's slot count
# the lxplus schedd raises a job to 3000 MB per CPU: RequestCpus = max(request_cpus, ceil(MB / 3000)), RequestMemory =
# max(MB, 3000 x RequestCpus) (condor_q -better-analyze: 5 CPUs + 46G -> 16 / 48000; 4 + 32G -> 11 / 33000
# and 4 + <=12000 MB -> 4 / 12000). A V100 node offers 4 CPUs / 16000 MB, so a job above 12000 MB never
# lands on one (32G jobs sit idle while 4-CPU 12000 MB jobs keep starting on the V100s)
CONDOR_MB_PER_CPU = 3000
CONDOR_GPU_REQ = 'regexp("A100|V100|T4|H100|H200", TARGET.GPUs_DeviceName) && !regexp("MIG", TARGET.GPUs_DeviceName)'


def submit_cwd(sc, pr, project, remote_path):
    """Where the submit command must be RUN from -- not always where the code is.

    Condor at CERN refuses to submit from EOS, so the cwd is the project's AFS
    area. Its name need not follow the project name (a project may submit from
    another directory), hence the explicit `submit_name`.
    """
    if sc.get("scheduler") != "condor":
        return remote_path
    root = sc.get("submit_root")
    if not root:
        return remote_path
    name = pr.get("submit_name") or os.path.basename(pr.get("remote_name", project))
    return "%s/%s" % (root, name)


def deployed_sha(sc, pr, project, branch):
    """The commit the SITE is actually on -- never assume it matches local."""
    remote_path = "%s/%s" % (sc["root"], pr.get("remote_name", project))
    rc, out = run_ssh(sc, "cd %s && git rev-parse --short=10 HEAD" % shlex.quote(remote_path),
                      timeout=90)
    return (out.strip().splitlines()[-1] if out.strip() and not rc else "")


def not_code(pr):
    """Pathspecs of the project's paths that are not job code (projects.toml `not_code`, e.g. a plan/ directory
    that every plan write commits): left out when site compares a checkout or two commits for the code a job runs."""
    return [":(exclude)%s" % p for p in pr.get("not_code") or []]


def same_code(wc, pr, a, b):
    """Two commits carry the same job code: they differ only in the project's not_code paths."""
    return subprocess.run(["git", "-C", wc, "diff", "--quiet", a, b, "--", "."] + not_code(pr),
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def code_dirty(wc, pr):
    """Uncommitted changes to job code (a plan file mid-write is not job code)."""
    return local(["git", "-C", wc, "status", "--porcelain", "--", "."] + not_code(pr), check=False).strip()


def send_bundle(sc, wc, branch, stage, remote_path, sha, have, a):
    """Move `branch` to the site's `stage` ref as a git bundle on ssh's stdin: only the commits after `have` (the
    site's stage commit) when this checkout has it, else the whole branch."""
    full = local(["git", "-C", wc, "rev-parse", branch]).strip()
    if have and have == full:
        # the site has the commit (a fresh checkout's HEAD stands in for a missing stage ref): point the ref at it,
        # or the fast-forward that follows finds no stage ref to merge
        run_ssh(sc, "git -C %s update-ref %s %s" % (shlex.quote(remote_path), stage, full), timeout=a.timeout)
        return
    base = have if have and subprocess.run(["git", "-C", wc, "merge-base", "--is-ancestor", have, branch],
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0 else ""
    tmp = "/tmp/ccorch_%s_%s.bundle" % (os.environ.get("USER", "u"), sha)
    fetch = ("cat > %s && cd %s && git fetch -q --force %s %s:%s; rc=$?; rm -f %s; exit $rc"
             % (tmp, shlex.quote(remote_path), tmp, branch, stage, tmp))
    if base:   # a long gap goes in steps of ~1500 commits: one 90 MB ssh stream to Jean Zay stalled ("not responding")
        wp = local(["git", "-C", wc, "rev-list", "--first-parent", "--reverse", "%s..%s" % (base, branch)]).split()[1499:-1:1500]
        for w in wp:
            local(["git", "-C", wc, "update-ref", "refs/ccorch-chunk", w])   # a bundle needs a ref, not a bare sha
            send_bundle(sc, wc, "refs/ccorch-chunk", stage, remote_path, w[:10], base, a)
            base = w
        if wp:
            local(["git", "-C", wc, "update-ref", "-d", "refs/ccorch-chunk"], check=False)
    for rng in ([branch, "^" + base], [branch]) if base else ([branch],):
        b = subprocess.run(["git", "-C", wc, "bundle", "create", "-"] + rng, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, check=True).stdout
        q = subprocess.run(ssh_cmd(sc, fetch), input=b, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           timeout=a.timeout)
        if q.returncode == 0:
            return
    die("bundle fetch failed on %s:\n%s" % (a.site, strip_banner(q.stdout.decode("utf-8", "replace"), sc).strip()))


def ff_verdict(wc, branch, sha, got):
    """The site checkout sits at `got` after a fast-forward to `sha` that left it elsewhere. "ahead": got descends
    from sha and is the local branch head; "retry": got descends from sha and is in the local branch's history but the
    head moved on (sync again); "diverged": anything else (got unknown locally, not a descendant of sha, or off the
    local branch)."""
    def ok(*args):
        return subprocess.run(["git", "-C", wc] + list(args), stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0
    if not got or not ok("cat-file", "-e", got + "^{commit}"):
        return "diverged"
    if not (ok("merge-base", "--is-ancestor", sha, got) and ok("merge-base", "--is-ancestor", got, branch)):
        return "diverged"
    head = subprocess.run(["git", "-C", wc, "rev-parse", branch], stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL).stdout.decode().strip()
    full = subprocess.run(["git", "-C", wc, "rev-parse", got], stdout=subprocess.PIPE,
                          stderr=subprocess.DEVNULL).stdout.decode().strip()
    return "ahead" if head == full else "retry"


def reset_guard(a, sc, wc, pr, branch, remote_path):
    """--reset-after-rewrite: die unless the site's tracked files are clean and its head is the old counterpart of a
    commit in the (rewritten) local branch, equal to it outside vendor/ (a rewrite that only dropped vendor/)."""
    q = shlex.quote(remote_path)
    rc, out = run_ssh(sc, "cd %s && git status --porcelain -uno | head -5; echo HEAD=$(git rev-parse HEAD)" % q,
                      timeout=a.timeout)
    lines = [l.strip() for l in out.splitlines()]
    m = next((re.fullmatch(r"HEAD=([0-9a-f]{40})", l) for l in lines if l.startswith("HEAD=")), None)
    if rc or not m:
        die("reset refused: cannot read the %s checkout state:\n%s" % (a.site, out.rstrip()))
    old = m.group(1)
    dirty = [l for l in lines if re.match(r"^[ MADRCU?!]{2} \S", l)]
    if dirty:
        die("reset refused: %s has uncommitted tracked changes:\n  %s" % (a.site, "\n  ".join(dirty)))
    if subprocess.run(["git", "-C", wc, "cat-file", "-e", old + "^{commit}"], stderr=subprocess.DEVNULL).returncode:
        die("reset refused: the site head %s is not in the local repo (cannot compare)" % old[:10])
    at, subj = local(["git", "-C", wc, "log", "-1", "--format=%at%x00%s", old]).strip().split("\0", 1)
    for l in local(["git", "-C", wc, "log", branch, "--format=%H%x00%at%x00%s"]).splitlines():
        h, t, s_ = l.split("\0", 2)
        if t == at and s_ == subj and subprocess.run(
                ["git", "-C", wc, "diff", "--quiet", old, h, "--", ".", ":(exclude)vendor"]).returncode == 0:
            print("  rewrite  site head %s == %s outside vendor/; resetting" % (old[:10], h[:10]))
            return
    die("reset refused: no commit of local %s equals the site head %s ('%s') outside vendor/" % (branch, old[:10], subj))


def cmd_sync(a):
    """Push local commits, then fast-forward the site checkout. No mount."""
    pr = project_of(a.project)
    sc = site_of(a.site)
    wc = os.path.expanduser(pr["local"])
    branch = a.branch or pr.get("branch", "trunk")
    remote_path = "%s/%s" % (sc["root"], pr.get("remote_name", a.project))

    dirty = code_dirty(wc, pr)
    if dirty and not a.allow_dirty:
        die("working copy has uncommitted changes; commit first or pass --allow-dirty\n"
            + "\n".join("  " + l for l in dirty.splitlines()[:10]))
    print("  push  %s -> origin/%s" % (branch, branch))
    local(["git", "-C", wc, "push", "-q", "origin", "%s:%s" % (branch, branch)])
    sha = local(["git", "-C", wc, "rev-parse", "--short=10", branch]).strip()

    # The site checkout is updated straight from the laptop over the ssh master
    # (push to refs/ccorch/<branch>, then a fast-forward there). Sites never have
    # to reach GitHub themselves: lxplus has no key registered there and Jean Zay
    # nodes have no internet, and a failed fetch used to surface as the misleading
    # "a branch named 'trunk' already exists".
    site_url = "ssh://%s%s" % (sc["ssh"], remote_path)
    stage = "refs/ccorch/%s" % branch
    # git's ssh transport reads the remote's stdout as protocol, so a site whose login shell prints a notice
    # (CC-IN2P3) breaks a push ("bad line length character") and git's error carries the notice's first bytes. Such
    # a site gets a bundle over stdin instead, where the notice lands in the command's own output and is stripped.
    # Whether the site prints one is seen on this first call (strip_banner marks it), which also gives the stage
    # ref the site already has, so the bundle carries only the new commits.
    rc, out = run_ssh(sc, "git -C %s rev-parse -q --verify %s 2>/dev/null; echo HEAD=$(git -C %s rev-parse HEAD 2>/dev/null); true"
                      % (shlex.quote(remote_path), shlex.quote(stage + "^{commit}"), shlex.quote(remote_path)),
                      timeout=a.timeout)
    have = next((l.strip() for l in out.splitlines() if re.fullmatch(r"[0-9a-f]{40}", l.strip())), "")
    # no stage ref yet (first sync after a fresh checkout or a long gap): the site's HEAD is the base, so the bundle
    # carries only the commits after it (send_bundle falls back to the whole branch when HEAD is not an ancestor)
    head = next((l[5:] for l in out.splitlines() if re.fullmatch(r"HEAD=[0-9a-f]{40}", l.strip())), "")
    # a stage ref left behind the site's HEAD (a stale earlier sync) is a worse base than HEAD: the git push to it
    # resends everything since, and a push of thousands of commits can time out
    if head and (not have or (have != head and subprocess.run(
            ["git", "-C", wc, "merge-base", "--is-ancestor", have, head], stderr=subprocess.DEVNULL).returncode == 0)):
        have = head
        sc = dict(sc, _notice=sc.get("_notice") or True)   # a push of the whole missing history hangs: bundle
    if sc.get("_notice"):
        print("  bundle %s -> %s:%s (the site's login shell prints a notice; git's ssh protocol cannot pass it)"
              % (branch, a.site, stage))
        send_bundle(sc, wc, branch, stage, remote_path, sha, have, a)
    else:
        print("  push  %s -> %s:%s" % (branch, a.site, stage))
        try:
            p = subprocess.run(["git", "-C", wc, "push", "-q", "--force", site_url, "%s:%s" % (branch, stage)],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               timeout=max(a.timeout, 1800) if getattr(a, "reset_after_rewrite", False) else a.timeout)
        except subprocess.TimeoutExpired:   # a rewritten history is a whole-branch pack: slow, not a crash
            die("push to %s timed out; rerun with --timeout N (a whole-history push needs minutes)" % a.site)
        if p.returncode:
            why = (strip_banner(p.stdout.decode("utf-8", "replace")).strip().splitlines() or ["?"])[-1]
            if "bad line length" in why or "protocol" in why:
                why = "the site's shell printed into git's ssh protocol"     # git quotes the stray bytes: never echo them
            print("  push failed (%s); sending a bundle instead" % why[:100])
            send_bundle(sc, wc, branch, stage, remote_path, sha, have, a)

    # The overlay is regenerated every sync, so discarding it before the merge is
    # safe and is what lets the site track the trunk with --ff-only. Untracked
    # files (results, logs, venvs) are never touched.
    overlay = pr.get("overlay")
    steps = ["cd %s" % shlex.quote(remote_path)]
    if overlay:
        steps.append("git checkout -- .")
    if getattr(a, "reset_after_rewrite", False):
        reset_guard(a, sc, wc, pr, branch, remote_path)
        steps += ["git checkout -q %s || git checkout -q -b %s %s"
                  % (shlex.quote(branch), shlex.quote(branch), shlex.quote(stage)),
                  "git reset -q --hard %s" % shlex.quote(stage)]
    else:
        steps += ["git checkout -q %s || git checkout -q -b %s %s"
                  % (shlex.quote(branch), shlex.quote(branch), shlex.quote(stage)),
                  "git merge --ff-only -q %s" % shlex.quote(stage)]
    inner = " && ".join(steps) + " && git rev-parse --short=10 HEAD"

    if a.check:
        print("  would run on %s:\n    %s" % (a.site, inner.replace(" && ", "\n    ")))
        if overlay:
            print("    " + overlay.format(site=a.site))
        return

    rc, out = run_ssh(sc, inner, timeout=a.timeout)
    # the sha is the last line that LOOKS like one -- a first checkout prints
    # "branch trunk set up to track ..." after it on some hosts
    shas = [l.strip() for l in out.splitlines() if re.fullmatch(r"[0-9a-f]{7,40}", l.strip())]
    got = shas[-1] if shas else ""
    if rc or got != sha:
        v = ff_verdict(wc, branch, sha, got) if not rc else "diverged"
        if v == "retry" and not getattr(a, "_ff_retried", False):
            # the site is ahead of the pushed commit on the local trunk's own history (another sync since this
            # one read the branch): sync again with the newer local head
            print("  site  at %s, ahead of %s on the local %s; syncing the newer local head" % (got, sha, branch))
            a._ff_retried = True
            return cmd_sync(a)
        if v in ("ahead", "retry"):
            print("  site  %s:%s at %s, already ahead of %s on the local %s; kept" % (a.site, remote_path, got, sha, branch))
        else:
            die("site did not fast-forward to %s:\n%s" % (sha, out.rstrip()))
    else:
        print("  site  %s:%s now at %s" % (a.site, remote_path, got))

    if overlay:
        cmd = overlay.format(site=a.site)
        rc, out = run_ssh(sc, "cd %s && %s" % (shlex.quote(remote_path), cmd),
                          timeout=a.timeout)
        if rc:
            die("overlay failed on %s:\n%s" % (a.site, out.rstrip()))
        print("  overlay  %s" % (out.strip().splitlines()[-1] if out.strip() else cmd))


CODE_PATH = re.compile(r"^([^/]+\.(py|sh)|(config|recipes|sweep|sites|models|scripts|tools)/.*\.(py|sh|yaml))$")


def check_not_stale(a, pr, sc, sha=None):
    """Work (--item) must run the local trunk's code: refuse when the site checkout lags it by a commit touching code
    (a sync that refused would otherwise leave a run on a stale commit). Docs, data, json, plan/ and talks/
    commits do not count. Upkeep (--item '*') only gets a warning naming both commits."""
    if getattr(a, "allow_stale", False):
        return
    wc = os.path.expanduser(pr["local"])
    branch = getattr(a, "branch", None) or pr.get("branch", "trunk")
    if sha is None:
        sha = deployed_sha(sc, pr, a.project, branch)
    lsha = local(["git", "-C", wc, "rev-parse", "--short=10", branch], check=False).strip()
    if not sha or not lsha or sha == lsha:
        return
    # commits the site lacks: sha..lsha (a site ahead of or off the branch has none and passes)
    lag = local(["git", "-C", wc, "log", "--name-only", "--format=@%h", "%s..%s" % (sha, lsha)], check=False)
    hit = any(CODE_PATH.match(l.strip()) for l in lag.splitlines() if l.strip() and not l.startswith("@"))
    if not hit:
        return
    items = a.item if isinstance(getattr(a, "item", None), list) else [getattr(a, "item", None)]
    if "*" in items:
        print("  warning: the %s checkout of %s is at %s but local %s is at %s (code differs): upkeep runs anyway"
              % (a.site, a.project, sha, branch, lsha), file=sys.stderr)
        return
    die("the %s checkout of %s is at %s but local %s is at %s: run `site sync %s %s` first (the sync may have "
        "refused over uncommitted files), or pass --allow-stale to run at the site's commit"
        % (a.site, a.project, sha, branch, lsha, a.site, a.project))


DISK_MARGIN_GB = 5   # a batch is refused only when it does not fit: need > free - this margin
DISK_FLOOR_GB = 60   # scripts/disk_watch.py --min-free-gb: below this the supervisor raises a DISK alert


def disk_check(a, sc, path):
    """Before a job goes, the free space where its checkout lives against the batch's need (--disk-gb, the whole
    batch's disk, not one job's): refused only when it does not fit (need > free - DISK_MARGIN_GB);
    under DISK_FLOOR_GB left it only warns (the floor is the alarm level, not a submission ban)."""
    # shortcut: the checkout's filesystem only (on CC and Jean Zay the runs and caches share it; on lxplus EOS df may
    # not show the quota); measure SCRATCH too when a site splits them
    rc, out = run_ssh(sc, "df -B1 --output=avail %s | tail -1" % shlex.quote(path), timeout=60)
    w = out.split()
    free = int(w[-1]) / 1e9 if not rc and w and w[-1].isdigit() else None
    need = a.disk_gb
    if free is None:
        print("  disk: free space on %s not read (%s); --disk-gb not checked" % (a.site, " ".join(w)[-120:]))
        return
    print("  disk: %.0f GB free on %s, batch needs %s" % (free, a.site, "%.0f GB" % need if need is not None
                                                             else "? (not given: pass --disk-gb)"))
    if need is not None and need > free - DISK_MARGIN_GB:
        die("%s has %.0f GB free; this batch needs %.0f GB and does not fit (%d GB margin): free space first "
            "(or place the batch elsewhere: site pick)" % (a.site, free, need, DISK_MARGIN_GB))
    if need is not None and free - need < DISK_FLOOR_GB:
        print("  WARNING: %s will be left with %.0f GB, under the %d GB alarm floor" % (a.site, free - need, DISK_FLOOR_GB),
              file=sys.stderr)
    if need is None and free < DISK_FLOOR_GB:
        print("  WARNING: %s is under the %d GB floor (%.0f GB free)" % (a.site, DISK_FLOOR_GB, free), file=sys.stderr)


def cmd_submit(a):
    if a.site == "auto":
        rows, best = rank_sites(a.project, a.allow_scarce, None, timeout=a.timeout)
        for r in rows:
            print("  %-9s %-6s %s" % (r["site"], r["state"], r["reason"]))
        if not best:
            die("no site is up and deployed for %s" % a.project)
        print("  pick: %s" % best)
        a.site = best
    pr, sc = project_of(a.project), site_of(a.site)
    if ledger_on(a.project) and (not a.item or a.item == "*"):
        die("a submission belongs to one work item: --item <id> (`site items %s`; new work: `site decide` with the "
            "user's words, then `site item add`)" % a.project)
    resolve_items(a.project, [a.item], "submission")
    job_args = list(getattr(a, "args", None) or [])
    rid = "%s-%s-%s" % (a.project, a.site, uuid.uuid4().hex[:8])
    try:
        with open(os.path.join(os.path.expanduser(pr["local"]), a.job)) as f:
            _lhdr = read_sbatch(f.read())
    except OSError:
        _lhdr = {"--gres": "gpu:1"}          # unknown script: assume it costs GPU hours
    gpu_job = bool(_lhdr.get("--gres") or _lhdr.get("--gpus"))
    if sc.get("budget") == "scarce" and not a.yes and gpu_job:
        est = a.est_gpu_hours
        if est is None:
            die("%s hours are limited: pass --est-gpu-hours (and --yes if >10, "
                "after confirming with the user unless a decision in force covers it)" % a.site)
        if est > 10:
            die("estimate is %.1f GPU-hours on a limited-hours site; confirm with "
                "the user unless a decision in force covers it (its cost, or the work by name), "
                "then re-run with --yes" % est)
    branch = a.branch or pr.get("branch", "trunk")

    # Deploy before submitting, so the job runs the code you think it runs.
    if not a.no_sync:
        sync_args = argparse.Namespace(site=a.site, project=a.project, branch=a.branch,
                                       allow_dirty=a.allow_dirty, check=False,
                                       timeout=a.timeout)
        cmd_sync(sync_args)

    sha = deployed_sha(sc, pr, a.project, branch)
    if not sha:
        die("cannot read the deployed commit on %s -- refusing to submit a run "
            "whose provenance I cannot record" % a.site)
    if not a.check:
        check_not_stale(a, pr, sc, sha)
    if a.no_sync:
        try:
            lsha = local(["git", "-C", os.path.expanduser(pr["local"]),
                          "rev-parse", "--short=10", branch], check=False).strip()
            if lsha and lsha != sha and not same_code(os.path.expanduser(pr["local"]), pr, sha, lsha):
                print("  note: --no-sync, site is at %s, local %s is NOT deployed"
                      % (sha, lsha))
        except Exception:
            pass

    remote_path = "%s/%s" % (sc["root"], pr.get("remote_name", a.project))
    cwd = submit_cwd(sc, pr, a.project, remote_path)

    rc, hdr_text = run_ssh(sc, "sed -n '1,60p' %s"
                           % shlex.quote("%s/%s" % (remote_path, a.job)), timeout=60)
    if rc:
        die("cannot read %s on %s:\n%s" % (a.job, a.site, hdr_text.rstrip()))
    hdr = read_sbatch(hdr_text)
    disk_check(a, sc, remote_path)
    # per-submission overrides of the script's #SBATCH header (memory, time, cpus, name):
    # one committed job script can serve many differently sized jobs (sweep/drive.py)
    for kv in (a.hdr or []):
        k, _, v = kv.partition("=")
        if k.startswith("--"):
            hdr[k] = v

    if sc["scheduler"] == "condor":
        # Generate the .sub next to the AFS submission area; the script itself
        # is untouched and still lives with the code on EOS.
        # CERN schedds cannot read EOS: the executable is copied into the AFS
        # submit area (overwritten each time) and the .sub points at the copy.
        # The copy still runs the EOS checkout: CCORCH_PROJECT_DIR says where.
        exe = "%s/jobs/%s" % (cwd, os.path.basename(a.job))
        xenv = {"CCORCH_SITE": a.site, "CCORCH_PROJECT_DIR": remote_path, "CCORCH_RUN_ID": rid}
        xenv.update(dict(kv.split("=", 1) for kv in (a.env or []) if "=" in kv))
        name, sub = condor_sub(hdr, exe, env=xenv, args=" ".join(job_args))
        subfile = "%s/%s.sub" % (cwd, name)
        put = ("mkdir -p %s/logs %s/jobs && cp -f %s %s && chmod 755 %s && "
               "cat > %s <<'__SUB__'\n%s__SUB__"
               % (shlex.quote(cwd), shlex.quote(cwd),
                  shlex.quote("%s/%s" % (remote_path, a.job)), shlex.quote(exe),
                  shlex.quote(exe), shlex.quote(subfile), sub))
        rc, out = run_ssh(sc, put, timeout=90)
        if rc:
            die("could not write the submit file on %s:\n%s" % (a.site, out.rstrip()))
        inner = "cd %s && %s %s" % (shlex.quote(cwd), sc["submit"], shlex.quote(subfile))
    else:
        flags = " ".join(site_flags(merge_site(sc, pr, a.site), hdr))
        # --hdr overrides (time, cpus, name...) beat the script's #SBATCH lines only as
        # command-line flags; reading them into `hdr` alone left the script's --time in force
        for kv in (a.hdr or []):
            k, _, v = kv.partition("=")
            if k.startswith("--") and k not in (GPU_MIN_MEM, GPU_MODEL):
                flags += " " + shlex.quote("%s=%s" % (k, v))
        # A batch script cannot locate itself: SLURM runs a COPY out of spool.
        # Hand it the project dir and the site name explicitly.
        exports = "--export=ALL,CCORCH_SITE=%s,CCORCH_PROJECT_DIR=%s,CCORCH_RUN_ID=%s" % (
            a.site, remote_path, rid)
        # --env values go in sbatch's own environment, which --export=ALL hands to the job whole: inside --export a
        # comma separates variables, so PARENTS=a,b,c would arrive as PARENTS=a
        envp = "".join(" " + shlex.quote(kv) for kv in (a.env or []) if "=" in kv)
        inner = "cd %s && %s%s %s %s %s%s" % (shlex.quote(cwd), ("env" + envp + " ") if envp else "", sc["submit"],
                                              exports,
                                            flags, shlex.quote(a.job),
                                            "".join(" " + shlex.quote(x) for x in job_args))
    shown = inner
    if ledger_on(a.project):
        ensure_gate(sc)
        # through the site's submission gate, as every other submission there: the item check and the GPU budget
        inner = ("export CCORCH_SITE=%s CCORCH_WORK=%s; %s; %s%s%s" % (
            a.site, shlex.quote(work_env(a.project, [a.item], a.site)), SCHED_WRAP, GATE_REQUIRED, GATE_TRAP, inner))
    if not a.allow_unfit:
        jm = _mem_mb(hdr.get("--mem")) or _mem_mb((merge_site(sc, pr, a.site) or {}).get("mem")) or \
            make_request(pr, a.site)["mem_mb"]
        why = unfit_refusal(a.project, jm)
        if why:
            die("refused: this job asks %dG and %s. Lower the memory, or --allow-unfit if it must wait for such a "
                "node" % (round(jm / 1024.0), why))
    if a.check:
        print("  would run on %s:\n    %s%s" % (a.site, shown, "\n  (through the site's submission gate: item check "
                                               "and GPU budget)" if shown != inner else ""))
        if sc["scheduler"] == "condor":
            print("  submit file:\n    " + sub.replace("\n", "\n    ").rstrip())
        return
    rc, out = run_ssh(sc, inner, timeout=a.timeout)
    out = record_gate(a.project, a.site, out) if ledger_on(a.project) else out
    if rc:
        die("submit failed:\n%s" % out.rstrip())
    sched_id = out.strip().splitlines()[-1].strip()
    if sc["scheduler"] != "condor":
        # sbatch --parsable prints "<id>[;cluster]"; a site warning (e.g. CC's SPS incident notice on stderr) may follow
        ids = [l.strip() for l in out.splitlines() if re.match(r"^\d+(;\S+)?$", l.strip())]
        sched_id = ids[-1] if ids else sched_id
    if sc["scheduler"] == "condor":
        m = re.search(r"cluster\s+(\d+)", out)
        sched_id = m.group(1) if m else sched_id
    c = ldb()
    exp = parse_expect(a.expect, os.environ.get("CCORCH_EXPECT"))
    # a run submitted by a launch carries the launch's id (CCORCH_LAUNCH, "<project>/<id>", set by _fire), so the
    # launch's report names its own runs, not every run of the item since it started
    c.execute("INSERT INTO runs (id,project,site,branch,commit_sha,job,sched_id,state,remote_path,submitted,"
              "finished,est_gpu_hours,note,item,expect,launch) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
              (rid, a.project, a.site, branch, sha,
               a.job, sched_id, "SUBMITTED", remote_path, int(time.time()), None,
               a.est_gpu_hours, a.note, a.item, json.dumps(exp) if exp else None,
               os.environ.get("CCORCH_LAUNCH") or None))
    c.commit()
    print("  run %s  (%s job %s on %s, code @ %s)"
          % (rid, sc["scheduler"], sched_id, a.site, sha))


def _sched_state(sc, sched_id):
    if sc["scheduler"] == "slurm":
        rc, out = run_ssh(sc, "sacct -j %s -n -o State%%20 2>/dev/null | head -1"
                          % shlex.quote(sched_id), timeout=60)
        return (out.strip().split() or ["UNKNOWN"])[0]
    rc, out = run_ssh(sc, "condor_q %s -af JobStatus 2>/dev/null | head -1"
                      % shlex.quote(sched_id), timeout=60)
    m = {"1": "IDLE", "2": "RUNNING", "3": "REMOVED", "4": "COMPLETED", "5": "HELD"}
    if not out.strip():
        # gone from the queue: the history says how it left (a removed job is not COMPLETED)
        rc, out = run_ssh(sc, "condor_history %s -limit 1 -af JobStatus 2>/dev/null | head -1"
                          % shlex.quote(sched_id), timeout=120)
        return m.get(out.strip(), "COMPLETED")
    return m.get(out.strip(), "UNKNOWN")


def cmd_poll(a):
    c = db()
    rows = (c.execute("SELECT id,site,sched_id,state FROM runs WHERE id IN (%s)"
                      % ",".join("?" * len(a.runs)), a.runs).fetchall() if a.runs else
            c.execute("SELECT id,site,sched_id,state FROM runs WHERE COALESCE(state,'') NOT IN (%s)"
                      % ",".join("?" * len(TERMINAL)), TERMINAL).fetchall())
    for rid, site, sched_id, old in rows:
        st = _sched_state(site_of(site), sched_id)
        fin = int(time.time()) if st in TERMINAL else None
        c.execute("UPDATE runs SET state=?, finished=COALESCE(finished,?) WHERE id=?",
                  (st, fin, rid))
        # commit per run: the next run's scheduler query is an ssh that can hang for minutes,
        # and an open write transaction across it locked the registry for the supervisor ("database is locked")
        c.commit()
        print("  %-28s %-10s -> %s" % (rid, old, st))


def cmd_runs(a):
    c, q, p = db(), "SELECT id,project,site,state,job,submitted FROM runs", []
    w = []
    # --id: one exact run, whatever its age (a check that greps the 25-row listing misses older runs)
    for f, v in (("id", a.id), ("project", a.project), ("site", a.site), ("state", a.state)):
        if v:
            w.append("%s=?" % f); p.append(v)
    if w:
        q += " WHERE " + " AND ".join(w)
    n = 0
    for rid, proj, site, state, job, sub in c.execute(q + " ORDER BY submitted DESC LIMIT ?",
                                                      p + [a.limit]):
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(sub or 0))
        print("  %-28s %-14s %-9s %-10s %s  %s" % (rid, proj, site, state, when, job))
        n += 1
    if a.id and not n:
        raise SystemExit(1)


def cmd_logs(a):
    c = db()
    r = c.execute("SELECT site,sched_id,remote_path FROM runs WHERE id=?", (a.run,)).fetchone()
    if not r:
        die("no such run %r" % a.run)
    site, sched_id, path = r
    sc = site_of(site)
    pat = "*%s*" % sched_id
    if sc["scheduler"] == "condor":
        proj = c.execute("SELECT project FROM runs WHERE id=?", (a.run,)).fetchone()[0]
        cwd = submit_cwd(sc, project_of(proj), proj, path)
        # the pattern must stay a glob (sched_id is digits, nothing to quote)
        inner = ("cd %s/logs && ls -t %s 2>/dev/null | head -3 | xargs -r tail -n %d"
                 % (shlex.quote(cwd), pat, a.n))
        # condor returns stdout/stderr only at job end: for a running job read them with condor_tail; bounded, since
        # on a job that has left the queue it hung past site's 120 s ssh timeout and lost the log above
        cl = sched_id.split(".")[0]
        for lab, fl in (("stderr", "-stderr "), ("stdout", "")):
            inner += (" ; echo '--- condor_tail %s ---' ; cd %s && timeout 20 condor_tail %s%s.0 2>&1 | tail -n %d"
                      % (lab, shlex.quote(cwd), fl, cl, a.n))
    else:
        # find|xargs ls: an empty find must not make ls list the cwd (it tailed another run's log)
        inner = ("cd %s && find . -maxdepth 3 -name %s -newermt '-30 days' "
                 "-not -path './.venv/*' 2>/dev/null | xargs -r ls -t 2>/dev/null | head -3 | xargs -r tail -n %d"
                 % (shlex.quote(path), shlex.quote(pat), a.n))
    rc, out = run_ssh(sc, inner, timeout=a.timeout)
    print(out.rstrip() or "  no output: the job never wrote a log (job %s)" % sched_id)
    if out.strip():
        note_read(a.run, "logs")


READS = os.path.join(HOME, "reads.log")


def note_read(run, how):
    """What the agent has read, for cmd_ack: an event about a finished run closes only once its log or results were
    read after it ended (closing events in a loop with one blanket note leaves results unread)"""
    try:
        with open(READS, "a") as f:
            f.write("%d\t%s\t%s\n" % (int(time.time()), run, how))
    except OSError:
        pass


def read_since(run, ts):
    try:
        return any(l.split("\t")[1] == run and int(l.split("\t")[0]) >= ts for l in open(READS) if l.count("\t") >= 2)
    except OSError:
        return False


def cmd_fetch(a):
    """Pull tier-0 home so results survive every cluster being down."""
    c = db()
    r = c.execute("SELECT project,site,remote_path,sched_id FROM runs WHERE id=?",
                  (a.run,)).fetchone()
    if not r:
        die("no such run %r" % a.run)
    proj, site, path, sched_id = r
    sc = site_of(site)
    dest = os.path.join(STORE, proj, a.run)
    os.makedirs(dest, exist_ok=True)
    # Only what THIS run produced: tier-0 files modified after it was submitted,
    # under the checkout (and the AFS logs dir on Condor), never .venv/.git/data.
    # Anything else in the tree is another run's, or the dataset.
    sub, fin = c.execute("SELECT submitted, finished FROM runs WHERE id=?", (a.run,)).fetchone()
    since = int(sub or 0) - 120
    until = (int(fin) + 60) if fin else None
    names = " -o ".join("-name %s" % shlex.quote(p) for p in TIER0)
    roots = [path]
    if sc.get("scheduler") == "condor":
        roots.append(submit_cwd(sc, project_of(proj), proj, path) + "/logs")
    if a.dir:
        roots = ["%s/%s" % (path, a.dir.strip("/"))]
    window = "-newermt @%d" % since + (" ! -newermt @%d" % until if until else "")
    finds = " ; ".join(
        "cd %s 2>/dev/null && find . -xdev \\( -path ./.venv -o -path ./.git -o -path ./data "
        "-o -path ./datasets -o -path ./.worktrees -o -path ./worktrees \\) -prune -o -type f "
        "\\( %s \\) %s -size -50M -print | sed 's#^./#%s/#'"
        % (shlex.quote(r), names, window, r) for r in roots)
    rc, listing = run_ssh(sc, finds, timeout=min(a.timeout, 300))
    files = [l.strip() for l in listing.splitlines() if l.strip().startswith("/")]
    if len(files) > 2000:
        die("%d tier-0 candidates for %s -- that is not one run's output; refusing. "
            "Narrow TIER0 or the run's output dir." % (len(files), a.run))
    if not files:
        print("  no tier-0 files in the run's window under %s" % path)
    else:
        # Selection is by time window, so two runs sharing a checkout at the same
        # moment could cross: show which run directories the files came from.
        tops = sorted({os.path.relpath(os.path.dirname(f), path).split("/")[0]
                       if f.startswith(path + "/") else os.path.dirname(f) for f in files})
        print("  %d files from: %s" % (len(files), ", ".join(tops)[:200]))
        if len(tops) > 3 and not a.dir:
            print("  (several directories -- if another run was active in this checkout, "
                  "re-run with --dir <run dir>)")
        lst = os.path.join(dest, ".files")
        with open(lst, "w") as f:
            f.write("\n".join(files) + "\n")
        # A tar through the same ssh path as every other verb, behind a marker: rsync's protocol
        # broke on CC's login notice ("protocol version mismatch -- is your shell clean?") and its
        # error was discarded, so every CC fetch saved only this file list.
        rel = "\n".join(f.lstrip("/") for f in files)
        script = ("L=$(mktemp); cat > \"$L\" <<'__CCORCH_LIST__'\n%s\n__CCORCH_LIST__\n"
                  "echo __CCORCH_TAR__; tar czf - -C / -T \"$L\" 2>/dev/null | base64 -w0; echo; "
                  "echo __CCORCH_END__; rm -f \"$L\"\n" % rel)
        rc, out = run_ssh_input(sc, script, timeout=a.timeout)
        lines = out.splitlines()
        if "__CCORCH_TAR__" not in lines or "__CCORCH_END__" not in lines:
            die("fetch of %s failed (exit %d):\n%s" % (a.run, rc, out.strip()[-2000:]))
        blob = lines[lines.index("__CCORCH_TAR__") + 1]
        import base64, io, tarfile
        with tarfile.open(fileobj=io.BytesIO(base64.b64decode(blob)), mode="r:gz") as t:
            t.extractall(dest, filter="data")
    n = sum(len(f) for _, _, f in os.walk(dest))
    c.execute("INSERT OR REPLACE INTO artifacts VALUES (?,?,?,?,?,?)",
              (a.run, "tier0", 0, None, None, json.dumps([dest, "%s:%s" % (site, path)])))
    c.commit()
    print("  %d tier-0 files -> %s" % (n, dest))
    print("  heavy artifacts stay at %s:%s (recorded, not copied)" % (site, path))
    if n:
        note_read(a.run, "fetch")


def cmd_where(a):
    c = db()
    r = c.execute("SELECT id,project,site,remote_path,state FROM runs WHERE id=? OR id LIKE ?",
                  (a.what, "%" + a.what + "%")).fetchone()
    if not r:
        die("nothing matches %r" % a.what)
    rid, proj, site, path, state = r
    print("  run      %s (%s, %s)" % (rid, proj, state))
    print("  remote   %s:%s" % (site, path))
    for name, loc in c.execute("SELECT name,locations FROM artifacts WHERE run_id=?", (rid,)):
        for l in json.loads(loc):
            print("  %-8s %s" % (name, l))


def ssh_target(alias):
    """user@host[:port] and the ProxyJump of a laptop ssh alias, from `ssh -G`."""
    out = local(["ssh", "-G", alias], check=False)
    kv = dict(l.split(None, 1) for l in out.splitlines() if " " in l and not l.startswith("Pseudo"))
    tgt = "%s@%s" % (kv.get("user", ""), kv.get("hostname", alias))
    return tgt, kv.get("port", "22"), kv.get("proxyjump", "none")


# ssh options for a hop opened ON a cluster (lxplus, the relay): key auth only (lxplus tries
# Kerberos first and burns ~15 s per hop), no prompts, learn host keys on first contact.
HOP_OPTS = ("-o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=30 "
            "-o GSSAPIAuthentication=no -o PreferredAuthentications=publickey -o ServerAliveInterval=30")


def copy_initiator(src, dst):
    """Where a site-to-site copy runs. Data never crosses this laptop: the WSL downlink is
    ~100 KB/s and one bulk channel starves every other channel multiplexed on the same ssh
    master (every `site` call to lxplus took 8 s while one 58 MB copy crawled).
    A two-factor site (lxplus) cannot be opened from another host, so it initiates every
    copy it takes part in, authenticating outward with the agent forwarded from here;
    anything else runs on the relay host (sites.toml defaults.relay), which reaches all sites."""
    for sc in (src, dst):
        if sc.get("two_factor"):
            return sc
    return None


# TCP relay that clamps the segment size (sites.toml hop_mss). Jean Zay: from the relay host, ssh data bigger than
# ~1.4 KB sent to its login host is dropped (path MTU black hole; the laptop's ProxyJump works only because its
# own segments are small), so any `site copy` into Jean Zay stalls until "server not responding".
_MSS_PROXY = """
import socket, sys, os, select
s = socket.socket(); s.setsockopt(socket.IPPROTO_TCP, socket.TCP_MAXSEG, int(sys.argv[3]))
s.connect((sys.argv[1], int(sys.argv[2]))); fds = [0, s]
while True:
    for f in select.select(fds, [], [])[0]:
        if f == 0:
            d = os.read(0, 8192)
            if d: s.sendall(d)
            else: fds.remove(0); s.shutdown(socket.SHUT_WR)
        else:
            d = s.recv(8192)
            if not d: sys.exit(0)
            os.write(1, d)
"""


def hop_cmd(sc, inner, relay_tgt):
    """ssh invocation that runs `inner` on site `sc` from another cluster host."""
    tgt, port, jump = ssh_target(sc["ssh"])
    via = "" if jump == "none" or not relay_tgt else "-J %s " % relay_tgt
    # a site whose login nodes stall on the default key exchange (Jean Zay: sites.toml hop_kex, as ~/.ssh/config)
    kex = "-o KexAlgorithms=%s " % sc["hop_kex"] if sc.get("hop_kex") else ""
    if sc.get("hop_mss") and not via:  # on the relay itself; behind -J the relay forwards the segments
        px = "python3 -c \"$(echo %s | base64 -d)\" %%h %%p %d" % (
            base64.b64encode(_MSS_PROXY.encode()).decode(), sc["hop_mss"])
        kex += "-o %s " % shlex.quote("ProxyCommand=" + px)
    return "ssh %s %s-p %s %s%s %s" % (HOP_OPTS, kex, port, via, tgt, shlex.quote(inner))


def ensure_agent_on(sc):
    """A forwarded agent socket on a two-factor site (sites.toml agent_sock), re-created on the
    live master when missing (forwards do not survive a master restart)."""
    sock = sc.get("agent_sock")
    if not sock:
        die("%s: set agent_sock in sites.toml (unix socket path for the forwarded ssh agent)" % sc["ssh"])
    local_sock = os.environ.get("SSH_AUTH_SOCK")
    if not local_sock:
        die("no SSH_AUTH_SOCK here; the copy authenticates outward from %s with this agent" % sc["ssh"])
    rc, out = run_ssh(sc, "SSH_AUTH_SOCK=%s ssh-add -l >/dev/null 2>&1" % shlex.quote(sock), timeout=60)
    if rc == 0:
        return sock
    # a stale socket file left by an earlier master makes the remote bind fail ("Connection refused" after)
    run_ssh(sc, "rm -f %s" % shlex.quote(sock), timeout=60)
    local(["ssh", sc["ssh"], "-O", "forward", "-R", "%s:%s" % (sock, local_sock)], check=False)
    rc, out = run_ssh(sc, "SSH_AUTH_SOCK=%s ssh-add -l 2>&1" % shlex.quote(sock), timeout=60)
    if rc:
        die("%s: no usable ssh agent at %s even after forwarding ours:\n%s" % (sc["ssh"], sock, out.strip()))
    return sock


def cmd_copy(a):
    """Copy files of a project from one site to another, site to site. The data never crosses this
    laptop: the copy is initiated on lxplus when lxplus is an endpoint (two-factor: nobody can open
    it), otherwise on the relay host, with `tar | ssh ... tar` between the two sites. Paths are
    relative to the project checkout on the source site; they land at the same relative path on
    the destination unless --to gives another (absolute paths allowed for data outside the
    checkout). A file already at the destination is kept (tar --skip-old-files) unless --overwrite."""
    pr = project_of(a.project)
    if ledger_on(a.project) and not a.item:
        die("a copy is work: --item <id> (repeatable; '*' = every active item of %s)" % a.project)
    resolve_items(a.project, a.item, "copy")
    src, dst = site_of(a.src), site_of(a.dst)
    if src is dst or a.src == a.dst:
        die("source and destination are the same site")
    relay = (cfg_sites().get("defaults") or {}).get("relay")
    if not relay:
        die("sites.toml needs defaults.relay = <ssh alias of a host that reaches every site>")
    relay_tgt = ssh_target(relay)[0]
    init = copy_initiator(src, dst)
    root = lambda sc: "%s/%s" % (sc["root"], pr.get("remote_name", a.project))
    sroot, droot = root(src), root(dst)
    rel = lambda path, r: path if path.startswith("/") else "%s/%s" % (r, path)
    keep = "" if a.overwrite else "--skip-old-files "
    # a copy outlives the generic 120 s default; --timeout above that is honoured
    timeout = a.timeout if a.timeout and a.timeout > 120 else 7200
    agent = ensure_agent_on(init) if init is not None and not a.check else None
    # --from-file: the one path is a root directory, the file lists what to carry relative to it
    # (one per line); it travels in chunks, each one tar of exactly those members (tar -T -)
    units = []
    if a.from_file:
        if len(a.paths) != 1:
            die("--from-file takes exactly one path: the root its list is relative to")
        names = [l.strip() for l in open(a.from_file) if l.strip()]
        if not names or any(n.startswith("/") or ".." in n.split("/") for n in names):
            die("--from-file: an empty list, or a name that is absolute or leaves the root")
        sp = rel(a.paths[0], sroot).rstrip("/")
        ddir = (rel(a.to, droot) if a.to else rel(a.paths[0], droot)).rstrip("/")
        CH = 500
        for i in range(0, len(names), CH):
            units.append((sp, None, names[i:i + CH], ddir, "%s [%d-%d of %d listed]" % (sp, i + 1, min(i + CH, len(names)), len(names))))
    else:
        for path in a.paths:
            sp = rel(path, sroot)
            dp = rel(a.to, droot) if a.to else rel(path, droot)
            sdir, base = os.path.dirname(sp.rstrip("/")), os.path.basename(sp.rstrip("/"))
            units.append((sdir, base, None, dp.rstrip("/") if a.to else os.path.dirname(dp.rstrip("/")), sp))
    for sdir, base, members, ddir, label in units:
        if members is None:
            rc, out = run_ssh(src, "du -sh %s" % shlex.quote(label), timeout=120)
            size = out.split()[0] if not rc else None
        else:
            rc, out = run_ssh(src, "cd %s && du -csh %s | tail -1" % (shlex.quote(sdir), " ".join(shlex.quote(m) for m in members)), timeout=300)
            size = out.split()[0] if not rc else None
        if rc:
            die("%s:%s not found:\n%s" % (a.src, label, out.strip()[-2000:]))
        where = "on %s" % (init["ssh"] if init is not None else relay)
        print("  %s:%s (%s) -> %s:%s/   [%s, site to site]" % (a.src, label, size, a.dst, ddir, where))
        if a.check:
            continue
        rc, out = run_ssh(dst, "mkdir -p %s" % shlex.quote(ddir), timeout=120)
        if rc:
            die("cannot create %s:%s:\n%s" % (a.dst, ddir, out.strip()))
        if members is None:
            produce = "tar -C %s -cf - %s" % (shlex.quote(sdir), shlex.quote(base))
        else:
            produce = "printf '%%s\\n' %s | tar -C %s -cf - -T -" % (" ".join(shlex.quote(m) for m in members), shlex.quote(sdir))
        consume = "tar -C %s %s-xvf -" % (shlex.quote(ddir), keep)
        # a site that prints a login notice on every connection (CC-IN2P3) writes it into the same
        # stdout as the archive, ahead of it, and the receiving tar dies on it ("Skipping to next
        # header"): the archive travels as base64 after a marker line, everything before it dropped
        produce = "{ echo __SITE_TAR__; %s | base64 -w 76; }" % produce
        # no `$` in the filter: it passes through one more remote shell on some hops
        consume = "awk 'f; /^__SITE_TAR__/ {f = 1}' | base64 -d | %s" % consume
        if init is not None:
            if src is not init:
                produce = hop_cmd(src, produce, relay_tgt)
            if dst is not init:
                consume = hop_cmd(dst, consume, relay_tgt)
            pipeline = "export SSH_AUTH_SOCK=%s; set -o pipefail; %s | %s" % (shlex.quote(agent), produce, consume)
            p = subprocess.run(ssh_cmd(init, pipeline), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               timeout=timeout)
        else:
            pipeline = "export PATH=/usr/bin:/bin:$PATH; set -o pipefail; %s | %s" % (
                hop_cmd(src, produce, None), hop_cmd(dst, consume, None))
            # a fresh connection: -A is ignored on a reused master
            p = subprocess.run(["ssh", "-A", "-o", "ControlPath=none", "-o", "BatchMode=yes", relay, pipeline],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
        out = strip_banner(p.stdout.decode("utf-8", "replace"), init)
        if p.returncode:
            die("copy failed (exit %s):\n%s" % (p.returncode, out.strip()[-2000:]))
        n = len([l for l in out.splitlines() if l and not l.endswith("/") and not l.startswith("Warning:")])
        print("  %d files written%s" % (n, "" if a.overwrite else " (existing ones kept)"))


def cmd_shell(a):
    sc = site_of(a.site)
    if a.gpu and sc.get("interactive"):
        print("  opening an interactive GPU session on %s ..." % a.site)
        os.execvp("ssh", ssh_cmd(sc, sc["interactive"], tty=True,
                                 gpu=bool(sc.get("ssh_gpu"))))
    os.execvp("ssh", ["ssh", "-t", sc["ssh"], "cd %s && exec bash -l" % sc["root"]])


# ------------------------------------------------------------------ env
def run_ssh_input(sc, script, timeout=3600):
    """Run a whole bash script on the site through stdin (no quoting games)."""
    p = subprocess.run(ssh_cmd(sc, "bash -s"), input=_rd(script).encode(),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
    return p.returncode, strip_banner(p.stdout.decode("utf-8", "replace"), sc)


def project_recipe(pr):
    """(pip args, recipe pins torch itself?) from the local checkout."""
    wc = os.path.expanduser(pr["local"])
    req = os.path.join(wc, "requirements.txt")
    if os.path.exists(req):
        txt = open(req).read()
        return "-r requirements.txt", bool(re.search(r"^torch\s*==", txt, re.M))
    if os.path.exists(os.path.join(wc, "pyproject.toml")):
        extras = pr.get("pip_extras")
        return ('-e ".[%s]"' % extras) if extras else "-e .", False
    return "", False


_PY_VERIFY = """
import sys
try:
    import torch                  # a project without torch is verified by its python alone
except ImportError:
    torch = None
print("verify python", sys.version.split()[0], "torch", torch and torch.__version__,
      "cuda", torch and torch.version.cuda, "exe", sys.executable)
c = ((torch and torch.version.cuda) or "0").split(".")[0]
if c.isdigit() and int(c) >= 13:
    sys.exit("FATAL: torch built for CUDA %s, which dropped sm_70 (V100)" % torch.version.cuda)
"""

_PY_CONSTRAINTS = """
import importlib
for m in ("torch", "torchvision", "numpy"):
    try:
        v = importlib.import_module(m).__version__.split("+")[0]
        print("%s==%s" % (m, v))
    except Exception:
        pass
"""

_PY_PLAN = """
import sys, importlib.metadata as md
toks = sys.argv[1].split()
names = [t.rsplit("-", 1)[0] for t in toks[2:]] if len(toks) > 2 else []
bad = []
for n in names:
    try:
        md.distribution(n); bad.append(n)
    except md.PackageNotFoundError:
        pass
print("plan: %d new package(s)%s" % (len(names) - len(bad),
      (", would CHANGE already-installed: " + " ".join(bad)) if bad else ""))
sys.exit(1 if bad else 0)
"""


def env_script(sc, pr, project, site, env, rebuild=False, force_shared=False):
    root = sc["root"]
    remote_path = "%s/%s" % (root, pr.get("remote_name", project))
    branch = pr.get("branch", "trunk")
    recipe, pins_torch = project_recipe(pr)
    kind = env.get("kind", "venv")
    L = ["set -u", "export PIP_DISABLE_PIP_VERSION_CHECK=1"]
    if sc.get("pip_cache"):
        L.append("mkdir -p %s && export PIP_CACHE_DIR=%s" % ((shlex.quote(sc["pip_cache"]),) * 2))
    else:
        L.append("export PIP_NO_CACHE_DIR=1")
    L += ["P=%s; URL=%s; BR=%s" % (shlex.quote(remote_path), shlex.quote(pr["repo"]),
                                   shlex.quote(branch)),
          'if [ ! -d "$P/.git" ]; then echo "clone  $URL -> $P"; '
          'git clone -q "$URL" "$P" || { echo "clone failed"; exit 3; }; fi',
          'cd "$P"',
          'git fetch -q origin || echo "note: fetch failed"',
          'if [ -n "$(git status --porcelain --untracked-files=no)" ]; then '
          'echo "REFUSING: tracked changes in $P:"; git status --short --untracked-files=no | head; exit 4; fi',
          'git checkout -q "$BR" 2>/dev/null || git checkout -q -b "$BR" "origin/$BR" '
          '|| { echo "no branch $BR"; exit 5; }',
          'git merge --ff-only -q "origin/$BR" 2>/dev/null || echo "note: not fast-forwarded"',
          'echo "checkout $(git rev-parse --short=10 HEAD) ($BR) at $P"']
    cwd = submit_cwd(sc, pr, project, remote_path)
    if cwd != remote_path:
        L.append("mkdir -p %s && echo \"submit dir %s\"" % (shlex.quote(cwd), cwd))
    # `module` is a shell function that a non-login shell may not have
    L.append("command -v module >/dev/null 2>&1 || { for f in /etc/profile.d/modules.sh "
             "/usr/share/lmod/lmod/init/bash; do [ -f $f ] && . $f && break; done; } || true")
    cons = "/tmp/site-cons.$$"
    if kind == "venv":
        if env.get("python"):
            L.append("%s || { echo \"python bootstrap failed: %s\"; exit 6; }"
                     % (env["python"], env["python"]))
        py = env.get("python_bin", "python")
        ssp = "--system-site-packages" if env.get("system_site_packages") else ""
        if rebuild:
            L.append("rm -rf .venv")
        L += ['if [ -x .venv/bin/python ]; then echo "venv   exists: .venv"; else '
              'echo "venv   creating with $(%s --version 2>&1)"; %s -m venv %s .venv || exit 7; fi'
              % (py, py, ssp),
              "V=.venv/bin/python; $V -m pip install -q --upgrade pip"]
        if env.get("torch_index") and not pins_torch:
            L.append("$V -m pip install -q --index-url %s torch torchvision || exit 8"
                     % shlex.quote(env["torch_index"]))
        if (env.get("torch_index") and not pins_torch) or ssp:
            L += ["$V - <<'PYC' > %s\n%sPYC" % (cons, _PY_CONSTRAINTS),
                  "echo \"pins   $(tr '\\n' ' ' < %s)\"; export PIP_CONSTRAINT=%s" % (cons, cons)]
        if recipe:
            L.append("echo \"recipe pip install %s\"; $V -m pip install -q %s || exit 9"
                     % (recipe, recipe))
        L.append("$V - <<'PYV'\n%sPYV" % _PY_VERIFY)
        L.append("[ $? -eq 0 ] || exit 10")
    elif kind == "shared":
        L += ["%s || { echo \"shared env activation failed\"; exit 6; }" % env["activate"],
              'echo "shared $(command -v python)"']
        if recipe:
            L += ["python - <<'PYC' > %s\n%sPYC" % (cons, _PY_CONSTRAINTS),
                  "echo \"pins   $(tr '\\n' ' ' < %s)\"; export PIP_CONSTRAINT=%s" % (cons, cons),
                  "PLAN=$(python -m pip install --dry-run %s 2>&1 | grep -i '^Would install' || true)"
                  % recipe,
                  "python - \"$PLAN\" <<'PYP'\n%sPYP" % _PY_PLAN,
                  "rc=$?; if [ %d -eq 0 ]; then echo \"shared env left untouched (pass "
                  "--force-shared to install the plan above; it can break the OTHER projects "
                  "using this env)\"; elif [ $rc -ne 0 ]; then echo \"REFUSING: the plan changes "
                  "packages already installed\"; exit 11; else "
                  "echo \"recipe pip install %s\"; python -m pip install -q %s || exit 9; fi"
                  % (1 if force_shared else 0, recipe, recipe)]
        L.append("python - <<'PYV'\n%sPYV" % _PY_VERIFY)
        L.append("[ $? -eq 0 ] || exit 10")
    else:
        die("unknown env kind %r for %s@%s" % (kind, project, site))
    # the acceptance test is the thing jobs actually do: source activate.sh
    L += ["cat > /tmp/site-act.$$ <<'ACT'\nexport CCORCH_SITE=__SITE__\ncd __P__\n"
          "source sites/activate.sh\npython -c 'import sys; print(\"activate.sh ok:\", "
          "sys.executable)'\nACT",
          "bash -l /tmp/site-act.$$ || { echo \"activate.sh FAILED\"; exit 12; }",]
    if os.path.exists(os.path.join(os.path.expanduser(pr["local"]), "sites", "setup.sh")):
        # the project's non-Python needs (MadGraph, caches, datasets, containers)
        L += ["cat > /tmp/site-setup.$$ <<'SET'\nexport CCORCH_SITE=__SITE__\ncd __P__\n"
              "source sites/activate.sh\necho \"setup  running sites/setup.sh\"\n"
              "bash sites/setup.sh || exit 13\n"
              "bash sites/setup.sh --verify || { echo \"setup  VERIFY FAILED\"; exit 14; }\nSET",
              "bash -l /tmp/site-setup.$$ || exit $?",
              "rm -f /tmp/site-setup.$$"]
    L += [
          "rm -f /tmp/site-act.$$ %s" % cons,
          'echo "env    ready: %s @ %s"' % (project, site)]
    return "\n".join(L).replace("__SITE__", site).replace("__P__", remote_path) + "\n"


def cmd_env(a):
    """Make a project runnable at a site: checkout + environment, verified."""
    pr = project_of(a.project)
    sc = site_of(a.site)
    ps = project_site(pr, a.site)
    env = ps.get("env") or {"kind": "venv"}
    script = env_script(sc, pr, a.project, a.site, env, a.rebuild, a.force_shared)
    if a.check:
        print(script)
        return
    if sc.get("login_cap"):
        # a site whose login nodes take no scripts (sites.toml login_cap): the setup runs as a CPU job, and the same
        # command again reads its result (exit 75 until then)
        a.timeout, a.recurring = max(a.timeout, 1800), False
        rc = run_as_job(a, sc, pr, script, "env %s" % a.project)
        if rc:
            sys.exit(rc)
        return
    print("  env %s @ %s (%s%s)" % (a.project, a.site, env.get("kind", "venv"),
                                    ": " + env["path"] if env.get("path") else ""))
    t0 = time.time()
    rc, out = run_ssh_input(sc, script, timeout=max(a.timeout, 3600))
    for l in out.rstrip().splitlines():
        print("    " + l)
    if rc:
        die("env %s@%s failed (exit %d) after %ds" % (a.project, a.site, rc, time.time() - t0))
    print("  done in %ds" % (time.time() - t0))


# ------------------------------------------------------------------ placement
BACKOFF_DIR = os.path.expanduser("~/.cache/ccorch/backoff")


def backoff_left(alias):
    """Seconds until a new connection to alias is allowed again (0 = go)."""
    try:
        for line in open(os.path.join(BACKOFF_DIR, alias)):
            k, _, v = line.rstrip("\n").partition("=")
            if k == "next":
                return max(0, int(v or 0) - int(time.time()))
    except (OSError, ValueError):
        pass
    return 0


def ssh_answers(alias):
    """A 2FA site is called down only after a retry: the master checked again 5 s later, then one direct ssh that
    cannot prompt (one failed master check alone is not a site down)."""
    time.sleep(5)
    if master_alive(alias):
        return True
    try:
        return subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", alias, "echo ok"],
                              capture_output=True, text=True, timeout=30).stdout.strip() == "ok"
    except subprocess.TimeoutExpired:
        return False


def master_alive(alias):
    p = subprocess.run(["ssh", "-O", "check", alias], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    return p.returncode == 0


VERIFY_CACHE = os.path.join(HOME, "verify_cache.json")
VERIFY_TTL = 600            # a passed sites/setup.sh --verify is good for 10 min
VERIFY_STALE_OK = 24 * 3600  # ... and still counts for 24 h when a later verify only timed out
HIST_TTL = 1800             # my job history changes slowly: 30 min


def _cache_get(key, ttl):
    try:
        e = json.load(open(VERIFY_CACHE)).get(key)
        if e and time.time() - e.get("ts", 0) < ttl:
            return e
    except Exception:
        pass
    return None


def _cache_put(key, **fields):
    try:
        d = json.load(open(VERIFY_CACHE)) if os.path.exists(VERIFY_CACHE) else {}
    except Exception:
        d = {}
    fields["ts"] = int(time.time())
    d[key] = fields
    try:
        with open(VERIFY_CACHE, "w") as f:
            json.dump(d, f)
    except Exception:
        pass


def verify_cached(site, project):
    e = _cache_get("%s/%s" % (site, project), VERIFY_TTL)
    return e if e and e.get("rc") == 0 else None


def hist_cached(site):
    e = _cache_get("hist:" + site, HIST_TTL)
    return e.get("raw", "") if e else None


# ----------------------------------------------------------------- the request
# What is being placed: N jobs in G groups (a DyHPO sweep's trials share their state
# on ONE site's filesystem, so a group never splits), each job needing gpus/mem/cpus
# for about `hours`. Memory and CPUs decide whether a "free" GPU is usable at all:
# a node with 2 idle V100s and 27 GB of free host memory cannot start a 32 GB job.
def _mem_mb(v, default=None):
    if v is None or v == "":
        return default
    s = str(v).strip().upper()
    try:
        if s.endswith("G") or s.endswith("GB"):
            return int(float(s.rstrip("B").rstrip("G")) * 1024)
        if s.endswith("M") or s.endswith("MB"):
            return int(float(s.rstrip("B").rstrip("M")))
        if s.endswith("T") or s.endswith("TB"):
            return int(float(s.rstrip("B").rstrip("T")) * 1024 * 1024)
        return int(float(s))
    except ValueError:
        return default


def make_request(pr, site, gpus=None, mem=None, cpus=None, hours=None, gpu_min_mem=None):
    """Per-site defaults come from the project's sites.yaml cluster block (CC-IN2P3
    demands --mem, and its canonical template says 32G); the caller overrides."""
    cl = (project_site(pr, site).get("cluster") or {})
    req = {"gpus": 1 if gpus is None else int(gpus),     # 0 = a CPU job (was `gpus or 1`: --gpus 0 planned 1 GPU)
           "mem_mb": _mem_mb(mem) or _mem_mb(cl.get("mem")) or 8192,
           "cpus": int(cpus or cl.get("cpus_per_task") or cl.get("cpus") or 4),
           "hours": float(hours) if hours else None,
           "gpu_min_mb": _mem_mb(gpu_min_mem) or 0}     # a job's minimum GPU memory: HTCondor slots below it not counted
    req["mem"] = "%dG" % round(req["mem_mb"] / 1024.0) if req["mem_mb"] >= 1024 else "%dM" % req["mem_mb"]
    return req


def _test_flags(sc, ps, part, req):
    """The flags a real job of this request would carry here, for sbatch --test-only."""
    cl = ps.get("cluster") or {}
    f = []
    cpu = (ps.get("cpu") or {}) if req.get("gpus") == 0 else {}
    if part:
        f.append("-p %s" % shlex.quote(part))
    acc = cpu.get("account") or cl.get("account")
    if acc:
        f.append("-A %s" % shlex.quote(str(acc)))
    qos = cpu.get("qos") if cpu else cl.get("qos")
    if qos:
        f.append("-q %s" % shlex.quote(str(qos)))
    if req.get("gpus") != 0:
        gf = cl.get("gpu_flag") or sc.get("gpu_flag") or "--gres=gpu:{n}"
        f.append(gf.format(n=req["gpus"]))
    if cl.get("mem") or sc.get("scheduler") == "slurm":
        f.append("--mem=%dM" % req["mem_mb"])
    f.append("-c %d" % req["cpus"])
    h = req.get("hours") or 1.0
    f.append("-t %02d:%02d:00" % (int(h), int((h % 1) * 60)))
    return " ".join(f)


def _probe_script(sc, pr, project, site, req):
    remote_path = "%s/%s" % (sc["root"], pr.get("remote_name", project))
    ps = project_site(pr, site)
    env = ps.get("env") or {}
    shared = env.get("path", "")
    L = ["P=%s" % shlex.quote(remote_path),
         "echo t_probe_start=$(date +%s)",
         'echo checkout=$([ -d "$P/.git" ] && echo yes || echo no)']
    if not verify_cached(site, project):
        L.append('if [ -f "$P/sites/setup.sh" ]; then out=$(cd "$P" && export CCORCH_SITE=%s && '
                 'source sites/activate.sh >/dev/null 2>&1; timeout 180 bash sites/setup.sh --verify 2>&1); '
                 'rc=$?; echo "setup_rc=$rc"; echo "setup_msg=$(tail -1 <<<"$out")"; fi' % site)
    L += ['if [ -x "$P/.venv/bin/python" ]; then echo env=venv; '
          'elif [ -n %s ] && [ -d %s ]; then echo env=shared; else echo env=no; fi'
          % (shlex.quote(shared), shlex.quote(shared))]
    if sc["scheduler"] == "slurm":
        cl = ps.get("cluster") or {}
        part = gpu_partitions(cl.get("partition") or sc.get("partition") or "", cl, req.get("gpu_min_mb"))
        qos = cl.get("qos") or ""
        acc = cl.get("account") or ""
        if req.get("gpus") == 0 and ps.get("cpu"):
            # a CPU job runs on the project's cpu partition (site_flags routes it there): probe THAT, not the GPU nodes
            cpu = ps["cpu"]
            part, qos, acc = cpu.get("partition") or part, cpu.get("qos") or "", cpu.get("account") or acc
        pflag = ("-p %s" % shlex.quote(part)) if part else ""
        L += ["echo partition=%s" % (part or "-"),
              # others competing for GPUs now: pending for Resources only. Jobs pending for Priority
              # with GPUs free are waiting for something a 1-GPU job does not need (Jean Zay:
              # 423 Priority + 1 Resources in gpu_p2 with 64 GPUs free; mine started in a minute)
              "echo pending=$(squeue -h %s -t PD -o %%r 2>/dev/null | grep -c '^Resources$')" % pflag,
              "echo running=$(squeue -h %s -t R 2>/dev/null | wc -l)" % pflag,
              "echo mine_total=$(squeue -h --me 2>/dev/null | wc -l)",
              "echo mine_pending=$(squeue -h --me %s -t PD 2>/dev/null | wc -l)" % pflag,
              "echo mine_running=$(squeue -h --me %s -t R 2>/dev/null | wc -l)" % pflag,
              # the per-user caps that made 104 of 204 CC trials unsubmittable: QOS first, then association
              "echo qos_caps=$(sacctmgr -nP show qos %s format=MaxSubmitPU,MaxJobsPU 2>/dev/null | head -1)" % shlex.quote(qos or "normal"),
              "echo assoc_caps=$(sacctmgr -nP show assoc where user=$USER %s format=MaxSubmit,MaxJobs 2>/dev/null | head -1)"
              % ("account=%s" % shlex.quote(acc) if acc else ""),
              # every node of the partition: state, free host memory, GPUs total/used, CPUs A/I/O/T
              "sinfo -h %s -N -O NodeHost:40,StateCompact:14,FreeMem:14,Gres:50,GresUsed:70,CPUsState:24,Memory:14,"
              "AllocMem:14 2>/dev/null | sed 's/  */ /g' | while read -r n st fm g gu c tm am; do "
              "echo \"node=$n|$st|$fm|$g|$gu|$c|$tm|$am\"; done" % pflag,
              # SLURM's own start estimate for one job of exactly this request
              "est=$(timeout 20 sbatch --test-only %s --wrap true 2>&1 | sed -n 's/.*to start at \\([0-9T:-]*\\).*/\\1/p' | head -1); "
              "[ -n \"$est\" ] && echo est_wait=$(( $(date -d \"$est\" +%%s) - $(date +%%s) ))" % _test_flags(sc, ps, part, req),
              "echo maint=$(scontrol show reservations 2>/dev/null | grep -B1 -i 'Flags=.*MAINT' "
              "| sed -n 's/.*StartTime=\\([^ ]*\\).*/\\1/p' | head -1)"]
        if hist_cached(site) is None:
            L.append("echo recent=$(timeout 20 sacct -X -n -P -u $USER -S $(date -d '-7 days' +%%F) %s "
                     "-o Submit,Start,Elapsed,State 2>/dev/null | grep -E 'COMPLETED|RUNNING|TIMEOUT|FAILED' "
                     "| tail -100 | tr '\\n' ';')" % ("-r %s" % shlex.quote(part) if part else ""))
    else:
        # A GPU slot is usable only if it is Unclaimed, still holds a GPU (a claimed
        # partitionable slot advertises a GPU-less remainder) and has the memory/CPUs.
        # one condor_status pass gives everything about the slots; condor_q runs alongside
        gmin = (" && GPUs_GlobalMemoryMb >= %d" % req["gpu_min_mb"]) if req.get("gpu_min_mb") else ""
        # A slot whose START is false (reserved or draining nodes: lxplus's unclaimed H100/H200 partitionable slots)
        # runs nothing of ours, and the schedd raises every GPU job to its per-GPU share
        # (CONDOR_MB_PER_CPU), so a free GPU counts only on an Unclaimed slot that may start and still holds the
        # raised request per GPU it gives.
        C = max(req["cpus"], -(-req["mem_mb"] // CONDOR_MB_PER_CPU)); M = max(req["mem_mb"], C * CONDOR_MB_PER_CPU)
        if req.get("gpus") == 0:
            # a CPU job (prebuild, generation): GPU-less slots that may start, in units of this request (the SLURM
            # branch's cpu partition); counting GPU slots instead plans CPU jobs on far too few slots
            L += ["( condor_status -constraint '(TotalGPUs =?= undefined || TotalGPUs == 0)' -af State Cpus Memory Start "
                  "2>/dev/null | awk -v M=%d -v C=%d '{n++} $1==\"Unclaimed\" && $4!=\"false\" {k=int($3/M); c=int($2/C); "
                  "if (c<k) k=c; t+=k} END {print \"gpu_slots=\" n+0; print \"gpu_free=\" t+0; print \"fit_free=\" t+0; "
                  "if (n==0) print \"qfail_status=1\"}' ) &" % (M, C)]
        else:
          L += ["( condor_status -constraint 'TotalGPUs > 0 && %s' -af State GPUs Memory Cpus Start 2>/dev/null | awk -v M=%d -v C=%d "
              "'{n++} $1==\"Unclaimed\" && $2>0 && $5!=\"false\" {f+=$2; k=int($3/M); c=int($4/C); if (c<k) k=c; if ($2<k) k=$2; t+=k} "
              "END {print \"gpu_slots=\" n+0; print \"gpu_free=\" f+0; print \"fit_free=\" t+0; if (n==0) print \"qfail_status=1\"}' ) &"
              % (CONDOR_GPU_REQ.replace("TARGET.", "") + gmin, M, C)]
        L += [
              # my queue, from the schedd's own totals line; a failed query must not read as 0
              "( q=$(condor_q -totals 2>/dev/null | grep \"Total for $USER\"); "
              "if [ -n \"$q\" ]; then echo mine_idle=$(sed -n 's/.* \\([0-9]*\\) idle.*/\\1/p' <<<\"$q\"); "
              "echo mine_running=$(sed -n 's/.* \\([0-9]*\\) running.*/\\1/p' <<<\"$q\"); "
              "echo mine_held=$(sed -n 's/.* \\([0-9]*\\) held.*/\\1/p' <<<\"$q\"); else echo qfail=1; fi ) &",
              "echo cap_owner=$(condor_config_val -schedd MAX_JOBS_PER_OWNER 2>/dev/null | head -1)",
              "wait"]
        if hist_cached(site) is None:
            L.append("echo recent=$(timeout 15 condor_history -constraint 'RequestGPUs > 0 && JobStartDate > 0' -limit 30 "
                     "-af QDate JobStartDate CompletionDate 2>/dev/null | tr ' ' '|' | tr '\\n' ';')")
    L.append("echo t_probe_end=$(date +%s)")
    return "\n".join(L) + "\n"


# ----------------------------------------------------------------- parsing
def _int(v, default=None):
    v = str(v if v is not None else "").strip()
    return int(v) if v.lstrip("-").isdigit() else default


def _hms(v):
    v = v.strip()
    if not v or v in ("Unknown", "None", "undefined"):
        return None
    if v.isdigit():
        return int(v)
    d, rest = ("0", v)
    if "-" in v and "T" not in v:
        d, _, rest = v.partition("-")
    try:
        parts = [int(x) for x in rest.split(":")]
    except ValueError:
        return None
    while len(parts) < 3:
        parts.insert(0, 0)
    return int(d) * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]


def _ts(v):
    v = v.strip()
    if v.isdigit():
        return int(v)
    try:
        return int(time.mktime(time.strptime(v, "%Y-%m-%dT%H:%M:%S")))
    except ValueError:
        return None


def _median(xs):
    xs = sorted(x for x in xs if x is not None)
    return xs[len(xs) // 2] if xs else None


def recent_stats(raw, scheduler):
    """Median wait (submit->start) and median run time (jobs >10 min only: probes and
    crashes would make a queue of training jobs look like it drains in minutes)."""
    waits, runs = [], []
    for row in (raw or "").split(";"):
        cols = row.split("|")
        if scheduler == "slurm" and len(cols) >= 3:
            sub, start = _ts(cols[0]), _ts(cols[1])
            if sub and start and start >= sub:
                waits.append(start - sub)
            el = _hms(cols[2])
            if el:
                runs.append(el)
        elif scheduler != "slurm" and len(cols) >= 2:
            q, st = _ts(cols[0]), _ts(cols[1])
            if q and st and st >= q:
                waits.append(st - q)
            if len(cols) >= 3 and _ts(cols[2]) and _ts(cols[2]) > (st or 0):
                runs.append(_ts(cols[2]) - st)
    long_runs = [r for r in runs if r >= 600]
    return _median(waits), (_median(long_runs) if long_runs else None), len(waits)


def _gres_count(s):
    m = re.search(r"gpu(?::[A-Za-z0-9_]+)?:(\d+)", s or "")
    return int(m.group(1)) if m else 0


def slurm_nodes(lines, req):
    """From sinfo's per-node rows: GPUs free, GPUs free that this request FITS now (schedulable host memory
    >= mem, idle CPUs >= cpus; only idle/mixed nodes), and GPUs on nodes that could EVER hold it (configured
    memory and CPUs, any state but down/drained). Schedulable memory is Memory - AllocMem, what SLURM allocates
    against; FreeMem (the OS's free memory) only when those are missing."""
    free = fit = 0
    ever = 0
    cpu_job = req.get("gpus") == 0
    for ln in lines:
        p = ln.split("|")
        if len(p) < 6:
            continue
        st, fm, g, gu, c = p[1], p[2], p[3], p[4], p[5]
        tm = _int(p[6], None) if len(p) > 6 else None
        am = _int(p[7], None) if len(p) > 7 else None
        tot_cpus = _int(c.split("/")[3], 0) if c.count("/") == 3 else 0
        if not any(x in st for x in ("down", "drain", "fail", "maint")) and tm is not None:
            if tm >= req["mem_mb"] and tot_cpus >= req["cpus"]:
                ever += 1 if cpu_job else _gres_count(g)
        if not (st.startswith("idle") or st.startswith("mix")):
            continue
        if cpu_job:
            # a CPU job: slots are idle CPUs and schedulable memory, in units of this request
            fm_mb = (tm - am) if (tm is not None and am is not None) else _int(fm, 0)
            idle_cpus = _int(c.split("/")[1], 0) if "/" in c else 0
            k = min(idle_cpus // max(1, req["cpus"]), fm_mb // max(1, req["mem_mb"]))
            free += k; fit += k
            continue
        fg = max(0, _gres_count(g) - _gres_count(gu))
        if fg == 0:
            continue
        free += fg
        fm_mb = (tm - am) if (tm is not None and am is not None) else _int(fm, 0)
        idle_cpus = _int(c.split("/")[1], 0) if "/" in c else 0
        if fm_mb >= req["mem_mb"] and idle_cpus >= req["cpus"]:
            fit += min(fg, idle_cpus // max(1, req["cpus"]), fm_mb // max(1, req["mem_mb"]))
    if not any(len(ln.split("|")) > 6 for ln in lines):
        ever = None                                  # an old probe without Memory: unknown, never "0"
    return free, fit, ever


def _fmt_wait(secs):
    secs = int(secs or 0)
    if secs < 60:
        return "0 min"
    if secs < 5400:
        return "%d min" % round(secs / 60.0)
    return "%.1f h" % (secs / 3600.0)


def recent_submissions(project, site, window=900):
    """Jobs sent through `site submit` in the last 15 min and not finished: they take
    free slots before anything submitted now, even if the scheduler lags."""
    try:
        c = db()
        n = c.execute("SELECT COUNT(*) FROM runs WHERE site=? AND finished IS NULL "
                      "AND submitted > ? AND state NOT IN ('COMPLETED','FAILED','CANCELLED')",
                      (site, int(time.time()) - window)).fetchone()[0]
        c.close()
        return int(n or 0)
    except Exception:
        return 0


# ----------------------------------------------------------------- the probe
def probe_site(sc, pr, project, site, req, timeout=120):
    """One dict per site: state (UP/HELD/AVOID/DOWN/UNKNOWN), the measured facts,
    the capacity for THIS request, and a one-line reason. Every number that could
    not be measured is None and is reported as unknown, never as 0."""
    alias = sc["ssh"]
    info = {"site": site, "project": project, "state": "DOWN", "reason": "", "req": req, "t0": time.time()}
    left = backoff_left(alias)
    if left:
        info["reason"] = "in connection backoff for %dm" % (left // 60 + 1)
        return info
    if sc.get("two_factor") and not master_alive(alias) and not ssh_answers(alias):
        info["reason"] = "no live ssh master (2FA; master checked twice and a direct ssh tried): run `cluster_up %s` first" % alias
        return info
    try:
        rc, out = run_ssh_input(sc, _probe_script(sc, pr, project, site, req), timeout=timeout)
    except subprocess.TimeoutExpired:
        info["reason"] = "probe timed out after %ds" % timeout
        return info
    if rc:
        info["reason"] = "unreachable: %s" % (out.strip().splitlines() or ["?"])[-1][:60]
        return info
    nodes = []
    for line in out.splitlines():
        k, _, v = line.strip().partition("=")
        if k == "node":
            nodes.append(v)
        elif k:
            info[k] = v
    info["probe_s"] = (_int(info.get("t_probe_end"), 0) or 0) - (_int(info.get("t_probe_start"), 0) or 0)

    if info.get("checkout") != "yes" or info.get("env") in (None, "no"):
        info.update(state="AVOID", reason="not deployed here (run `site env %s %s`)" % (site, project))
        return info
    vrc = str(info.get("setup_rc", "0"))
    if vrc == "124":
        # a slow filesystem (lxplus EOS: torch import + every pool stat > 180 s) must not unverify a site
        # whose verify passed recently: a pass stands VERIFY_STALE_OK after a timeout; a real failure still blocks
        last = _cache_get("%s/%s" % (site, project), VERIFY_STALE_OK)
        if not (last and last.get("rc") == 0):
            info["verify_note"] = "verify timed out (>180 s here)"
    elif vrc not in ("0", ""):
        info.update(state="AVOID", reason="setup incomplete: %s (run `site env %s %s`)"
                    % (str(info.get("setup_msg") or "sites/setup.sh --verify failed")[:90], site, project))
        _cache_put("%s/%s" % (site, project), rc=_int(vrc, 1), msg=str(info.get("setup_msg") or ""))
        return info
    elif vrc == "0" and "setup_rc" in info:
        _cache_put("%s/%s" % (site, project), rc=0, msg=str(info.get("setup_msg") or ""))
    if info.get("maint"):
        try:
            t = time.mktime(time.strptime(info["maint"], "%Y-%m-%dT%H:%M:%S"))
            if 0 <= t - time.time() < 86400:
                info.update(state="AVOID", reason="maintenance reservation at %s" % info["maint"])
                return info
        except ValueError:
            pass

    # ---- history (cached) -> what my jobs really waited and ran here
    if str(info.get("recent", "")).strip():
        _cache_put("hist:" + site, raw=str(info["recent"]))
    elif hist_cached(site) is not None:
        info["recent"] = hist_cached(site)
    med_wait, med_run, nrec = recent_stats(info.get("recent"), sc["scheduler"])
    info.update(med_wait=med_wait, med_run=med_run, n_recent=nrec)

    # ---- capacity for this request
    unknown = []
    if sc["scheduler"] == "slurm":
        free, fit, fit_ever = slurm_nodes(nodes, req)
        if not nodes:
            unknown.append("nodes")
        mine_total = _int(info.get("mine_total"))
        mine_pd = _int(info.get("mine_pending"))
        mine_run = _int(info.get("mine_running"))
        others_pd = max(0, (_int(info.get("pending")) or 0) - (mine_pd or 0))
        caps = [c for c in (str(info.get("qos_caps", "")).split("|") + str(info.get("assoc_caps", "")).split("|")) if c.strip().isdigit()]
        cap = min(int(c) for c in caps) if caps else None
        total_slots = free + (_int(info.get("running")) or 0)
    else:
        free, fit = _int(info.get("gpu_free")), _int(info.get("fit_free"))
        fit_ever = None                       # partitionable slots: not knowable from their remainders
        if free is None or fit is None or info.get("qfail_status"):
            unknown.append("free slots")
            free = fit = None
        mine_pd, mine_run = _int(info.get("mine_idle")), _int(info.get("mine_running"))
        if info.get("qfail") or mine_pd is None:
            unknown.append("my queue")
            mine_pd = mine_run = None
        mine_total = (mine_pd or 0) + (mine_run or 0) + (_int(info.get("mine_held")) or 0) if mine_pd is not None else None
        others_pd = None                      # not visible on a shared schedd; the observed wait carries it
        cap = _int(info.get("cap_owner"))
        total_slots = _int(info.get("gpu_slots")) or 0
    mine_q = max(mine_pd or 0, recent_submissions(project, site))
    cap_left = (cap - mine_total) if (cap is not None and mine_total is not None) else None
    slots_now = (fit or 0) - mine_q                     # my queued jobs take the fitting GPUs first
    est_now = _int(info.get("est_wait"))
    if others_pd and not (est_now is not None and est_now <= 600):
        # so does everyone already waiting -- unless SLURM's own estimate says a job of this
        # request starts now: then the pending jobs are held by something else (QOS caps,
        # dependencies, whole-node requests) and do not compete for these GPUs (Jean Zay: 465
        # pending in gpu_p2 with 72 GPUs free made the plan give it one job at a time)
        slots_now -= others_pd
    if cap_left is not None:
        slots_now = min(slots_now, cap_left)
    slots_now = max(0, slots_now)
    est = _int(info.get("est_wait"))
    if slots_now > 0:
        wait_now = 0
    elif mine_q > 0 and est is not None:
        # a live full queue with my jobs already in it: history of past waits must not hide it
        wait_now = max(0, est, med_wait or 0)
    elif med_wait is not None and nrec >= 5:
        wait_now = med_wait
    elif est is not None:
        wait_now = max(0, est)
    else:
        wait_now = 1800
    info.update(free=free, fit=fit, fit_ever=fit_ever, mine_q=mine_q, mine_run=mine_run, mine_total=mine_total,
                others_pd=others_pd, cap=cap, cap_left=cap_left, slots_now=slots_now,
                wait_now=wait_now, est_wait=est, total_slots=total_slots, unknown=unknown,
                state="UP")
    # ---- one line a person can check against squeue/condor_status
    if sc["scheduler"] == "slurm":
        facts = "%s: %s free %s, %s fit %s/%dcpu" % (info.get("partition"), free,
                                                     "job slots (CPU job)" if req.get("gpus") == 0 else "GPUs",
                                                     fit, req["mem"], req["cpus"])
    else:
        facts = "%s/%s GPU slots free, %s fit %s/%dcpu" % (free if free is not None else "?", total_slots,
                                                            fit if fit is not None else "?", req["mem"], req["cpus"])
    mine = "mine %s running + %s queued" % (mine_run if mine_run is not None else "?", mine_q)
    if cap is not None:
        mine += " (cap %d: %s left)" % (cap, cap_left if cap_left is not None else "?")
    if others_pd:
        mine += "; %d others pending" % others_pd
    w = "wait now ~%s" % _fmt_wait(wait_now)
    tail = []
    if est is not None:
        tail.append("slurm says %s" % _fmt_wait(max(0, est)))
    if med_wait is not None:
        tail.append("my last %d jobs waited ~%s%s" % (nrec, _fmt_wait(med_wait),
                    (", ran ~%s" % _fmt_wait(med_run)) if med_run else ""))
    if tail:
        w += " (" + "; ".join(tail) + ")"
    notes = []
    if mine_q and not (mine_run or 0) and (fit or 0) > 0 and sc["scheduler"] != "slurm":
        notes.append("%d of mine idle while %d slots fit: starts are NOT happening here" % (mine_q, fit))
    if fit_ever == 0:
        notes.append("NO NODE HERE CAN EVER HOLD %s/%dcpu" % (req["mem"], req["cpus"]))
    if unknown:
        notes.append("UNKNOWN: " + ", ".join(unknown))
    if info.get("verify_note"):
        notes.append(info["verify_note"])
    info["reason"] = "; ".join([facts, mine, w] + notes) + "  [probe %ss]" % info["probe_s"]
    return info


# ----------------------------------------------------------------- the plan
def not_allotted_reason(r):
    """Why a site that is UP still gets no work from the plan (None: it may). An unverified site (sites/setup.sh
    --verify timed out), or one with no GPU that fits a request larger than its default memory (or that no node can
    ever hold), would otherwise get a finite finish time from the wait-then-one-at-a-time model (jobs allotted to a
    site with 0 fitting GPUs)."""
    if r.get("verify_note"):
        return r["verify_note"] + ": site not verified"
    req = r.get("req") or {}
    if r.get("fit_ever") == 0:
        return "no node can ever hold %s/%scpu" % (req.get("mem"), req.get("cpus"))
    if r.get("fit") == 0:
        try:
            big = req["mem_mb"] > make_request(project_of(r.get("project") or ""), r["site"])["mem_mb"]
        except Exception:
            big = False
        if big:
            return "0 GPUs fit %s/%scpu" % (req.get("mem"), req.get("cpus"))
    return None


def plan_batch(rows, groups, per_group, hours, allow_scarce=False):
    """Place `groups` groups of `per_group` jobs (each ~`hours` long) so the whole
    batch finishes as early as possible. A site runs k jobs in
        wait0 + hours * ceil(k / concurrency)
    where concurrency is what can start now for this request (fitting free GPUs, minus
    my queued jobs and everyone pending, capped by my submit cap) or, when nothing can
    start now, one job at a time after the observed wait. Each group goes to the site
    whose finish time grows least. Scarce sites (sites.toml budget = "scarce") only when asked."""
    # a submit cap of 0 (e.g. an association with MaxJobs=0) starts nothing ever: not a candidate
    cand = []
    for r in rows:
        if r["state"] == "UP" and (allow_scarce or not r.get("scarce")) and r.get("cap") != 0:
            why = not_allotted_reason(r)
            if why:
                r["skip"] = why              # printed by cmd_pick: a site given no work says why
            else:
                cand.append(dict(r))
    # a site with no run history must not look faster than one with history: without --hours every site is timed
    # by the longest known median run (a 1 h default would otherwise beat a measured 4.8 h)
    known = [r["med_run"] for r in rows if r.get("med_run")]
    dflt_h = (max(known) / 3600.0) if known else 1.0
    for r in cand:
        r["k"] = 0
        r["hours"] = hours or ((r.get("med_run") or dflt_h * 3600) / 3600.0)
        run_h = (r.get("med_run") or r["hours"] * 3600) / 3600.0
        if r["slots_now"] > 0:
            r["conc"] = r["slots_now"] + (r.get("mine_run") or 0)   # what starts now + what I already hold
            r["wait0"] = 0
        else:
            # nothing starts now: my running jobs show the concurrency this site gives me
            # (fair share keeps it roughly steady as they finish and mine queue in behind)
            r["conc"] = max(1, r.get("mine_run") or 0)
            ahead = r.get("mine_q") or 0
            r["wait0"] = r["wait_now"] + (ahead / float(r["conc"])) * run_h * 3600
            r["stalled"] = bool(ahead and not r.get("mine_run") and (r.get("fit") or 0) > 0)
    def finish(r, k):
        if k == 0:
            return 0.0
        return r["wait0"] / 3600.0 + r["hours"] * -(-k // r["conc"])
    plan, waits = {}, {}
    for _ in range(max(1, groups)):
        if not cand:
            break
        cand.sort(key=lambda r: (finish(r, r["k"] + per_group), -r["slots_now"], r["site"]))
        best = cand[0]
        best["k"] += per_group
        plan[best["site"]] = plan.get(best["site"], 0) + 1
    detail = {}
    for r in cand:
        if r["k"]:
            over = max(0, r["k"] - r["cap_left"]) if r.get("cap_left") is not None else 0
            detail[r["site"]] = {"groups": plan[r["site"]], "jobs": r["k"], "finish_h": finish(r, r["k"]),
                                 "over_cap": over, "conc": r["conc"], "wait0_s": r["wait0"],
                                 "stalled": r.get("stalled", False), "ahead": r.get("mine_q") or 0}
    return plan, detail


def record_placement(project, plan, rows, detail=None, req=None, unit="job"):
    """What `site pick` decided, as a quota per site (in groups). The repos'
    placement_guard.sh hook spends one unit per named submission (`site submit <site>`
    or a `site run ... sweep_manager.py submit`) and refuses beyond it, for 60 min."""
    d = os.path.join(HOME, "placement")
    os.makedirs(d, exist_ok=True)
    first = max(plan.items(), key=lambda kv: kv[1])[0] if plan else None
    with open(os.path.join(d, project + ".json"), "w") as f:
        json.dump({"project": project, "site": first, "quota": plan, "unit": unit, "req": req,
                   "detail": detail or {}, "ts": int(time.time()),
                   "rows": [{"site": r["site"], "state": r["state"], "slots_now": r.get("slots_now"),
                             "wait_now": r.get("wait_now"), "reason": r.get("reason")} for r in rows]}, f)


UNFIT_TTL = 3600


def record_unfit(project, rows):
    """When a pick finds that its request fits on NO allowed site, now (0 fit everywhere) or ever (no node has the
    memory), record it: `site submit` then refuses a job asking that much (it would sit pending where `site pick`
    says "0 fit"). A request at or below the site's default memory is never blocked
    by a full cluster: only a request larger than the default, or one no node can ever hold. Returns the warning."""
    up = [r for r in rows if r.get("state") == "UP" and r.get("req")]
    f = os.path.join(HOME, "placement", project + ".unfit.json")
    if not up:
        return None
    never = all(r.get("fit_ever") == 0 for r in up)
    pr = project_of(project)
    big = all(r["req"]["mem_mb"] > make_request(pr, r["site"])["mem_mb"] for r in up)
    if not (never or (big and all((r.get("fit") or 0) == 0 for r in up))):
        if os.path.exists(f):
            try:
                d = json.load(open(f))
                if d.get("mem_mb", 0) <= min(r["req"]["mem_mb"] for r in up):
                    os.remove(f)               # a request this large (or larger) fits somewhere again
            except (OSError, ValueError):
                pass
        return None
    req = up[0]["req"]
    msg = ("%s/%dcpu %s on every allowed site (%s)" % (
        req["mem"], req["cpus"], "can NEVER run: no node has that much memory" if never else "fits NOWHERE now",
        "; ".join("%s: %s fit now, %s GPUs on nodes that could ever hold it" % (
            r["site"], r.get("fit"), "?" if r.get("fit_ever") is None else r.get("fit_ever")) for r in up)))
    os.makedirs(os.path.dirname(f), exist_ok=True)
    json.dump({"ts": int(time.time()), "mem_mb": min(r["req"]["mem_mb"] for r in up), "never": never,
               "msg": msg}, open(f, "w"))
    return msg


def unfit_refusal(project, mem_mb):
    """Why `site submit` refuses a job asking `mem_mb` (None: it may go)."""
    f = os.path.join(HOME, "placement", project + ".unfit.json")
    try:
        d = json.load(open(f))
    except (OSError, ValueError):
        return None
    if time.time() - d.get("ts", 0) > UNFIT_TTL or not mem_mb or mem_mb < d.get("mem_mb", 1 << 60):
        return None
    return "the last `site pick` (%d min ago) found %s" % ((time.time() - d["ts"]) // 60, d.get("msg"))


def rank_sites(project, allow_scarce=False, only=None, timeout=120, req=None):
    pr = project_of(project)
    sites = cfg_sites().get("sites", {})
    from concurrent.futures import ThreadPoolExecutor
    todo = [(name, sc) for name, sc in sorted(sites.items()) if not (only and name not in only)]
    def one(ns):
        name, sc = ns
        r = req if isinstance(req, dict) and "mem_mb" in req else make_request(pr, name, **(req or {}))
        return probe_site(sc, pr, project, name, r, timeout=max(timeout, int(sc.get("probe_timeout", 0))))  # a slow site's own floor
    with ThreadPoolExecutor(max_workers=max(1, len(todo))) as ex:
        probed = list(ex.map(one, todo))
    rows = []
    for (name, sc), r in zip(todo, probed):
        r["scarce"] = sc.get("budget") == "scarce"
        if r["scarce"] and r["state"] == "UP" and not allow_scarce:
            r["state"] = "HELD"
            r["reason"] += " -- hours limited: not picked unless asked (--allow-scarce)"
        rows.append(r)
    up = [r for r in rows if r["state"] == "UP"]
    up.sort(key=lambda r: (r["wait_now"], -r["slots_now"], r["site"]))
    return rows, (up[0]["site"] if up else None)


def cmd_pick(a):
    jobs = max(1, int(a.jobs or 1))
    groups = int(a.groups) if a.groups else jobs
    if groups < 1 or jobs % groups:
        die("--groups must divide --jobs (%d jobs, %d groups)" % (jobs, groups))
    per_group = jobs // groups
    reqspec = {"gpus": a.gpus, "mem": a.mem, "cpus": a.cpus, "hours": a.hours,
               "gpu_min_mem": getattr(a, "gpu_min_mem", None)}
    rows, best = rank_sites(a.project, a.allow_scarce, a.only, timeout=a.timeout, req=reqspec)
    plan, detail = plan_batch(rows, groups, per_group, a.hours, a.allow_scarce)
    unit = "sweep" if groups != jobs else "job"
    if not getattr(a, "no_record", False):       # drive.py's re-pick reads the model only: other agents' quotas stay
        record_placement(a.project, plan, rows, detail, {"jobs": jobs, "groups": groups, **reqspec}, unit)
    if a.json:
        print(json.dumps({"rows": rows, "pick": best, "plan": plan, "detail": detail}, indent=1, default=str))
        return
    for r in rows:
        print("  %-9s %-7s %s" % (r["site"], r["state"], r["reason"]))
        if r.get("skip"):
            print("  %-9s %-7s NOT ALLOTTED any work: %s" % (r["site"], "", r["skip"]))
    unfit = record_unfit(a.project, rows)
    if unfit:
        print("  " + "!" * 100)
        print("  WARNING: %s" % unfit)
        print("  `site submit` of a job asking this much memory is refused for the next hour unless --allow-unfit")
        print("  " + "!" * 100)
    if not plan:
        print("  pick: none (no site is up, deployed and allowed)")
        raise SystemExit(1)
    up = [r for r in rows if r["state"] == "UP"]
    req = up[0]["req"] if up else {}
    what = ("1 job" if jobs == 1 else
            "%d jobs" % jobs if groups == jobs else "%d groups x %d jobs" % (groups, per_group))
    print("  plan: %s, %d GPU, %s, %d cpu, ~%s each" % (
        what, req.get("gpus", 1), req.get("mem", "?"), req.get("cpus", 0),
        ("%.1f h" % a.hours) if a.hours else "my median run time"))
    tmax = 0.0
    for site, dt in sorted(detail.items(), key=lambda kv: -kv[1]["jobs"]):
        tmax = max(tmax, dt["finish_h"])
        extra = ""
        if dt["over_cap"]:
            extra += "  (%d over the submit cap: the submitter must add them as the queue drains)" % dt["over_cap"]
        if dt["wait0_s"]:
            extra += "  (first start ~%s%s)" % (_fmt_wait(dt["wait0_s"]),
                                              (", %d of mine already queued ahead" % dt["ahead"]) if dt["ahead"] else "")
        if dt["stalled"]:
            extra += "  WARNING: my queued jobs there are not starting although slots are free"
        print("    %-9s %3d %-6s %4d job%s  %2d at once   done in ~%.1f h%s" % (
            site, dt["groups"], unit + ("s" if dt["groups"] != 1 else ""), dt["jobs"], "s" if dt["jobs"] != 1 else " ",
            dt["conc"], dt["finish_h"], extra))
    if len(detail) > 1 or jobs > 1:
        print("    batch done in ~%.1f h" % tmax)
    if jobs == 1:
        print("  pick: %s" % max(plan.items(), key=lambda kv: kv[1])[0])
    held = [r for r in rows if r["state"] == "HELD"]
    if held and any(dt["over_cap"] or dt["wait0_s"] for dt in detail.values()):
        print("  note: scarce sites are held (hours); --allow-scarce adds them, roughly %.0f GPU-hours for this batch"
              % (jobs * (a.hours or 1.0)))


def login_guard(a, pr, cmd, cap):
    """Some sites (CC-IN2P3's user support) say their login nodes are not for non-interactive scripts. On a site with
    `login_cap` (sites.toml), a script (python/bash/sh FILE) runs there only when the project lists it in
    `login_scripts` (submitters and queue reads, with the caller's timeout); anything else is a short read, cut at
    `login_cap` seconds on the site itself. Longer work: `site run --job`. Returns the command to send."""
    scripts = re.findall(r"\b(?:python3?|bash|sh)\s+([^-\s;|&<>][^\s;|&<>]*\.(?:py|sh))(?![\w.])", cmd)
    bad = [s for s in scripts if not any(fnmatch.fnmatchcase(s, g) for g in pr.get("login_scripts", []))]
    if bad:
        die("site run: %s on %s's login node is a script (%s), and this site allows only submit/query commands and "
            "reads of under %d s there; run it as a CPU job: site run --job %s %s -- <command> (again to read its "
            "output), or add it to login_scripts in projects.toml if it only submits or queries"
            % (cmd[:120], a.site, ", ".join(bad), cap, a.site, a.project))
    if scripts:
        return cmd
    a.timeout = min(a.timeout, cap + 30)
    return "timeout -k 5 %d bash -c %s" % (cap, shlex.quote(cmd))


JOB_NONE = 75   # EX_TEMPFAIL, as LAUNCH_DEFER: no finished result to read yet (the supervisor's maintain skips it)


def run_as_job(a, sc, pr, inner, cmd):
    """`site run --job`: the command as a CPU job on the site's cpu partition (the project's sites.yaml `cpu` block),
    keyed by project + command. A call reads the finished result of the last job once (its output and exit code
    become this call's) and submits a new job when none is queued and none was just read; --recurring submits the next
    one in the same call as the read (the supervisor's maintain: each pass reads the job the previous pass started).
    With nothing to read it prints CCJ_NO_RESULT and exits 75. State on the site in ~/.ccorch/jobs/<key>.*"""
    if sc.get("scheduler") != "slurm":
        die("site run --job: %s is not a Slurm site" % a.site)
    import base64, hashlib
    key = hashlib.sha1(("%s\0%s" % (a.project, cmd)).encode()).hexdigest()[:12]
    t = max(60, a.timeout)
    script = ("#!/bin/bash\n# site run --job %s: %s\n"
              "for v in $(compgen -e | grep -E '^(SLURM|SBATCH)_'); do unset $v; done   # a nested sbatch inherits none\n"
              "j=$HOME/.ccorch/jobs/%s\ntimeout -k 30 %d bash -c %s > $j.out.tmp 2>&1; rc=$?\n"
              "mv -f $j.out.tmp $j.out; echo $rc > $j.rc\n") % (key, cmd[:200].replace("\n", " "), key, t,
                                                                shlex.quote(inner))
    flags = " ".join(shlex.quote(f) for f in site_flags(merge_site(sc, pr, a.site), {}))
    remote = ("d=$HOME/.ccorch/jobs; mkdir -p $d; j=$d/{k}; got=; "
              "if [ -f $j.rc ]; then echo \"CCJ_RESULT $(cat $j.rc) $(date -r $j.rc '+%F %T')\"; cat $j.out; "
              "mv -f $j.rc $j.rc.read; got=1; fi; "
              "q=$(squeue -h -u $USER -n ccj_{k} -o '%i %T %M' 2>&1); "
              "if [ -n \"$q\" ]; then echo \"CCJ_PENDING $q\"; "
              "elif [ -z \"$got\" ] || [ {r} = 1 ]; then echo {b} | base64 -d > $j.sh; "
              "echo \"CCJ_SUBMITTED $(sbatch --parsable -J ccj_{k} {f} -c 1 -t {m} -o $j.log $j.sh 2>&1)\"; fi"
              ).format(k=key, r=int(bool(a.recurring)), b=base64.b64encode(_rd(script).encode()).decode(), f=flags,
                       m=t // 60 + 5)
    rc, out = run_ssh(sc, remote, timeout=120)
    if rc:
        die("site run --job: %s did not answer (exit %d): %s" % (a.site, rc, out.strip()[-300:]), rc)
    lines = out.splitlines()
    tail = [l for l in lines if l.startswith(("CCJ_PENDING ", "CCJ_SUBMITTED "))]
    res = next((i for i, l in enumerate(lines) if l.startswith("CCJ_RESULT ")), None)
    for l in tail:
        if l.startswith("CCJ_SUBMITTED ") and not re.match(r"CCJ_SUBMITTED \d+", l):
            die("site run --job: sbatch refused on %s: %s" % (a.site, l))
        print("  job ccj_%s: %s" % (key, "queued or running: " + l[12:] if l.startswith("CCJ_PENDING")
                                    else "submitted, job " + l[14:]))
    if res is None:
        print("CCJ_NO_RESULT: no finished result of `%s` on %s yet; the same command again reads it" % (cmd[:120], a.site))
        return JOB_NONE
    _, code, when = lines[res].split(" ", 2)
    body = "\n".join(l for l in lines[res + 1:] if l not in tail)
    print("  result of job ccj_%s (ended %s, exit %s):" % (key, when, code))
    body = record_gate(a.project, a.site, body + "\n") if ledger_on(a.project) else body + "\n"
    sys.stdout.write(body)
    return int(code)


def cmd_run(a):
    """One command on the site's login node, in the checkout, env activated."""
    pr = project_of(a.project)
    sc = site_of(a.site)
    remote_path = "%s/%s" % (sc["root"], pr.get("remote_name", a.project))
    args = a.cmd
    if args[:1] != ["--"] and args[:1] and args[0].startswith("--"):
        # options placed after <project> land in the REMAINDER: honour site run's own (and the global --timeout)
        # when a "--" follows them, refuse otherwise, never send them to the site as the command
        if "--" not in args:
            die("site run: %r before the command and no '--': write site run <site> <project> [options] -- <command>"
                % args[0])
        pre, args = args[:args.index("--")], args[args.index("--"):]
        op = argparse.ArgumentParser(prog="site run", add_help=False)
        op.add_argument("--timeout", type=int); op.add_argument("--quote", action="store_true")
        op.add_argument("--check", action="store_true"); op.add_argument("--item", action="append")
        op.add_argument("--allow-stale", action="store_true")
        op.add_argument("--job", action="store_true"); op.add_argument("--recurring", action="store_true")
        got, bad = op.parse_known_args(pre)
        if bad:
            die("site run: unknown option(s) %s before '--'" % " ".join(bad))
        a.timeout = got.timeout if got.timeout is not None else a.timeout
        a.quote = a.quote or got.quote; a.check = a.check or got.check
        a.allow_stale = a.allow_stale or got.allow_stale
        a.job = a.job or got.job; a.recurring = a.recurring or got.recurring
        a.item = (a.item or []) + (got.item or []) or None
    args = args[1:] if args[:1] == ["--"] else args
    cmd = " ".join(shlex.quote(c) for c in args) if a.quote else " ".join(args)
    if not cmd:
        die("nothing to run: site run <site> <project> -- <command...>")
    a.job = a.job or a.recurring
    if sc.get("login_cap") and not a.job:
        cmd = login_guard(a, pr, cmd, int(sc["login_cap"]))
    if ledger_on(a.project) and not a.item and any(re.search(p, cmd) for p in WORK_PATTERNS):
        die("this command starts work on %s: name its work item(s), --item <id> (repeatable; '*' = every active "
            "item of %s, for upkeep such as queue feeders)" % (a.site, a.project))
    # the project's own submitters read CCORCH_WORK and refuse anything outside the named active items or inside a
    # held one, whatever the command line looks like (siteconf.work_gate)
    # and whatever script ends up calling the scheduler (a project has many submit paths: resubmit helpers, staged
    # submitters, generators), it reaches sbatch / condor_submit through a wrapper that refuses when no item is named;
    # only for a project under the ledger, and never fatal to the command itself (a read-only `site run` must work
    # when the wrapper cannot be written, e.g. lxplus with a lapsed AFS token)
    # a command that names a work item is work: it may submit by any path (a generator's --auto-submit or config,
    # a launch script), so it needs the gate in place, whatever its words
    starts = bool(a.item) or any(re.search(p, cmd) for p in WORK_PATTERNS)
    if ledger_on(a.project):
        ensure_gate(sc)
    wrap = (SCHED_WRAP + "; " + (GATE_REQUIRED if starts else "") + GATE_TRAP) if ledger_on(a.project) else ""
    inner = ("cd %s && export CCORCH_SITE=%s CCORCH_PROJECT_DIR=%s CCORCH_WORK=%s && "
             "source sites/activate.sh && %s%s" % (shlex.quote(remote_path), a.site,
                                                   shlex.quote(remote_path),
                                                   shlex.quote(work_env(a.project, a.item, a.site)), wrap, cmd))
    if a.check:
        print(inner)
        return
    if a.item and ledger_on(a.project):
        check_not_stale(a, pr, sc)
    if a.job:
        rc = run_as_job(a, sc, pr, inner, cmd)
        if rc:
            sys.exit(rc)
        return
    print("  run %s:%s $ %s" % (a.site, remote_path, cmd))
    rc, out = run_ssh(sc, inner, timeout=a.timeout)
    out = record_gate(a.project, a.site, out) if ledger_on(a.project) else out
    sys.stdout.write(out if out.endswith("\n") or not out else out + "\n")
    if rc:
        die("command exited %d on %s" % (rc, a.site), rc)


# ------------------------------------------------------------------ ledger
# Two registers next to the run registry, for every project and every session, so neither lives in an agent's
# context (which gets summarised) and both are read by the tools that launch work:
#   decisions  every call the user makes (approve, hold, release, forbid, prefer, scope), with the user's exact words,
#              checked against the session transcripts, and what it covers
#   items      every piece of work started to run unattended (GPU jobs, CPU builds, copies, archives, smoke tests),
#              each authorised by a decision, with its scope, estimate, status (active | held | done), what it is
#              made of (`match`: names of its sweeps / runs) and a check command saying how much of it exists
# `site submit`, `site copy` and work launched by `site run` need an active item (--item); a hold blocks everything
# its items cover. `site supervise` watches every active item (gaps, overruns, readiness) and records events;
# `site events --wait` wakes the agent; a Stop hook (~/.claude/hooks/ledger_guard.sh) keeps a turn from ending
# while an event is open, the supervisor is dead, or no waiter is armed.
# Why: without it results sit unread for hours, idle jobs go unnoticed, holds are misapplied, scope changes unasked,
# and guards fail silently.
import fnmatch, glob as _glob

_RX = []


def _rx():
    """The supervisor's model-free half (run ends sorted without a model, approved queues resubmitted, collection,
    wall-time targets): ~/.local/bin/site_runends.py beside this script, used only for a project whose projects.toml
    `[projects.<P>.run_ends] enabled = true`."""
    if not _RX:
        import importlib.util
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "site_runends.py")
        spec = importlib.util.spec_from_file_location("site_runends", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _RX.append(mod)
    return _RX[0]


def _runends_on(pr):
    return bool(((pr or {}).get("run_ends") or {}).get("enabled"))

LEDGER_SCHEMA = """
CREATE TABLE IF NOT EXISTS decisions (
  id TEXT PRIMARY KEY, project TEXT, kind TEXT, quote TEXT, said_at TEXT, covers TEXT,
  note TEXT, recorded INTEGER, in_force INTEGER DEFAULT 1);
CREATE TABLE IF NOT EXISTS items (
  project TEXT, id TEXT, title TEXT, decision TEXT, scope TEXT, est_gpu_hours REAL,
  match TEXT, check_cmd TEXT, ready TEXT, notes TEXT, status TEXT,
  created INTEGER, updated INTEGER, progress TEXT, PRIMARY KEY (project, id));
CREATE TABLE IF NOT EXISTS events (
  id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER, project TEXT, item TEXT, kind TEXT,
  key TEXT, msg TEXT, acked INTEGER, ack_note TEXT, mute_until INTEGER);
CREATE TABLE IF NOT EXISTS gpu_window (
  ts INTEGER, project TEXT, site TEXT, items TEXT, gpu_h REAL, what TEXT);
CREATE TABLE IF NOT EXISTS launches (
  project TEXT, id TEXT, decision TEXT, item TEXT, ready_cmd TEXT, run_cmd TEXT, note TEXT, status TEXT,
  created INTEGER, checked INTEGER, ready_out TEXT, launched_at INTEGER, pid INTEGER, pid_start TEXT, log TEXT,
  rc INTEGER, msg TEXT, attempts INTEGER DEFAULT 0, PRIMARY KEY (project, id));
"""
DECISION_KINDS = ("approve", "hold", "release", "forbid", "prefer", "scope")
TRANSCRIPTS = os.path.expanduser("~/.claude/projects")
# user-role transcript entries that the user did not type
NOT_TYPED = ("<task-notification", "<agent-message", "goal check-in", "[system notification", "another claude session",
             "<local-command", "<command-name>", "<command-message>", "<system-reminder", "[request interrupted",
             "this session is being continued", "stop hook feedback")
SUPERVISE_INTERVAL = 1200


def heartbeat_file(project):
    """Per project: a supervisor or waiter of another project must not satisfy this one's guard."""
    return os.path.join(HOME, "supervisor.%s.heartbeat" % (project or "all"))


def waiter_file(project):
    return os.path.join(HOME, "events_waiter.%s.pid" % (project or "all"))
TERMINAL = ("COMPLETED", "FAILED", "CANCELLED", "TIMEOUT", "OUT_OF_MEMORY", "NODE_FAIL", "REMOVED", "BOOT_FAIL")
# commands that start work on a site: refused through `site run` without --item
WORK_PATTERNS = (r"\bsbatch\b", r"\bcondor_submit", r"sweep_manager\.py\s+submit", r"--submit\b", r"feed_capped\.py",
                 r"--release-trials")


# sh run on the site before a `site run` command: sbatch / condor_submit / condor_submit_dag on PATH become wrappers
# that refuse unless the command names a work item (CCORCH_WORK carries a non-empty "items")
_WRAP_BODY = ('#!/bin/sh\ncase "$CCORCH_WORK" in *\\"items\\":\\[\\"*) ;; *) echo "site: $(basename $0) refused: '
              'no work item named (site run --item <id> ...)" >&2; exit 1;; esac\n'
              'PATH=$(printf %s "$PATH" | sed "s#$HOME/.ccorch/bin:##"); export PATH\n'
              # the GPU budget (site_gate.py): every GPU job, whatever submits it
              'command -v python3 >/dev/null 2>&1 || { echo "site: $(basename $0) refused: no python3 for the GPU '
              'budget gate" >&2; exit 1; }\n'
              'exec python3 "$HOME/.ccorch/bin/ccorch_gate.py" "$(basename $0)" "$@"\n')


def _gate_body():
    """site_gate.py beside this script: written to the site as ~/.ccorch/bin/ccorch_gate.py with the wrappers. A
    missing file writes an empty gate, which fails every submission (closed, never open)."""
    try:
        with open(os.path.join(os.path.dirname(os.path.realpath(__file__)), "site_gate.py")) as f:
            return f.read()
    except OSError:
        return ""


GATE_LOG = "$HOME/.ccorch/gate.$$.jsonl"
# the gate's records of this command, printed at its end (whatever way it exits) for the laptop's ledger (gpu_window)
GATE_TRAP = ("export CCORCH_GATE_LOG=%s; trap '[ -s \"$CCORCH_GATE_LOG\" ] && sed \"s/^/CCORCH_GPU /\" "
             "\"$CCORCH_GATE_LOG\"; rm -f \"$CCORCH_GATE_LOG\"' EXIT; " % GATE_LOG)
# a command that submits must have the gate in place: the wrappers' write is never fatal to a read-only command, but a
# submission without them would bypass the item check and the budget
GATE_REQUIRED = ('{ [ -s $HOME/.ccorch/bin/ccorch_gate.py ] && [ -x $HOME/.ccorch/bin/sbatch ] && '
                 'case ":$PATH:" in *":$HOME/.ccorch/bin:"*) true;; *) false;; esac; } || '
                 '{ echo "site: the submission gate (~/.ccorch/bin) could not be installed here; nothing submitted" >&2; '
                 'exit 1; }; ')
# written to a temp file and moved into place, so a concurrent sbatch never runs a half-written wrapper
def _zb64(text):
    """gzip+base64 of a script body, so the one-line remote command stays short (Jean Zay's login hangs on ~27 KB)"""
    import base64, gzip
    return shlex.quote(base64.b64encode(gzip.compress(text.encode(), 9, mtime=0)).decode())


SCHED_WRAP_FULL = ("{ mkdir -p $HOME/.ccorch/bin && printf %s " + _zb64(_rd(_gate_body())) +
              " | base64 -d | gunzip > $HOME/.ccorch/bin/.ccorch_gate.py.$$ && mv -f $HOME/.ccorch/bin/.ccorch_gate.py.$$ "
              "$HOME/.ccorch/bin/ccorch_gate.py && for _c in sbatch condor_submit condor_submit_dag; do printf %s "
              + _zb64(_rd(_WRAP_BODY)) + " | base64 -d | gunzip > $HOME/.ccorch/bin/.$_c.$$ && chmod 755 $HOME/.ccorch/bin/.$_c.$$ && "
              "mv -f $HOME/.ccorch/bin/.$_c.$$ $HOME/.ccorch/bin/$_c; done && "
              "export PATH=$HOME/.ccorch/bin:$PATH; } 2>/dev/null")


_GATE_STAMP = "g" + __import__("hashlib").sha1((_gate_body() + _WRAP_BODY).encode()).hexdigest()[:12]
# per-command text: only the PATH; the wrappers themselves are installed by ensure_gate, once, through stdin (a 12-27 KB
# command line hangs Jean Zay's login)
SCHED_WRAP = "{ export PATH=$HOME/.ccorch/bin:$PATH; } 2>/dev/null"
_GATE_DONE = set()


def ensure_gate(sc):
    """install the submission wrappers on the site if its stamp is missing or stale; never fatal (GATE_REQUIRED
    refuses a submission without them)"""
    key = sc.get("ssh")
    if key in _GATE_DONE:
        return
    _GATE_DONE.add(key)
    try:
        rc, out = run_ssh(sc, "[ -f $HOME/.ccorch/bin/.%s ] && echo GATE_OK" % _GATE_STAMP, timeout=60)
        if "GATE_OK" in out:
            return
        # the ssh path to Jean Zay stalls on any upload above ~1.4 KB (1300 B ok, 1500 B hangs, both
        # as a command line and as stdin): the installer goes up gzip+base64 in 900-byte pieces
        import base64, gzip
        blob = base64.b64encode(gzip.compress((SCHED_WRAP_FULL + "\n").encode(), 9, mtime=0)).decode()
        part = "$HOME/.ccorch/.gate_inst.b64"
        run_ssh(sc, "mkdir -p $HOME/.ccorch/bin; : > %s" % part, timeout=60)
        for k in range(0, len(blob), 900):
            run_ssh(sc, "printf %%s %s >> %s" % (blob[k:k + 900], part), timeout=60)
        run_ssh(sc, "base64 -d %s | gunzip | bash && touch $HOME/.ccorch/bin/.%s; rm -f %s" % (part, _GATE_STAMP, part),
                timeout=60)
    except Exception:
        pass


def record_gate(project, site, out):
    """the gate's CCORCH_GPU lines of a command's output into the ledger's gpu_window (the other sites' share of an
    item's last 60 min, sent with the next command); returns the output without them, and prints one line per
    record."""
    keep, recs = [], []
    for line in out.splitlines(True):
        if line.startswith("CCORCH_GPU "):
            try:
                recs.append(json.loads(line[len("CCORCH_GPU "):]))
            except ValueError:
                pass
        else:
            keep.append(line)
    if recs:
        c = ldb()
        for r in recs:
            c.execute("INSERT INTO gpu_window (ts,project,site,items,gpu_h,what) VALUES (?,?,?,?,?,?)",
                      (int(r.get("t") or time.time()), r.get("project") or project, r.get("site") or site,
                       json.dumps(r.get("items") or []), float(r.get("gpu_h") or 0.0), r.get("what")))
        c.commit()
        for r in recs:
            print("  gate: %s %.1f GPU-h for %s (%s)" % (r.get("site") or site, float(r.get("gpu_h") or 0.0),
                                                       ",".join(r.get("items") or []), r.get("what")))
    return "".join(keep)


def ldb():
    c = db()
    c.executescript(LEDGER_SCHEMA)
    if "item" not in [r[1] for r in c.execute("PRAGMA table_info(runs)")]:
        try:
            c.execute("ALTER TABLE runs ADD COLUMN item TEXT")
        except sqlite3.OperationalError:              # another process added it first
            pass
    have = [r[1] for r in c.execute("PRAGMA table_info(runs)")]
    # setup checks: what a submission expected of its RUN_SUMMARY line, what the line said, the verdict
    for col in ("expect TEXT", "summary TEXT", "summary_state TEXT", "running_seen INTEGER", "launch TEXT"):
        if col.split()[0] not in have:
            try:
                c.execute("ALTER TABLE runs ADD COLUMN " + col)
            except sqlite3.OperationalError:
                pass
    if "expect" not in [r[1] for r in c.execute("PRAGMA table_info(launches)")]:
        try:
            c.execute("ALTER TABLE launches ADD COLUMN expect TEXT")
        except sqlite3.OperationalError:
            pass
    if "waiting" not in [r[1] for r in c.execute("PRAGMA table_info(items)")]:
        try:
            # what an active item with nothing running waits on (an item whose runs have all ended
            # must not count as live forever)
            c.execute("ALTER TABLE items ADD COLUMN waiting TEXT")
        except sqlite3.OperationalError:
            pass
    if "tell" not in [r[1] for r in c.execute("PRAGMA table_info(events)")]:
        try:
            # what an ack means for the user: finding (a result), needs-user (a call only they can make), routine
            # (fixed or explained, nothing to tell); `site digest` reports by it (a stream of routine acks is
            # unreadable after an absence)
            c.execute("ALTER TABLE events ADD COLUMN tell TEXT")
        except sqlite3.OperationalError:
            pass
    return c


def _norm(s):
    return re.sub(r"\s+", " ", s or "").strip().lower()


def _typed_texts(d):
    """The texts of one transcript entry that the user typed: a prompt, or a message queued mid-turn."""
    if d.get("type") == "queue-operation" and d.get("operation") == "enqueue":
        out = [d.get("content")] if isinstance(d.get("content"), str) else []
    elif d.get("type") == "system" and d.get("subtype") == "local_command":
        # a slash command typed by the user (/goal ...) is logged as a system entry: only its arguments count
        c = d.get("content") if isinstance(d.get("content"), str) else ""
        return re.findall(r"<command-args>(.*?)</command-args>", c, re.S)
    elif d.get("type") == "attachment" and (d.get("attachment") or {}).get("type") == "queued_command":
        # a message typed mid-turn and absorbed into the turn (string or content-block list)
        p = d["attachment"].get("prompt")
        out = [p] if isinstance(p, str) else [x.get("text", "") for x in (p or [])
                                              if isinstance(x, dict) and x.get("type") == "text"]
    elif d.get("type") == "user" and not d.get("isMeta") and not d.get("isSidechain"):
        c = (d.get("message") or {}).get("content")
        out = [c] if isinstance(c, str) else [x.get("text", "") for x in (c or [])
                                               if isinstance(x, dict) and x.get("type") == "text"]
    else:
        return []
    # a slash command the user typed (/goal ...): its arguments are the user's words
    args = [m for t in out if t for m in re.findall(r"<command-args>(.*?)</command-args>", t, re.S)]
    return [t for t in out if t and not _norm(t).startswith(NOT_TYPED)] + args


def _interactive(path):
    """True for a session the user typed into (entrypoint "cli"); a headless `claude -p` / SDK run ("sdk-cli") carries
    prompts a script wrote, which are not the user's words."""
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                m = re.search(r'"entrypoint":"([^"]+)"', line)
                if m:
                    return m.group(1) == "cli"
    except OSError:
        pass
    return False


def user_said(quote, project=None, days=30):
    """Timestamps at which the user typed `quote` (whitespace and case folded) in an interactive session of
    `project` (its checkout and the worktrees under it) over the last `days` days. Messages queued mid-turn count:
    a search that reads prompts only misses approvals sent mid-turn."""
    q = _norm(quote)
    words = sorted(re.findall(r"[a-z0-9]{4,}", q), key=len, reverse=True)
    # a short quote ("Yes, fix that") identifies a message only as the whole of it: it must equal one message the user
    # typed, never a fragment of a longer one
    whole = len(q) < 12 or len(words) < 2
    if whole:
        words = sorted(re.findall(r"[a-z0-9]+", q), key=len, reverse=True)
        if not words:
            die("the quote has no words")
    bare = lambda s: re.sub(r"[\s.!?]+$", "", s)
    # a whole answer is the whole message or one whole line of it, its list marker ("3.", "b)", "-") dropped: a short
    # answer to item 3 of a list is a decision
    marker = re.compile(r"^\s*(?:[-*\u2022]|\(?[0-9a-z]{1,3}[.)\]:])\s+")
    # several answers on one line ("a) yes b) no") are split at their inline markers
    inline = re.compile(r"\s\(?[0-9a-z]{1,2}\)\s")
    answers = lambda t: [bare(_norm(t))] + [bare(_norm(marker.sub("", part))) for ln in t.splitlines() if ln.strip()
                                            for part in [ln] + inline.split(" " + ln)[1:] if part.strip()]
    slug = None
    if project:
        slug = re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(os.path.expanduser(project_of(project)["local"])))
    hits = []
    for f in _glob.glob(os.path.join(TRANSCRIPTS, "*", "*.jsonl")):
        if slug and not os.path.basename(os.path.dirname(f)).startswith(slug):
            continue
        if time.time() - os.path.getmtime(f) > days * 86400 or not _interactive(f):
            continue
        with open(f, errors="replace") as fh:
            for line in fh:
                if words[0] not in line.lower():
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                if any((bare(_norm(marker.sub("", q))) in answers(t)) if whole else (q in _norm(t)) for t in _typed_texts(d)):
                    hits.append(d.get("timestamp") or "?")
    return sorted(set(hits))


def _items(c, project=None, status=None):
    q, p = "SELECT project,id,title,decision,scope,est_gpu_hours,match,check_cmd,ready,notes,status,created,updated," \
           "progress FROM items", []
    w = []
    if project:
        w.append("project=?"); p.append(project)
    if status:
        w.append("status IN (%s)" % ",".join("?" * len(status))); p += list(status)
    keys = ("project", "id", "title", "decision", "scope", "est_gpu_hours", "match", "check_cmd", "ready", "notes",
            "status", "created", "updated", "progress")
    return [dict(zip(keys, r)) for r in c.execute(q + (" WHERE " + " AND ".join(w) if w else "") + " ORDER BY created", p)]


def _globs(it):
    return [g for g in (it.get("match") or "").split(",") if g]


def ledger_on(project):
    """Enforcement is per project, switched on in projects.toml (`ledger = true`): a project whose sessions do not
    yet register their work keeps working as before."""
    return bool(cfg_projects().get(project, {}).get("ledger"))


def resolve_items(project, specs, verb):
    """Items named by --item for work in `project`: every one must exist and be active; '*' = all active items.
    Returns (ids, active globs, held globs)."""
    if not ledger_on(project):
        return sorted({s for s in specs or [] if s}), [], []
    c = ldb()
    allv = {i["id"]: i for i in _items(c, project)}
    held = [g for i in allv.values() if i["status"] == "held" for g in _globs(i)]
    ids = []
    for s in specs or []:
        if s == "*":
            ids += [k for k, i in allv.items() if i["status"] == "active"]
            continue
        i = allv.get(s)
        if not i:
            die("no work item %r in %s. Work is registered first: `site item add %s <id> --decision D...` "
                "(the decision with the user's words: `site decide`)" % (s, project, project))
        if i["status"] != "active":
            by = c.execute("SELECT id,quote FROM decisions WHERE project=? AND kind='hold' AND in_force=1 AND "
                           "(','||covers||',') LIKE ? ORDER BY recorded DESC", (project, "%," + s + ",%")).fetchone()
            die("work item %s/%s is %s%s; %s refused" % (project, s, i["status"],
                                                          (" (by %s: \"%s\")" % by) if by else "", verb))
        ids.append(s)
    act = [g for k in ids for g in _globs(allv[k])]
    return sorted(set(ids)), act, held


GATE_WINDOW_S = 3600


def _drop_unstarted(c, project, prior):
    """prior [items, gpu_h, ts, site] without the records of jobs cancelled/removed before they ever ran (a trial moved
    to another site is cancelled pending: it used no GPU). A record is matched 1:1 to the nearest registry run of its
    site submitted within 8 s after it; no match or a run seen running counts. shortcut: gpu_window has no job id."""
    runs = c.execute("SELECT site, submitted, state, running_seen FROM runs WHERE project=? AND submitted>=?",
                     (project, int(time.time()) - GATE_WINDOW_S - 60)).fetchall()
    taken, out = set(), []
    for r in sorted(prior, key=lambda r: r[2]):
        cand = [(abs(x[1] - r[2]), k) for k, x in enumerate(runs)
                if k not in taken and x[0] == r[3] and -1 <= x[1] - r[2] <= 8]
        if cand:
            k = min(cand)[1]
            taken.add(k)
            _, _, st, seen = runs[k]
            if not seen and st and (st.startswith("CANCELLED") or st == "REMOVED"):
                continue
        out.append(r[:2])
    return out


def work_env(project, specs, site=None):
    """CCORCH_WORK: the named items and their globs, and for the site's submission gate (site_gate.py) the GPU budget:
    the cap (30 GPU-h per item in 60 min, 10 on a scarce site), each item's recorded estimate and its GPU-h submitted
    on the other sites in the window."""
    ids, act, held = resolve_items(project, specs, "work")
    w = {"items": ids, "active": act, "held": held}
    if site and ledger_on(project):
        c = ldb()
        its = {i["id"]: i for i in _items(c, project) if i["id"] in ids}
        est = {k: i["est_gpu_hours"] for k, i in its.items()}
        globs = {k: _globs(i) for k, i in its.items()}
        prior = []                  # the other sites' records sharing a named item, each once: [items, GPU-h]
        for items, h, ts, rsite in c.execute("SELECT items, gpu_h, ts, site FROM gpu_window WHERE project=? AND site!=? AND ts>=?",
                                  (project, site, int(time.time()) - GATE_WINDOW_S)):
            r = json.loads(items or "[]")
            if set(r) & set(ids):
                prior.append([r, h or 0.0, ts, rsite])
        prior = _drop_unstarted(c, project, prior)
        w["budget"] = {"project": project, "site": site, "cap": float(policy(project)["gpu_cap_h"]), "cap_scarce": float(policy(project)["gpu_cap_scarce_h"]),
                       "scarce": site_of(site).get("budget") == "scarce", "est": est, "globs": globs,
                       "prior_records": prior}
    return json.dumps(w, separators=(",", ":"))


def cmd_decide(a):
    if a.kind not in DECISION_KINDS:
        die("kind is one of %s" % ", ".join(DECISION_KINDS))
    project_of(a.project)
    hits = user_said(a.quote, a.project)
    if not hits:
        die("these words are not in any message the user typed (transcripts of the last 30 days, mid-turn messages "
            "included). Quote the user exactly; a decision is never recorded from the agent's own paraphrase.")
    c = ldb()
    covers = [x.strip() for x in (a.covers or "").split(",") if x.strip()]
    items = {i["id"]: i for i in _items(c, a.project)}
    if a.kind in ("hold", "release"):
        hit = sorted({k for g in covers for k in items if fnmatch.fnmatchcase(k, g)})
        if not hit:
            die("a %s names the work items it covers (--covers id,glob...); none of %s matches an item of %s: %s"
                % (a.kind, covers, a.project, ", ".join(sorted(items)) or "none"))
        covers = hit
    n = max([int(r[0][1:]) for r in c.execute("SELECT id FROM decisions") if r[0][1:].isdigit()] or [0]) + 1  # next free id, deletions leave gaps
    did = "D%d" % n
    c.execute("INSERT INTO decisions VALUES (?,?,?,?,?,?,?,?,1)",
              (did, a.project, a.kind, a.quote, hits[-1], ",".join(covers), a.note, int(time.time())))
    now = int(time.time())
    if a.kind in ("hold", "release"):
        new = "held" if a.kind == "hold" else "active"
        # a hold and a release of the same item cancel: the older one stops covering it, and is no longer in force
        # once it covers nothing
        other = "release" if a.kind == "hold" else "hold"
        for oid, ocov in c.execute("SELECT id,covers FROM decisions WHERE project=? AND kind=? AND in_force=1",
                                   (a.project, other)).fetchall():
            left = [k for k in (ocov or "").split(",") if k and k not in covers]
            c.execute("UPDATE decisions SET covers=?, in_force=? WHERE id=?", (",".join(left), 1 if left else 0, oid))
        for k in covers:
            c.execute("UPDATE items SET status=?, updated=? WHERE project=? AND id=? AND status!='done'",
                      (new, now, a.project, k))
    for old in (a.supersedes or "").split(","):
        if old.strip():
            c.execute("UPDATE decisions SET in_force=0 WHERE id=?", (old.strip(),))
            # a superseded hold stops holding: its items go active unless another hold in force still covers them
            r = c.execute("SELECT project,kind,covers FROM decisions WHERE id=?", (old.strip(),)).fetchone()
            if r and r[1] == "hold":
                still = {k for (cv,) in c.execute("SELECT covers FROM decisions WHERE project=? AND kind='hold' AND in_force=1",
                                                  (r[0],)) for k in (cv or "").split(",")}
                for k in (r[2] or "").split(","):
                    if k and k not in still:
                        c.execute("UPDATE items SET status='active', updated=? WHERE project=? AND id=? AND status='held'",
                                  (now, r[0], k))
    c.commit()
    print("  %s  %s/%s  said %s: \"%s\"" % (did, a.project, a.kind, hits[-1][:16], a.quote))
    if covers:
        print("  covers: %s" % ", ".join(covers))
    if a.kind in ("hold", "release"):
        print("  -> %s now %s. Tell the user this exact list." % (", ".join(covers),
                                                                  "held" if a.kind == "hold" else "active"))


def cmd_undecide(a):
    """Delete decisions the user said should not be there (e.g. a complaint recorded as a
    decision); --supersedes on a new decision is for one that replaces an old one. Soft: the rows leave
    the decisions in force and `site decisions`, and stay under --all marked (deleted) with the words that asked."""
    project_of(a.project)
    if not user_said(a.quote, a.project):
        die("these words are not in any message the user typed: a decision is deleted only on the user's own words")
    c = ldb()
    ids = [x.strip() for x in a.ids.split(",") if x.strip()]
    rows = [c.execute("SELECT id,kind,quote FROM decisions WHERE id=? AND project=?", (i, a.project)).fetchone()
            for i in ids]
    if not all(rows):
        die("no decision %s of %s" % (", ".join(i for i, r in zip(ids, rows) if not r), a.project))
    for did, kind, quote in rows:      # printed before the change: the record of what goes
        print("  deleted %s %s \"%s\"" % (did, kind, quote[:120]))
    # soft delete: out of force and of `site decisions`, kept under --all with who asked
    for i in ids:
        c.execute("UPDATE decisions SET in_force=0, note=? WHERE id=? AND project=?",
                  ("deleted %s on: %s" % (time.strftime("%Y-%m-%dT%H:%M"), a.quote[:300]), i, a.project))
    c.commit()


def cmd_decisions(a):
    c = ldb()
    q = "SELECT id,project,kind,said_at,quote,covers,note,in_force FROM decisions"
    w, p = [], []
    if a.project:
        w.append("project=?"); p.append(a.project)
    if not a.all:
        w.append("in_force=1")
    for did, proj, kind, at, quote, covers, note, inf in c.execute(
            q + (" WHERE " + " AND ".join(w) if w else "") + " ORDER BY recorded", p):
        print("  %-4s %-8s %-8s %s%s  \"%s\"%s%s" % (did, proj, kind, (at or "")[:16], "" if inf else (" (deleted)" if (note or "").startswith("deleted ") else " (superseded)"),
                                                  quote, "  covers: " + covers if covers else "",
                                                  "  [" + note + "]" if note else ""))


def cmd_item(a):
    c = ldb()
    project_of(a.project)
    now = int(time.time())
    if a.action == "add":
        d = c.execute("SELECT kind,in_force FROM decisions WHERE id=? AND project=?",
                      (a.decision or "", a.project)).fetchone()
        if not d or not d[1] or d[0] not in ("approve", "scope", "release"):
            die("an item needs a decision in force that approves it (--decision D<n>, kind approve/scope): record the "
                "user's words with `site decide %s --kind approve --quote ...` first" % a.project)
        if not a.scope:
            die("--scope: what runs, how many, how long, written out (the user reads it)")
        if c.execute("SELECT 1 FROM items WHERE project=? AND id=?", (a.project, a.id)).fetchone():
            die("item %s/%s exists (site item set ...)" % (a.project, a.id))
        c.execute("INSERT INTO items (project,id,title,decision,scope,est_gpu_hours,match,check_cmd,ready,notes,status,"
                  "created,updated,progress) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                  (a.project, a.id, a.title or a.id, a.decision, a.scope, a.est_gpu_hours, a.match or "",
                   a.check or "", a.ready or "0.5,1", a.notes or "", "active", now, now, ""))
        c.commit()
        print("  item %s/%s active, under %s" % (a.project, a.id, a.decision))
        return
    it = c.execute("SELECT status FROM items WHERE project=? AND id=?", (a.project, a.id)).fetchone()
    if not it:
        die("no item %s/%s" % (a.project, a.id))
    if a.action == "done":
        c.execute("UPDATE items SET status='done', updated=? WHERE project=? AND id=?", (now, a.project, a.id))
    elif a.action == "set":
        if a.waiting is not None:
            c.execute("UPDATE items SET waiting=?, updated=? WHERE project=? AND id=?",
                      (a.waiting.strip() or None, now, a.project, a.id))
        for col, v in (("title", a.title), ("scope", a.scope), ("est_gpu_hours", a.est_gpu_hours),
                       ("match", a.match), ("check_cmd", a.check), ("ready", a.ready), ("notes", a.notes)):
            if v is not None:
                c.execute("UPDATE items SET %s=?, updated=? WHERE project=? AND id=?" % col, (v, now, a.project, a.id))
    c.commit()
    print("  item %s/%s updated" % (a.project, a.id))


def cmd_items(a):
    c = ldb()
    st = None if a.all else ("active", "held")
    for i in _items(c, a.project, st):
        pr = json.loads(i["progress"]) if i["progress"] else {}
        prog = ("%d/%d" % (pr.get("done", 0), pr.get("expected", 0))) if pr.get("expected") else "-"
        print("  %-8s %-26s %-7s %-8s %-5s %s" % (i["project"], i["id"], i["status"], prog, i["decision"], i["title"]))
        if a.verbose:
            print("      scope: %s\n      match: %s\n      check: %s\n      ready at %s; notes: %s; est %s GPU-h"
                  % (i["scope"], i["match"], i["check_cmd"], i["ready"], i["notes"], i["est_gpu_hours"]))


# ---- events
def add_event(c, project, item, kind, key, msg, acked_note=None):
    """One open event per (project, item, kind, key); an acked one stays quiet until its mute ends."""
    now = int(time.time())
    if c.execute("SELECT 1 FROM events WHERE project IS ? AND item IS ? AND kind=? AND key=? AND "
                 "(acked IS NULL OR COALESCE(mute_until,0) > ?)", (project, item, kind, key, now)).fetchone():
        return False
    c.execute("INSERT INTO events (ts,project,item,kind,key,msg,acked,ack_note) VALUES (?,?,?,?,?,?,?,?)",
              (now, project, item, kind, key, msg, now if acked_note else None, acked_note))
    # committed at once: the registry has no WAL, and a write transaction left open across a pass's upkeep commands
    # (up to 40 min) makes every `site submit` lose its registry row ("database is locked") after the job went in
    c.commit()
    return True


def maint_signature(out):
    """a maintain failure's identity: its last non-empty line without numbers (timestamps, ids) and paths."""
    lines = [l for l in out.splitlines() if l.strip()]
    last = lines[-1] if lines else ""
    last = re.sub(r"(?<!\S)[~/]\S*", "P", last)
    last = re.sub(r"\d+", "N", last)
    return " ".join(last.split())[-200:]


def _has_maint_state(c):
    c.execute("CREATE TABLE IF NOT EXISTS maint_state (project TEXT, key TEXT, sig TEXT, PRIMARY KEY (project, key))")
    return True


def maintain_repeat(c, project, cmd, out):
    """True when this failure repeats the last recorded one of the same command (no success in between)."""
    _has_maint_state(c)
    key, sig = cmd[:120], maint_signature(out)
    if sig.startswith("DISK "):   # a disk alarm is never a repeat: free space can fall for days unseen
        return False
    row = c.execute("SELECT sig FROM maint_state WHERE project=? AND key=?", (project, key)).fetchone()
    if row is None:
        # no state yet (before this was recorded): compare with the most recent event of the command
        prev = c.execute("SELECT msg FROM events WHERE project=? AND kind='MAINTAIN' AND key=? ORDER BY id DESC LIMIT 1",
                         (project, key)).fetchone()
        flat = re.sub(r"\d+", "N", re.sub(r"(?<!\S)[~/]\S*", "P", prev[0])) if prev else ""
        same = bool(prev) and bool(sig) and " ".join(flat.split()).endswith(sig)
    else:
        same = row[0] == sig
    c.execute("INSERT OR REPLACE INTO maint_state VALUES (?,?,?)", (project, key, sig))
    c.commit()
    return same


def open_events(c, project=None):
    q = "SELECT id,ts,project,item,kind,msg FROM events WHERE acked IS NULL"
    p = []
    if project:
        q += " AND (project=? OR project IS NULL)"; p.append(project)
    return c.execute(q + " ORDER BY id", p).fetchall()


def cmd_event(a):
    """open one event by hand or from a hook (the dispatcher's incidents): kind and message; one open per key."""
    import hashlib
    project_of(a.project)
    c = ldb()
    key = a.key or "manual:%s" % hashlib.sha1(a.msg.encode()).hexdigest()[:12]
    if add_event(c, a.project, a.item, a.kind, key, a.msg, a.acked_note):
        eid = c.execute("SELECT MAX(id) FROM events WHERE project=? AND kind=? AND key=?",
                        (a.project, a.kind, key)).fetchone()[0]
        print("  E%d %s %s: %s" % (eid, a.project, a.kind, a.msg))
    else:
        print("  already open (or muted): %s %s %s" % (a.project, a.kind, key))


# a debounced waiter collects these (and RUN, OVERRUN, see URGENT_KINDS); every other kind returns at once. HANDBACK: an agent's hand-back that arrived
# while the main session was idle, spooled by .claude/hooks/notification_absorb.py instead of waking it
ROUTINE_KINDS = ("RUN_DONE", "DONE", "READY", "HANDBACK")
# the kinds that need action now and end a batch window at once (hand-backs and other non-urgent kinds such
# as STALLED or REFUSED would break the 10-minute window, one wake each); everything else waits it out
URGENT_KINDS = ("GAP", "ALERT")  # RUN and OVERRUN wait out the debounce
DEBOUNCE_MAX_S = 900
SPOOL_REPORT = re.compile(r"\| report: (\S+)$")


def t0_of(ev):
    """Seconds since the oldest of these events opened (a spooled hand-back may wait in the ledger from before the
    waiter was armed: its window counts from when it arrived)."""
    return time.time() - min(r[1] for r in ev) if ev else 0


def _deliver_handbacks(rows):
    """Print the full report of each spooled HANDBACK event under its line and ack it: the waiter's output is its
    delivery (the main session reads it in the one wake), so it is not left open for a second look."""
    c = None
    for eid, ts, proj, item, kind, msg in rows:
        if kind != "HANDBACK":
            continue
        m = SPOOL_REPORT.search(msg or "")
        body = ""
        if m:
            try:
                body = open(m.group(1), errors="replace").read()
            except OSError as e:
                body = "(spooled report unreadable: %s)" % e
        print("  ---- E%d hand-back, arrived %s ----\n%s\n  ---- end E%d ----" % (
            eid, time.strftime("%m-%d %H:%M", time.localtime(ts)), body.strip(), eid))
        c = c or ldb()
        c.execute("UPDATE events SET acked=?, ack_note=? WHERE id=? AND acked IS NULL",
                  (int(time.time()), "delivered by the events waiter", eid))
        c.commit()


def cmd_events(a):
    c = ldb()
    if a.wait:
        # one armed waiter per project: the Stop hook checks this pid is alive and is this process
        wf = waiter_file(a.project)
        with open(wf, "w") as f:
            f.write("%d %s" % (os.getpid(), _proc_start(os.getpid())))
        import atexit
        me = "%d %s" % (os.getpid(), _proc_start(os.getpid()))

        def _rm_own():   # a newer waiter may have overwritten the file: remove it only if it still names this process
            try:
                if open(wf).read() == me:
                    os.remove(wf)
            except OSError:
                pass
            try:         # notification_absorb.py keeps batching hand-backs while the main session re-arms
                with open(os.path.join(HOME, "events_waiter.%s.returned" % (a.project or "all")), "w") as f:
                    f.write("%d\n" % time.time())
            except OSError:
                pass
        atexit.register(_rm_own)
        # an open HANDBACK is never "already seen": it is a spooled report not yet delivered (its prompt was blocked),
        # left open by a waiter that ended or was re-armed inside its window; this waiter delivers it
        seen = {r[0] for r in open_events(c, a.project) if r[4] != "HANDBACK"} if a.new_only else set()
        if getattr(a, "debounce", None) is None:
            a.debounce = 600      # a waiter batches routine events in 10-minute windows unless told otherwise
        c.close()
        # quiet waiter: an event of an entry whose owner is working does not wake the main session; it stays open and wakes it once the owner stops
        pr = (cfg_projects().get(a.project) if a.project else None) or {}
        quiet = bool(a.project) and _runends_on(pr)
        # an outer loop: a window whose events were all acked before it ended (by their owner, or a hand-back delivered
        # otherwise) returns nothing, and returning empty would wake the main session for nothing
        while True:
            while True:
                c = ldb()
                ev = [r for r in open_events(c, a.project) if r[0] not in seen]
                c.close()
                if ev and quiet:
                    rxm = _rx()
                    owners = rxm.read_owners(sys.modules[__name__], pr)
                    ev = [r for r in ev if rxm.waiter_wants(r[4], r[3], owners)]
                if ev:
                    break
                time.sleep(int(os.environ.get("SITE_WAIT_POLL_S", "60")))
            # debounce (one wake, not one per run end; a 10 min batch by default): when every
            # event so far is routine, keep collecting for a fixed --debounce seconds from the first (the window is the
            # worst-case delay; at most DEBOUNCE_MAX_S); an urgent kind (URGENT_KINDS) returns at once with what was collected
            if getattr(a, "debounce", 0) and not any(r[4] in URGENT_KINDS for r in ev):
                t0 = time.time() - max(0, t0_of(ev))
                n = len(ev)
                while time.time() - t0 < min(a.debounce, DEBOUNCE_MAX_S):
                    time.sleep(max(1, min(int(os.environ.get("SITE_WAIT_POLL_S", "60")),
                                          int(min(a.debounce, DEBOUNCE_MAX_S) - (time.time() - t0)) + 1)))
                    c = ldb()
                    ev = [r for r in open_events(c, a.project) if r[0] not in seen]
                    c.close()
                    if ev and quiet:
                        owners = _rx().read_owners(sys.modules[__name__], pr)
                        ev = [r for r in ev if _rx().waiter_wants(r[4], r[3], owners)]
                    n = len(ev)
                    if any(r[4] in URGENT_KINDS for r in ev):
                        break
            if ev:
                break
        rows = ev
    else:
        rows = ((c.execute("SELECT id,ts,project,item,kind,msg FROM events WHERE project=? ORDER BY id DESC LIMIT ?",
                           (a.project, a.limit)).fetchall() if a.project else
                 c.execute("SELECT id,ts,project,item,kind,msg FROM events ORDER BY id DESC LIMIT ?", (a.limit,)).fetchall())
                if a.all else open_events(c, a.project))
    for eid, ts, proj, item, kind, msg in rows:
        print("  E%-5d %s %-8s %-9s %-24s %s" % (eid, time.strftime("%m-%d %H:%M", time.localtime(ts)), proj or "-",
                                                kind, item or "-", msg))
    if not rows:
        print("  no open events")
    if a.wait:
        _deliver_handbacks(rows)


def _committed_after(pr, path, ts):
    loc = os.path.expanduser(pr["local"])
    try:
        out = local(["git", "-C", loc, "log", "-1", "--format=%ct", "--", path], check=False).strip()
        return bool(out) and int(out) >= ts
    except Exception:
        return False


def cmd_ack(a):
    c = ldb()
    for e in a.events:
        eid = int(e.lstrip("E"))
        r = c.execute("SELECT ts,project,item,kind FROM events WHERE id=?", (eid,)).fetchone()
        if not r:
            die("no event E%d" % eid)
        ts, proj, item, kind = r
        if kind == "READY" and not a.no_writeup:
            it = c.execute("SELECT notes FROM items WHERE project=? AND id=?", (proj, item)).fetchone()
            notes = it[0] if it else ""
            if notes and not _committed_after(project_of(proj), notes, ts):
                die("E%d: %s/%s has a result ready; write it up in %s and commit it first (or --no-writeup REASON, "
                    "which is recorded and shown to the user)" % (eid, proj, item, notes))
        if kind == "ALERT":
            msg0 = c.execute("SELECT msg FROM events WHERE id=?", (eid,)).fetchone()[0] or ""
            for hk in _disabled_hooks(project_of(proj)) if proj in cfg_projects() else {}:
                if msg0.startswith("HOOK INCIDENT") and ": %s [" % hk in msg0:
                    die("E%d: hook still disabled: run tools/hook_incident.py --resolve %s after its replay passes"
                        % (eid, hk))
        if not a.note and not a.no_writeup:
            die("--note: what was done about it (the user reads `site events --all`)")
        if kind == "RUN":
            msg = c.execute("SELECT msg FROM events WHERE id=?", (eid,)).fetchone()[0] or ""
            m = re.search(r"\b([A-Za-z0-9]+-[a-z0-9]+-[0-9a-f]{8})\b", msg)
            run = m.group(1) if m else None
            if run and not read_since(run, ts) and not getattr(a, "read", None):
                die("E%d: %s ended and has not been read since: `site logs %s` (or `site fetch`), then ack with what it "
                    "showed; --read \"<what was read instead, e.g. its sweep result file>\" if it was read another way "
                    "(recorded in the note)" % (eid, run, run))
            if run and run not in (a.note or ""):
                die("E%d: the note must name the run it is about (%s) and say what its log showed" % (eid, run))
            if getattr(a, "read", None) and not read_since(run or "", ts):
                a_note_extra = " [read: %s]" % a.read
                a.note = (a.note or "") + a_note_extra
        if a.needs_user:
            ans = answering_decisions(c, proj, item, a.needs_user)
            if kind == "STALLED":
                # the stalled decision itself answers whether to start its work
                did = c.execute("SELECT key FROM events WHERE id=?", (eid,)).fetchone()[0].split(":", 1)[1]
                d = c.execute("SELECT id,kind,quote,covers FROM decisions WHERE id=? AND in_force=1", (did,)).fetchone()
                if d and did not in [x[0] for x in ans]:
                    ans.insert(0, tuple(d) + ("the stalled decision itself",))
            if ans and not a.override:
                sys.stderr.write("site: E%d: refused, the user already answered this. Decisions in force:\n" % eid)
                for did, k, quote, covers, why in ans:
                    sys.stderr.write("  %s %s: \"%s\"  covers: %s  [%s]\n" % (did, k, quote, covers, why))
                sys.stderr.write("Act on it (the work is approved: start it, or queue it with `site launch add`), and "
                                 "ack with --note. Only if the question is truly outside these: --override \"<why>\" "
                                 "(logged, shown to the user).\n")
                raise SystemExit(3)
            if ans:
                with open(os.path.join(HOME, "gate_overrides.log"), "a") as f:
                    f.write("%s E%d %s/%s override of %s: %s | question: %s\n" % (
                        time.strftime("%Y-%m-%d %H:%M:%S"), eid, proj, item, ",".join(x[0] for x in ans), a.override,
                        a.needs_user))
        # a condition that persists (a gap, an alert) is raised again on the next pass once acked; it stays quiet
        # for a while unless asked otherwise, so an ack is not answered by the same event 20 min later
        # (a HELD run stays HELD: unmuted, its RUN event would come back every pass)
        # a condition only the user can clear (an expired lxplus ticket) stays quiet for a day: re-raised every 2 h it
        # would wake the agent many times with nothing new to say
        hours = a.mute_hours if a.mute_hours is not None else (0 if kind in ("READY", "LAUNCHED") else
                                                               stall_hours(proj) if kind == "STALLED" else
                                                               24 if a.needs_user else 2)
        mute = int(time.time() + 3600 * hours) if hours else None
        tell = "needs-user" if a.needs_user else ("finding" if kind == "READY" and not a.no_writeup else "routine")
        note = a.note or ("no write-up: " + a.no_writeup)
        if a.needs_user:
            note = "NEEDS YOU: %s | %s" % (a.needs_user, note)
            if a.override:
                note += " | gate overridden (%s): %s" % (",".join(x[0] for x in ans), a.override)
        c.execute("UPDATE events SET acked=?, ack_note=?, mute_until=?, tell=? WHERE id=?",
                  (int(time.time()), note, mute, tell, eid))
        print("  E%d acked" % eid)
    c.commit()


# ---- the question gate
# Why: approved work does not start while the agent asks instead of starting it. A needs-user ack is refused when a decision in force
# already answers it: one that approves/prefers/releases/scopes the event's item, or whose covers name the question.
GATE_KINDS = ("approve", "prefer", "release", "scope")
_STOP = set("""about above after again against because before being between could doing during every having itself
other should their there these thing things those through under until where which while would yours whether also
what when with from that this have will just them then than into only some such more most like make need needs""".split())


def _words(s):
    return {w for w in re.findall(r"[a-z0-9]+", (s or "").lower()) if len(w) >= 5 and w not in _STOP}


def answering_decisions(c, project, item, question):
    """Decisions in force (approve/prefer/release/scope) that already answer a question about `item`: the item's own
    decision, one whose covers list the item, or a covers entry whose content words (>= 5 letters) are mostly in the
    question (at least 3 of them and 60% of the entry; entries split at , and ;). Deterministic; the item rule is the main one."""
    it = c.execute("SELECT decision FROM items WHERE project=? AND id=?", (project, item)).fetchone() if item else None
    qw = _words(question)
    out = []
    for did, kind, quote, covers in c.execute(
            "SELECT id,kind,quote,covers FROM decisions WHERE project=? AND in_force=1 AND kind IN (%s) ORDER BY recorded"
            % ",".join("?" * len(GATE_KINDS)), (project,) + GATE_KINDS):
        entries = [e.strip() for e in re.split(r"[,;]", covers or "") if e.strip()]
        why = None
        if item and (it and it[0] == did or item in entries):
            why = "names item %s" % item
        else:
            for e in entries:
                ew = _words(e)
                hit = ew & qw
                if len(hit) >= 3 and len(hit) >= 0.6 * len(ew):
                    why = "covers \"%s\" (%s)" % (e, ", ".join(sorted(hit)))
                    break
        if why:
            out.append((did, kind, quote, covers, why))
    return out


# ---- the launch queue
# Why: otherwise starting approved work depends on an agent deciding to. A launch is approved work queued with
# a readiness test; the supervisor starts it when the test passes, once, and records a LAUNCHED event.
LAUNCH_DIR = os.path.join(HOME, "launch")
LAUNCH_GRACE = 30          # s the supervisor waits on a fresh launch: an early exit is judged in the same pass
LAUNCH_DEFER = 75          # a run command exiting 75 (EX_TEMPFAIL) did not start anything: it stays queued
LAUNCH_KINDS = ("approve", "release", "scope")


def _launches(c, project=None, status=None, lid=None):
    keys = ("project", "id", "decision", "item", "ready_cmd", "run_cmd", "note", "status", "created", "checked",
            "ready_out", "launched_at", "pid", "pid_start", "log", "rc", "msg", "attempts")
    q, w, p = "SELECT %s FROM launches" % ",".join(keys), [], []
    if project:
        w.append("project=?"); p.append(project)
    if lid:
        w.append("id=?"); p.append(lid)
    if status:
        w.append("status IN (%s)" % ",".join("?" * len(status))); p += list(status)
    return [dict(zip(keys, r)) for r in c.execute(q + (" WHERE " + " AND ".join(w) if w else "") + " ORDER BY created", p)]


def _launch_blocked(c, L):
    """Why a queued launch may not fire now (None: it may). Checked at add time and again before every firing."""
    d = c.execute("SELECT kind,in_force FROM decisions WHERE id=? AND project=?", (L["decision"], L["project"])).fetchone()
    if not d or not d[1] or d[0] not in LAUNCH_KINDS:
        return "decision %s is not in force as approve/release/scope" % L["decision"]
    it = c.execute("SELECT status FROM items WHERE project=? AND id=?", (L["project"], L["item"])).fetchone()
    if not it:
        return "no item %s" % L["item"]
    if it[0] != "active":
        by = c.execute("SELECT id FROM decisions WHERE project=? AND kind='hold' AND in_force=1 AND "
                       "(','||covers||',') LIKE ?", (L["project"], "%," + L["item"] + ",%")).fetchone()
        return "item %s is %s%s" % (L["item"], it[0], " (by %s)" % by[0] if by else "")
    return None


def _tail(path, n=15):
    try:
        with open(path, errors="replace") as f:
            return " | ".join(l.rstrip() for l in strip_banner(f.read()).splitlines()[-n:])[-700:]
    except OSError:
        return "(no log)"


def _placement_refusal(pr, cmd):
    """The project's placement guard, run on the launch command exactly as on a command the agent types: a launch is
    held to the same placement rules (a named `site submit` needs a fresh `site pick` plan; raw sbatch is refused)."""
    for g in (os.path.join(os.path.expanduser(pr["local"]), ".claude", "hooks", "placement_guard.sh"),
              os.path.expanduser("~/.claude/hooks/placement_guard.sh")):
        if os.path.exists(g):
            p = subprocess.run(["bash", g], input=json.dumps({"tool_input": {"command": cmd}}).encode(),
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)
            if p.returncode == 2:
                return " ".join(p.stdout.decode("utf-8", "replace").split())[:500]
    return None


_LAUNCHED_PROCS = []       # Popen objects of this process's launches, polled so finished ones are reaped
# Why: a launch whose run command defers every pass
# (a copy that cannot reach its source) would record a LAUNCHED event on each retry, each one waking the
# agent. A retry is told on its first firing and then once a day (every RETRY_TELL_EVERY-th attempt), never per pass.
RETRY_TELL_EVERY = 28


def _tell_attempt(L):
    """Whether this firing of a launch is worth an event: the first one, then every RETRY_TELL_EVERY-th retry."""
    n = (L.get("attempts") or 0) + 1         # the attempt being made now (L was read before _fire counted it)
    return n == 1 or n % RETRY_TELL_EVERY == 0


DEFER_ALERT_AT = 3     # consecutive deferring attempts (~1 h of 20-min passes) before a launch that keeps deferring is told


def _defer_alert(c, name, L, attempts, why):
    """A launch that keeps deferring is a stuck launch, not a retry: one ALERT once it has deferred DEFER_ALERT_AT
    times, then one a day, with the reason (a launch can otherwise defer silently for hours, e.g. on a site its inputs are
    not on)."""
    if attempts == DEFER_ALERT_AT or (attempts > DEFER_ALERT_AT and attempts % RETRY_TELL_EVERY == 0):
        return add_event(c, name, L["item"], "ALERT", "launch:%s:stuck" % L["id"],
                         "launch %s has deferred %d times in a row (~%d min), nothing submitted: %s"
                         % (L["id"], attempts, attempts * 20, why))
    return 0


def _launch_runs(c, name, L, since):
    """The runs a launch submitted: those stamped with its id (CCORCH_LAUNCH); for runs registered before the stamp
    existed (no launch column value at all since the launch started), the item-and-time match."""
    lid = "%s/%s" % (name, L["id"])
    got = [r[0] for r in c.execute("SELECT id FROM runs WHERE project=? AND launch=? AND submitted>=? ORDER BY "
                                   "submitted", (name, lid, since - 5))]
    if got:
        return got
    return [r[0] for r in c.execute("SELECT id FROM runs WHERE project=? AND item=? AND submitted>=? AND launch IS NULL "
                                    "ORDER BY submitted", (name, L["item"], since - 5))]


def _report_submitted(c, name, L, since, finished):
    """What a launch actually put in a queue, told by the tool (a "started" event is not a submission: the launch may
    have deferred). Once runs are registered under the launch's item since it started:
    one LAUNCHED event naming them. A launch that ended (exit 0) with none: one ALERT. Keyed by its start time, so a
    relaunch reports again."""
    runs = _launch_runs(c, name, L, since)
    key = "launch:%s:%d" % (L["id"], since)
    if c.execute("SELECT 1 FROM events WHERE project=? AND key IN (?, ?)", (name, key + ":submitted",
                                                                          key + ":norun")).fetchone():
        return 0
    if runs:
        return add_event(c, name, L["item"], "LAUNCHED", key + ":submitted", "launch %s submitted %d run(s) for %s "
                         "under %s: %s" % (L["id"], len(runs), L["item"], L["decision"], ", ".join(runs)))
    if finished:
        return add_event(c, name, L["item"], "ALERT", key + ":norun", "launch %s finished (exit 0) without "
                         "submitting a run under %s: %s" % (L["id"], L["item"], _tail(L.get("log") or "", 3)))
    return 0


def _fire(c, L, pr, log):
    """Start one launch, detached (its own session), output to its log, exit code to <log>.rc. Returns the event
    count. Claimed with a conditional UPDATE, so two supervisors never start the same launch."""
    cur = c.execute("UPDATE launches SET status='launching', attempts=COALESCE(attempts,0)+1 WHERE project=? AND id=? "
                    "AND status='queued'", (L["project"], L["id"]))
    c.commit()
    if cur.rowcount != 1:
        return 0
    try:
        return _fire_claimed(c, L, pr, log)
    except Exception as e:                    # a claimed launch never stays 'launching' silently
        c.execute("UPDATE launches SET status='failed', msg=? WHERE project=? AND id=?", ("launcher error: %r" % e,
                                                                                         L["project"], L["id"]))
        c.commit()
        return add_event(c, L["project"], L["item"], "ALERT", "launch:%s:error" % L["id"], "launch %s: the launcher "
                         "failed before starting it (%r); not started" % (L["id"], e))


def _fire_claimed(c, L, pr, log):
    name, lid = L["project"], L["id"]
    os.makedirs(os.path.join(LAUNCH_DIR, name), exist_ok=True)
    lp = os.path.join(LAUNCH_DIR, name, "%s.log" % lid)
    rcf = lp + ".rc"
    if os.path.exists(rcf):
        os.remove(rcf)
    refused = _placement_refusal(pr, L["run_cmd"])
    if refused:
        c.execute("UPDATE launches SET status='failed', msg=? WHERE project=? AND id=?",
                  ("placement guard: " + refused, name, lid))
        c.commit()
        return add_event(c, name, L["item"], "ALERT", "launch:%s:guard" % lid, "launch %s refused by the placement "
                         "guard, not started: %s" % (lid, refused))
    with open(lp, "a") as f:
        f.write("=== %s launch %s/%s (item %s, %s)\n$ %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), name, lid,
                                                             L["item"], L["decision"], L["run_cmd"]))
    wrapper = "( %s ) >> %s 2>&1 < /dev/null; echo $? > %s" % (L["run_cmd"], shlex.quote(lp), shlex.quote(rcf))
    env = dict(os.environ, CCORCH_LAUNCH="%s/%s" % (name, lid))
    ex = c.execute("SELECT expect FROM launches WHERE project=? AND id=?", (name, lid)).fetchone()
    if ex and ex[0]:
        env["CCORCH_EXPECT"] = ex[0]          # every `site submit` the launch makes records these expectations
    p = subprocess.Popen(["bash", "-c", wrapper], cwd=os.path.expanduser(pr["local"]), env=env,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    _LAUNCHED_PROCS.append(p)
    t0 = int(time.time())
    for _ in range(LAUNCH_GRACE):
        if p.poll() is not None:
            break
        time.sleep(1)
    rc = None
    if p.poll() is not None:
        try:
            rc = int(open(rcf).read().strip())
        except (OSError, ValueError):
            rc = p.returncode
    if rc == LAUNCH_DEFER:
        c.execute("UPDATE launches SET status='queued', msg=? WHERE project=? AND id=?",
                  ("deferred %s: %s" % (time.strftime("%m-%d %H:%M"), _tail(lp, 1)), name, lid))
        c.commit()
        log("  [%s] launch %s deferred (exit 75): %s" % (name, lid, _tail(lp, 2)))
        stuck = _defer_alert(c, name, L, (L.get("attempts") or 0) + 1, _tail(lp, 1))
        if stuck or not _tell_attempt(L):
            return stuck
        return add_event(c, name, L["item"], "ALERT", "launch:%s:deferred" % lid, "launch %s is ready but its run "
                         "command deferred (exit 75, attempt %d), still queued: %s"
                         % (lid, (L.get("attempts") or 0) + 1, _tail(lp, 1)))
    if rc not in (None, 0):
        log("  [%s] launch %s FAILED (exit %d): %s" % (name, lid, rc, _tail(lp, 2)))
        c.execute("UPDATE launches SET status='failed', launched_at=?, rc=?, log=?, msg=? WHERE project=? AND id=?",
                  (t0, rc, lp, "exited %d within %d s" % (rc, LAUNCH_GRACE), name, lid))
        c.commit()
        return add_event(c, name, L["item"], "ALERT", "launch:%s:failed" % lid, "launch %s failed (exit %d, %s): %s"
                         % (lid, rc, lp, _tail(lp)))
    runs = [r[0] for r in c.execute("SELECT id FROM runs WHERE project=? AND item=? AND submitted>=?",
                                    (name, L["item"], t0 - 5))]
    state = "finished (exit 0)" if rc == 0 else "running, pid %d" % p.pid
    c.execute("UPDATE launches SET status='launched', launched_at=?, pid=?, pid_start=?, log=?, rc=?, msg=? "
              "WHERE project=? AND id=?", (t0, p.pid, _proc_start(p.pid), lp, rc, state, name, lid))
    c.commit()
    log("  [%s] launch %s LAUNCHED: %s" % (name, lid, state))
    return _report_submitted(c, name, dict(L, log=lp), t0, finished=True) if rc == 0 else 0


def launch_pass(c, name, pr, log=print):
    """The supervisor's launch step for one project: fire queued launches whose ready check passes; follow launched
    ones until they exit (a nonzero exit is an ALERT, once)."""
    new = 0
    for p in list(_LAUNCHED_PROCS):
        if p.poll() is not None:
            _LAUNCHED_PROCS.remove(p)
    cwd = os.path.expanduser(pr["local"])
    for L in _launches(c, name, ("queued",)):
        why = _launch_blocked(c, L)
        if why:
            log("  [%s] launch %s blocked: %s" % (name, L["id"], why))
            c.execute("UPDATE launches SET checked=?, ready_out=? WHERE project=? AND id=?",
                      (int(time.time()), "blocked: " + why, name, L["id"]))
            c.commit()
            if "not in force" in why:
                new += add_event(c, name, L["item"], "ALERT", "launch:%s:decision" % L["id"], "launch %s cannot fire: %s"
                                 % (L["id"], why))
            continue
        rc, out = _run_local(L["ready_cmd"], cwd, 300)
        c.execute("UPDATE launches SET checked=?, ready_out=? WHERE project=? AND id=?",
                  (int(time.time()), "exit %d: %s" % (rc, " ".join(out.split())[-300:]), name, L["id"]))
        c.commit()
        if rc:
            log("  [%s] launch %s not ready (exit %d)" % (name, L["id"], rc))
            continue
        new += _fire(c, L, pr, log)
    for L in _launches(c, name, ("launched",)):
        if L["rc"] is not None:
            continue
        rcf = (L["log"] or "") + ".rc"
        rc = None
        if os.path.exists(rcf):
            try:
                rc = int(open(rcf).read().strip())
            except ValueError:
                rc = -1
        elif not (L["pid"] and _pid_alive_pid(L["pid"], L["pid_start"])):
            rc = -9              # gone without writing its exit code: killed (a reboot, a kill of its session)
        if rc is None:          # still running: reported when it exits, with every run it submitted (a report
            continue            # on the first registered run would name only 1 of the several a launcher submits)
        if rc == LAUNCH_DEFER:
            # deferred after the grace window (a slow `site pick` inside the run command): nothing started, so it goes
            # back to the queue and is retried on the next pass, exactly like a defer within the grace window
            c.execute("UPDATE launches SET status='queued', pid=NULL, rc=NULL, msg=? WHERE project=? AND id=?",
                      ("deferred %s: %s" % (time.strftime("%m-%d %H:%M"), _tail(L["log"], 1)), name, L["id"]))
            c.commit()
            try:
                os.remove(rcf)
            except OSError:
                pass
            log("  [%s] launch %s deferred (exit 75, after the grace window): requeued" % (name, L["id"]))
            new += _defer_alert(c, name, L, L.get("attempts") or 0, _tail(L["log"], 1))
            continue
        c.execute("UPDATE launches SET rc=?, msg=? WHERE project=? AND id=?",
                  (rc, "exited %d at %s" % (rc, time.strftime("%m-%d %H:%M")), name, L["id"]))
        c.commit()
        if rc == 0:
            new += _report_submitted(c, name, L, L["launched_at"] or 0, finished=True)
        if rc:
            new += add_event(c, name, L["item"], "ALERT", "launch:%s:exit" % L["id"], "launch %s (started %s) %s: %s"
                             % (L["id"], time.strftime("%m-%d %H:%M", time.localtime(L["launched_at"] or 0)),
                                "was killed (no exit code)" if rc == -9 else "exited %d" % rc, _tail(L["log"])))
    return new


def _pid_alive_pid(pid, start):
    try:
        os.kill(int(pid), 0)
        return _proc_start(int(pid)) == start
    except (OSError, ValueError, TypeError):
        return False


def cmd_launch(a):
    c = ldb()
    a.project = a.project or a.project_opt
    if a.action == "add":
        if not (a.project and a.id and a.decision and a.item and a.ready and a.run):
            die("site launch add <project> <id> --decision D<n> --item <item> --ready CMD --run CMD [--note ..]")
        project_of(a.project)
        if c.execute("SELECT 1 FROM launches WHERE project=? AND id=?", (a.project, a.id)).fetchone():
            die("launch %s/%s exists (site launch show / rm)" % (a.project, a.id))
        L = {"project": a.project, "id": a.id, "decision": a.decision, "item": a.item}
        why = _launch_blocked(c, L)
        if why:
            die("launch refused: %s. A launch needs a decision of the user's in force (approve/release/scope) and an "
                "active item (site decisions / site items)" % why)
        exp = parse_expect(a.expect)
        c.execute("INSERT INTO launches (project,id,decision,item,ready_cmd,run_cmd,note,status,created,attempts,expect)"
                  " VALUES (?,?,?,?,?,?,?,?,?,0,?)", (a.project, a.id, a.decision, a.item, a.ready, a.run, a.note or "",
                                                      "queued", int(time.time()), json.dumps(exp) if exp else None))
        c.commit()
        print("  launch %s/%s queued (item %s, %s)" % (a.project, a.id, a.item, a.decision))
        # fired now when its ready check already passes; the supervisor's loop only retries and follows it
        pr = project_of(a.project)
        rc, out = _run_local(a.ready, os.path.expanduser(pr["local"]), 300)
        c.execute("UPDATE launches SET checked=?, ready_out=? WHERE project=? AND id=?",
                  (int(time.time()), "exit %d: %s" % (rc, " ".join(out.split())[-300:]), a.project, a.id))
        c.commit()
        if rc:
            print("  not ready yet (`%s` exit %d): the supervisor fires it when it passes" % (a.ready, rc))
            return
        L = _launches(c, a.project, lid=a.id)[0]
        _fire(c, L, pr, print)
        L = _launches(c, a.project, lid=a.id)[0]
        print("  %s: %s" % (L["status"], L["msg"] or ""))
        return
    if a.action == "list":
        rows = _launches(c, a.project, None if a.all else ("queued", "launching", "launched", "failed"))
        for L in rows:
            when = L["launched_at"] or L["created"]
            print("  %-8s %-24s %-9s %-5s %-22s %s %s" % (L["project"], L["id"], L["status"], L["decision"], L["item"],
                                                         time.strftime("%m-%d %H:%M", time.localtime(when)),
                                                         (L["msg"] or L["ready_out"] or "")[:90]))
        if not rows:
            print("  no launches")
        return
    if not a.project or not a.id:
        die("site launch %s <project> <id>" % a.action)
    Ls = _launches(c, a.project, lid=a.id)
    if not Ls:
        die("no launch %s/%s" % (a.project, a.id))
    L = Ls[0]
    if a.action == "show":
        for k in ("project", "id", "status", "decision", "item", "note", "ready_cmd", "run_cmd", "ready_out", "msg",
                  "log", "pid", "rc", "attempts"):
            print("  %-10s %s" % (k, L[k]))
        ex = c.execute("SELECT expect FROM launches WHERE project=? AND id=?", (a.project, a.id)).fetchone()
        print("  %-10s %s" % ("expect", ex[0] if ex else None))
        for k in ("created", "checked", "launched_at"):
            print("  %-10s %s" % (k, time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(L[k])) if L[k] else "-"))
        if L["launched_at"]:
            runs = c.execute("SELECT id,site,state FROM runs WHERE project=? AND item=? AND submitted>=?",
                             (a.project, L["item"], L["launched_at"] - 5)).fetchall()
            print("  runs       %s" % (", ".join("%s %s %s" % r for r in runs) or "none registered since the launch"))
        if L["log"]:
            print("  log tail   %s" % _tail(L["log"], 8))
    elif a.action == "rm":
        alive = L["pid"] and _pid_alive_pid(L["pid"], L["pid_start"])
        c.execute("DELETE FROM launches WHERE project=? AND id=?", (a.project, a.id))
        c.commit()
        print("  launch %s/%s removed%s" % (a.project, a.id, " (its process, pid %d, is still running: not killed)"
                                            % L["pid"] if alive else ""))


# ---- stalled decisions
# Why: approved work can sit unstarted with its decision in force. A decision of kind approve or
# release that has, after `stall_hours` (projects.toml, default 3), no active item, or only active items with no run
# (queued, running or finished) and no queued launch, is STALLED: a blocking event, acked with what was done.
STALL_KINDS = ("approve", "release")


def _said_ts(said_at, recorded):
    import datetime
    try:
        d = datetime.datetime.fromisoformat((said_at or "").replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.timezone.utc)
        return int(d.timestamp())
    except ValueError:
        return int(recorded or 0)


def stall_hours(project):
    return float(cfg_projects().get(project, {}).get("stall_hours", 3))


def item_moving(c, project, item_id):
    """True while the item has a run not yet terminal or a launch queued or launching (its work is in progress).
    A run the scheduler reports as UNKNOWN (sacct returned nothing) is not progress: it would keep the item moving
    forever."""
    q = ",".join("?" * (len(TERMINAL) + 1))
    if c.execute("SELECT 1 FROM runs WHERE project=? AND item=? AND COALESCE(state,'') NOT IN (%s) LIMIT 1" % q,
                 (project, item_id) + TERMINAL + ("UNKNOWN",)).fetchone():
        return True
    # a launch stuck in 'launching' (its launcher died) is not progress: only one checked within the hour counts
    return bool(c.execute("SELECT 1 FROM launches WHERE project=? AND item=? AND (status='queued' OR "
                          "(status='launching' AND COALESCE(checked, created) > ?)) LIMIT 1",
                          (project, item_id, int(time.time()) - 3600)).fetchone())


def idle_items(c, project):
    """[(id, title)] of active items with nothing in progress and no recorded wait: each needs its next step taken,
    a wait named (`site item set --waiting`), or closing (`site item done`)."""
    out = []
    for i in _items(c, project, ("active",)):
        if item_moving(c, project, i["id"]):
            continue
        w = c.execute("SELECT waiting, updated FROM items WHERE project=? AND id=?", (project, i["id"])).fetchone()
        if w and w[0]:
            last = c.execute("SELECT MAX(submitted) FROM runs WHERE project=? AND item=?", (project, i["id"])).fetchone()[0]
            lastL = c.execute("SELECT MAX(created) FROM launches WHERE project=? AND item=?",
                              (project, i["id"])).fetchone()[0]
            last = max(last or 0, lastL or 0)
            if not last or last <= (w[1] or 0):          # a run or a launch after the wait was set ends it
                continue
        out.append((i["id"], i["title"]))
    return out


def stalled_decisions(c, project, hours=None, now=None):
    """[(decision id, quote, said_at, idle seconds, why)] for the project's stalled approve/release decisions.
    Items under a decision: those it approved (items.decision) and, for a release, the items its covers name.
    Not stalled: a decision with an item done or held and none active (its work finished, or the user held it), one
    with any active item that has a run in the registry, progress in its check, or a queued/launching/launched
    launch. Idle counts from the latest of the decision, its active items' creation, their runs and launches."""
    hours = stall_hours(project) if hours is None else hours
    now = now or time.time()
    items = _items(c, project)
    out = []
    for did, kind, quote, said, rec, covers in c.execute(
            "SELECT id,kind,quote,said_at,recorded,covers FROM decisions WHERE project=? AND in_force=1 AND kind IN (?,?)"
            " ORDER BY recorded", (project,) + STALL_KINDS):
        cov = {x.strip() for x in (covers or "").split(",")}
        under = [i for i in items if i["decision"] == did or (kind == "release" and i["id"] in cov)]
        st = {i["status"] for i in under}
        if "active" not in st and ("done" in st or "held" in st):
            continue
        last = _said_ts(said, rec)
        why, live = None, False
        if not under:
            why = "no work item under it"
        for i in (i for i in under if i["status"] == "active"):
            last = max(last, i["created"] or 0)
            r = c.execute("SELECT COUNT(*), MAX(submitted) FROM runs WHERE project=? AND item=?",
                          (project, i["id"])).fetchone()
            L = c.execute("SELECT COUNT(*), MAX(MAX(created, COALESCE(launched_at,0))) FROM launches WHERE project=? "
                          "AND item=? AND status IN ('queued','launching','launched')", (project, i["id"])).fetchone()
            pr = json.loads(i["progress"]) if i["progress"] else {}
            last = max(last, r[1] or 0, L[1] or 0)
            if item_moving(c, project, i["id"]) or pr.get("active"):
                live = True
                break
            why = "active item %s has no run and no queued launch" % i["id"]
        if live or not why:
            continue
        idle = now - last
        if idle >= hours * 3600:
            out.append((did, quote, said or "", idle, why))
    return out


def _stall_msg(did, quote, said, idle, why):
    w = (quote or "").split()
    return ("%s (\"%s%s\", said %s) idle %.1f h: %s. Start it (submit, or queue a launch), or ack with what stands "
            "in the way" % (did, " ".join(w[:8]), "..." if len(w) > 8 else "", (said or "?")[:16], idle / 3600, why))


def cmd_stalled(a):
    c = ldb()
    rows = stalled_decisions(c, a.project, a.hours)
    for r in rows:
        print("  " + _stall_msg(*r))
    print("  %d stalled decision(s) for %s at %g h" % (len(rows), a.project,
                                                        stall_hours(a.project) if a.hours is None else a.hours))


# ---- setup checks: a run's RUN_SUMMARY line against what its submission expected
# Why: a rerun from a saved config can silently keep a setting (e.g. a schedule length) the new run must not have,
# and nobody sees it until the results are wrong. The project prints one `RUN_SUMMARY {json}`
# line when training starts; the supervisor reads it once per run.
SUMMARY_WAIT = 1200        # s a run with expectations may run without a RUN_SUMMARY line before that is an ALERT
SUMMARY_GIVEUP = 3 * 86400


def parse_expect(items, env_json=None):
    out = {}
    if env_json:
        try:
            out.update(json.loads(env_json))
        except ValueError:
            pass
    for kv in items or []:
        k, sep, v = kv.partition("=")
        if not sep or not k.strip():
            die("--expect takes KEY=VALUE (got %r)" % kv)
        out[k.strip()] = v.strip()
    return out


def _num(v):
    if isinstance(v, bool):
        return None
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def _same(want, got):
    a, b = _num(want), _num(got)
    if a is not None and b is not None:
        return a == b or abs(a - b) <= 1e-6 * max(abs(a), abs(b))
    norm = lambda x: "none" if x is None else str(x).strip().lower().replace("null", "none")
    return norm(want) == norm(got)


def check_summary(summ, expect):
    """[(key, expected, got)] that do not match. Always on, with or without expectations: a cosine (or one-cycle)
    schedule spans the run, T_max == iterations x scheduler_scale, unless the run is a DyHPO warm-start resume
    (a fidelity increment) or an --expect names T_max itself."""
    bad = []
    for k, v in (expect or {}).items():
        got = summ.get(k, "<absent>")
        if not _same(v, got):
            bad.append((k, v, got))
    if "T_max" not in (expect or {}) and summ.get("T_max") is not None and \
            not (summ.get("is_dyhpo_run") and summ.get("warm_start")):
        want = (_num(summ.get("iterations")) or 0) * (_num(summ.get("scheduler_scale")) or 1)
        if not _same(int(want), summ.get("T_max")):
            bad.append(("T_max", "%d (iterations %s x scheduler_scale %s)" % (want, summ.get("iterations"),
                                                                             summ.get("scheduler_scale")),
                        summ.get("T_max")))
    return bad


def _summary_line(sc, project, path, sched_id, timeout=90):
    pat = "*%s*" % sched_id
    if sc["scheduler"] == "condor":
        cwd = submit_cwd(sc, project_of(project), project, path)
        inner = "cd %s/logs && ls -t %s 2>/dev/null | head -3 | xargs -r grep -h -m1 'RUN_SUMMARY '" % (
            shlex.quote(cwd), pat)
    else:
        inner = ("cd %s && ls -t $(find . -maxdepth 3 -name %s -newermt '-30 days' -not -path './.venv/*' 2>/dev/null)"
                 " 2>/dev/null | head -3 | xargs -r grep -h -m1 'RUN_SUMMARY '" % (shlex.quote(path), shlex.quote(pat)))
    rc, out = run_ssh(sc, inner, timeout=timeout)
    for ln in out.splitlines():
        i = ln.find("RUN_SUMMARY ")
        if i < 0:
            continue
        rest = ln[i + len("RUN_SUMMARY "):].strip()
        if rest.startswith("{"):
            try:
                return json.loads(rest)
            except ValueError:
                continue
        # the plain form `RUN_SUMMARY <name...> k=v ...` (lhe_parts, lhe_probe): its k=v pairs
        kv = dict(t.split("=", 1) for t in rest.split() if "=" in t)
        if kv:
            return kv
    return None


def summary_pass(c, name, log=print, now=None):
    """Once per run of the project: read its RUN_SUMMARY when the run is running or ended, compare, and raise an
    ALERT on a mismatch; a run with expectations that has run SUMMARY_WAIT without the line is an ALERT too."""
    now = now or time.time()
    new = 0
    rows = c.execute("SELECT id,site,sched_id,state,remote_path,submitted,item,expect,running_seen FROM runs "
                     "WHERE project=? AND summary_state IS NULL AND submitted>? AND state NOT IN "
                     "('SUBMITTED','PENDING','IDLE','HELD')", (name, now - SUMMARY_GIVEUP)).fetchall()
    for rid, site, sched_id, state, path, sub, item, expect, seen in rows:
        if state and (state.startswith("CANCELLED") or state == "REMOVED"):
            c.execute("UPDATE runs SET summary_state='n/a' WHERE id=?", (rid,)); c.commit()
            continue
        exp = json.loads(expect) if expect else {}
        # an expectation passed as RUN_SUMMARY=k=v (e.g. 'RUN_SUMMARY=rc=0') means k=v
        if isinstance(exp.get("RUN_SUMMARY"), str) and "=" in exp["RUN_SUMMARY"]:
            k, v = exp.pop("RUN_SUMMARY").split("=", 1); exp[k] = v
        if not seen:
            seen = int(now)
            c.execute("UPDATE runs SET running_seen=? WHERE id=?", (seen, rid)); c.commit()
        try:
            summ = _summary_line(site_of(site), name, path, sched_id)
        except Exception as e:
            log("  [%s] %s: RUN_SUMMARY read failed (%r)" % (name, rid, e))
            continue
        if summ is None:
            ended = state in TERMINAL
            # an expectation of only the exit code can be met only at the end: a running job is not alerted for it
            if exp and (ended or (now - seen > SUMMARY_WAIT and set(exp) - {"rc"})):
                c.execute("UPDATE runs SET summary_state='missing' WHERE id=?", (rid,)); c.commit()
                new += add_event(c, name, item, "ALERT", "summary:%s" % rid, "%s: no RUN_SUMMARY line %s, so its "
                                 "setup cannot be checked against %s" % (
                                     rid, "in its log (it ended %s)" % state if ended else
                                     "after %d min running" % ((now - seen) // 60), json.dumps(exp)))
            elif not exp and (ended or now - seen > 3600):
                c.execute("UPDATE runs SET summary_state='none' WHERE id=?", (rid,)); c.commit()
            continue
        bad = check_summary(summ, exp)
        c.execute("UPDATE runs SET summary=?, summary_state=? WHERE id=?",
                  (json.dumps(summ), "mismatch" if bad else "ok", rid))
        c.commit()
        log("  [%s] %s: RUN_SUMMARY %s" % (name, rid, "MISMATCH " + str(bad) if bad else "ok"))
        if bad:
            new += add_event(c, name, item, "ALERT", "summary:%s" % rid, "%s runs a setup it was not meant to: %s. "
                             "Cancel and resubmit it fixed (site logs %s)" % (rid, "; ".join(
                                 "%s is %s, expected %s" % (k, g, w) for k, w, g in bad), rid))
    return new


# ---- the supervisor
def _why_waiting(sc, sched_id):
    if sc["scheduler"] == "slurm":
        rc, out = run_ssh(sc, "squeue -h -j %s -o '%%r, est. start %%S'" % shlex.quote(sched_id), timeout=60)
    else:
        rc, out = run_ssh(sc, "condor_q -better-analyze %s 2>&1 | grep -E 'match and are willing|rejected by your "
                              "job|Reason for last match failure' | head -3" % shlex.quote(sched_id), timeout=120)
    return " ".join(out.split())[:300] or "no reason given"


def _dead_dependency(line, parent_state):
    """A pending slurm job that can never start: `line` is its squeue "%r|%E" (reason|dependency), `parent_state(id)` the
    ledger's state of a job id on its site. A description when the reason is DependencyNeverSatisfied or a job it waits
    on (afterok:<id>) ended anything but COMPLETED; else None (such a job would otherwise sit PENDING for
    hours behind a failed dependency, with no event)."""
    reason, _, dep = line.partition("|")
    if reason.strip().startswith("DependencyNeverSatisfied"):
        return "the scheduler says DependencyNeverSatisfied (%s)" % (dep.strip() or "no dependency shown")
    if reason.strip().startswith("Dependency"):
        for jid in re.findall(r"after\w*:(\d+)", dep):
            st = parent_state(jid)
            if st in TERMINAL and st != "COMPLETED":
                return "it waits on job %s, which ended %s" % (jid, st)
    return None


def _dead_chain(c, sc, site, sched_id):
    if sc["scheduler"] != "slurm":
        return None
    rc, out = run_ssh(sc, "squeue -h -j %s -o '%%r|%%E'" % shlex.quote(sched_id), timeout=60)
    def parent(jid):
        r = c.execute("SELECT state FROM runs WHERE site=? AND sched_id=?", (site, jid)).fetchone()
        return (r[0] if r else None) or ""
    return _dead_dependency(out.strip().splitlines()[-1] if out.strip() else "", parent)


def _wait_reason(why):
    """The scheduler's reason a job waits, without its estimated start or digits: the group key of an overrun."""
    r = re.sub(r"[, ]*est\. start.*", "", why or "").strip()
    r = re.sub(r"\d+", "#", r)
    return (r or "no reason given")[:80]


def _overrun_groups(c, project, groups, now=None, ack_quiet=12 * 3600):
    """One OVERRUN event per (project, site, reason), key overrun:<site>:<reason>, listing the count and run ids.
    A group with an open event, or acked less than 12 h ago, raises nothing for new members; once none of its jobs
    is pending any more (all started) its acked event is retired so the group can raise again. A job pending on
    Dependency waits on another job by design and is never an event."""
    now = int(now or time.time())
    new = 0
    live = set()
    for (site, reason), rows in sorted(groups.items()):
        if reason.lower().startswith("dependency"):
            continue
        key = "overrun:%s:%s" % (site, reason)
        live.add(key)
        last = c.execute("SELECT acked FROM events WHERE project IS ? AND kind='OVERRUN' AND key=? ORDER BY id DESC "
                         "LIMIT 1", (project, key)).fetchone()
        if last and (last[0] is None or now - last[0] < ack_quiet):
            continue
        rows = sorted(rows)
        oldest = max((now - (r[3] or now)) for r in rows) / 3600
        new += add_event(c, project, rows[0][1], "OVERRUN", key, "%d jobs still pending on %s, oldest %.1f h: %s (%s)"
                         % (len(rows), site, oldest, reason, ", ".join(r[0] for r in rows)))
    for (k,) in c.execute("SELECT DISTINCT key FROM events WHERE project IS ? AND kind='OVERRUN' AND key LIKE "
                          "'overrun:%' AND acked IS NOT NULL", (project,)).fetchall():
        if k not in live:
            c.execute("UPDATE events SET key=key||'#ended' WHERE project IS ? AND kind='OVERRUN' AND key=? AND "
                      "acked IS NOT NULL", (project, k))
    c.commit()
    return new


def _wait_limit(site):
    """How long a job may wait to start before it is an overrun: twice what my jobs there waited lately, at least
    1 h (a job can sit for hours behind a memory request one slot could hold, while a waiter watches only
    for an end state)."""
    sc = site_of(site)
    # the history cache expires after 30 min and only `site pick` refreshes it; an old history is still the right
    # yardstick (an expired one gave Jean Zay's ~5.5 h waits a 1 h limit)
    e = _cache_get("hist:" + site, 10 ** 9)
    w = recent_stats((e or {}).get("raw", ""), sc.get("scheduler"))[0]
    return max(3600, 2 * (w or 0))


def banner_selftest():
    """strip_banner on a stand-in with the login notice's frame on both (merged) streams, before the marker and in
    mid-output; ~/.local/share/ccorch/tests/test_site_banner.py has the full cases."""
    note = ("Using Claude/Gemini/Copilot/ChatGPT and other generative AI tools: stand-in\nx\n"
            "Login nodes are for interactive work: stand-in\n")
    got = strip_banner(note + OUT_MARK + "\nout\nerr\n" + note + "out 2\n", {})
    return [] if got == "out\nerr\nout 2\n" else ["strip_banner leaves the login notice in the output: %d bytes left"
                                                    % len(got)]


def selftest(project=None):
    """Problems with the guards themselves, as strings: a guard that stopped working is an alert, not a pass."""
    probs = banner_selftest()
    sets = [os.path.expanduser("~/.claude/settings.json")]
    projs = cfg_projects()
    for name, pr in projs.items():
        if project and name != project:
            continue
        for f in ("settings.json", "settings.local.json"):
            sets.append(os.path.join(os.path.expanduser(pr["local"]), ".claude", f))
    have_guard = False
    for f in sets:
        if not os.path.exists(f):
            continue
        try:
            cfg = json.load(open(f))
        except ValueError as e:
            probs.append("%s does not parse (%s): its hooks are all off" % (f, e)); continue
        root = os.path.dirname(os.path.dirname(f))
        for ev, ms in (cfg.get("hooks") or {}).items():
            for m in ms:
                for h in m.get("hooks", []):
                    cmd = h.get("command", "")
                    have_guard |= "ledger_guard" in cmd and f.startswith(os.path.expanduser("~/.claude"))
                    ex = lambda t: os.path.expanduser(t.replace("$CLAUDE_PROJECT_DIR", root).replace(
                        "${CLAUDE_PROJECT_DIR}", root).replace("$HOME", "~"))
                    for tok in re.findall(r"[\w$~./{}-]+\.(?:sh|py)\b", cmd):
                        if "/" not in tok:          # a hook named to the dispatcher: checked below in its directory
                            continue
                        p = ex(tok)
                        if not os.path.exists(p):
                            probs.append("%s hook in %s runs %s, which does not exist" % (ev, f, p))
                    # `python3 "<dir>/dispatch.py" <hook> [args]` (the hook dispatcher): the hook
                    # lives next to the dispatcher
                    m = re.search(r"([\w$~./{}-]+/)dispatch\.py\"?\s+([\w.-]+\.(?:sh|py))\b", cmd)
                    if m and not os.path.exists(os.path.join(ex(m.group(1)), m.group(2))):
                        probs.append("%s hook in %s dispatches %s, which does not exist in %s" % (
                            ev, f, m.group(2), ex(m.group(1))))
    if not have_guard:
        probs.append("~/.claude/settings.json has no ledger_guard hook: open events no longer stop a turn")
    for name, pr in projs.items():
        if project and name != project:
            continue
        for cmd in pr.get("selftest", []):
            try:
                p = subprocess.run(cmd, shell=True, cwd=os.path.expanduser(pr["local"]), stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, timeout=300)
                if p.returncode:
                    probs.append("%s selftest `%s` failed: %s" % (name, cmd, " ".join(
                        strip_banner(p.stdout.decode("utf-8", "replace")).split())[-400:]))
            except subprocess.TimeoutExpired:
                probs.append("%s selftest `%s` timed out" % (name, cmd))
    return probs


def cmd_selftest(a):
    probs = selftest(a.project)
    for p in probs:
        print("  GUARD " + p)
    print("  selftest: %s" % ("%d problem(s)" % len(probs) if probs else "ok"))
    raise SystemExit(1 if probs else 0)


def _run_local(cmd, cwd, timeout):
    try:
        p = subprocess.run(cmd, shell=True, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
        return p.returncode, strip_banner(p.stdout.decode("utf-8", "replace"))
    except subprocess.TimeoutExpired:
        return 124, "timed out after %d s" % timeout


def _beat(project):
    with open(heartbeat_file(project), "w") as f:
        f.write(str(int(time.time())))


# ---- idle wake (a turn can end with `plan next` listing work to resume and nothing running; nothing would wake it,
# since the plan check runs only at a turn's end)
IDLE_MIN = 30
IDLE_STALE_DAYS = 3
_IDLE_RE = re.compile(r"^(RESUME|LAUNCH) (\S+?)(?: \S+)?: (.*)$")


def idle_actions(next_out):
    """[(entry, action, reason)] for the RESUME/LAUNCH lines of `plan next` (an owner that is working is never listed)."""
    out = []
    for l in next_out.splitlines():
        m = _IDLE_RE.match(l.strip())
        if m:
            out.append((m.group(2), m.group(1), m.group(3)))
    return out


def idle_pass(c, project, cwd, next_out=None, now=None, minutes=IDLE_MIN):
    """STALLED event for an entry `plan next` lists for RESUME/LAUNCH, when no job of the project is running or queued,
    after `minutes`, once per entry and state (entry, action, step); the state clears when the entry leaves the list."""
    now = int(time.time()) if now is None else now
    if next_out is None:
        rc, next_out = _run_local("python3 tools/plan.py next", cwd, 300)
    acts = idle_actions(next_out)
    c.execute("CREATE TABLE IF NOT EXISTS idle_seen (project TEXT, key TEXT, first INTEGER, fired INTEGER, "
              "PRIMARY KEY (project, key))")
    # a job in flight is a run not terminal, not UNKNOWN (sacct returned nothing: an sbatch banner stored as the job id,
    # as item_moving does) and submitted within IDLE_STALE_DAYS (a row left RUNNING for weeks is a registry gap, not a
    # job); stale rows would otherwise keep `live` above 0, so no
    # idle event could ever open
    live = c.execute("SELECT COUNT(*) FROM runs WHERE project=? AND state NOT IN (%s) AND COALESCE(state,'')!='UNKNOWN' "
                     "AND submitted > ?" % ",".join("?" * len(TERMINAL)),
                     (project,) + TERMINAL + (now - IDLE_STALE_DAYS * 86400,)).fetchone()[0]
    keys = {}
    for eid, act, why in acts:
        m = re.search(r"step (\d+)", why)
        keys["%s:%s:%s" % (eid, act, m.group(1) if m else why[:40])] = (eid, act, why)
    if live:                                  # a job in flight: no idle state, all clocks reset
        keys = {}
    c.execute("DELETE FROM idle_seen WHERE project=?" + (" AND key NOT IN (%s)" % ",".join("?" * len(keys)) if keys else ""),
              (project,) + tuple(keys))
    new = 0
    for key, (eid, act, why) in keys.items():
        row = c.execute("SELECT first, fired FROM idle_seen WHERE project=? AND key=?", (project, key)).fetchone()
        if row is None:
            c.execute("INSERT INTO idle_seen VALUES (?,?,?,0)", (project, key, now))
            continue
        if not row[1] and now - row[0] >= minutes * 60:
            new += add_event(c, project, None, "STALLED", "idle:" + key,
                             "idle %d min: no job running or queued and no owner working on %s, `plan next` lists %s %s: %s"
                             % ((now - row[0]) // 60, eid, act, eid, why[:200]))
            c.execute("UPDATE idle_seen SET fired=1 WHERE project=? AND key=?", (project, key))
    c.commit()
    return new



GATE_OFF_MIN = 15      # minutes a plan_check project's Stop gate may stay disabled before every pass raises an ALERT


def _disabled_hooks(pr):
    """{hook: record} of the project's .claude/hooks/disabled.json ({} when absent or unreadable)."""
    try:
        d = json.load(open(os.path.join(os.path.expanduser(pr["local"]), ".claude", "hooks", "disabled.json")))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def gate_off_pass(c, name, pr, now=None):
    """The Stop gate (plan_check.py) disabled for more than GATE_OFF_MIN: an ALERT every pass (left off after its fix, with
    the incident acked unresolved, work idles). The key is fixed, so each ack's mute
    is followed by a re-open."""
    rec = _disabled_hooks(pr).get("plan_check.py")
    if rec is None:
        return 0
    try:
        t = datetime.datetime.fromisoformat(rec.get("time")).timestamp()
    except (TypeError, ValueError, AttributeError):
        t = 0     # no readable time: treated as long off
    now = now or time.time()
    if now - t < 60 * GATE_OFF_MIN:
        return 0
    return add_event(c, name, None, "ALERT", "gate-off:plan_check.py", "the Stop gate plan_check.py has been disabled "
                     "for %d min (incident %s): with it off, turns end with no armed waiter and owners stop. Fix it, "
                     "replay, and run tools/hook_incident.py --resolve plan_check.py" % (
                         (now - t) // 60, rec.get("incident")))


def supervise_pass(project=None, log=print, beat=True):
    """One pass. Every write is committed at once (add_event, _commit) so the registry is never locked across the
    upkeep and check commands. `beat`: the continuous loop marks the project's supervisor alive; `--once` does not."""
    if beat:          # alive from the start of a pass: a first pass with a long upkeep command must not look dead
        _beat(project)
    c = ldb()
    new = 0
    for p in selftest(project):
        new += add_event(c, None, None, "GUARD", p[:200], p)
    projs = cfg_projects()
    for name, pr in projs.items():
        if project and name != project:
            continue
        cwd = os.path.expanduser(pr["local"])
        # queued launches first: a maintain command can take 40 min, and approved work should not wait on upkeep
        try:
            new += launch_pass(c, name, pr, log)
        except Exception as e:
            new += add_event(c, name, None, "ALERT", "launch pass failed", "the launch step failed: %r" % e)
        # a project with its own plan check (plan_check = true) judges idle work from its plan, where a decision's
        # entry can be done or worked by a step agent without a run here: the item-level stall alerts only duplicate
        # it, and each wakes the main session for nothing
        if ledger_on(name) and not pr.get("plan_check"):
            try:
                for r in stalled_decisions(c, name):
                    new += add_event(c, name, None, "STALLED", "stalled:" + r[0], _stall_msg(*r))
            except Exception as e:
                new += add_event(c, name, None, "ALERT", "stall check failed", "the stall check failed: %r" % e)
        if ledger_on(name) and pr.get("plan_check"):
            try:
                new += gate_off_pass(c, name, pr)
            except Exception as e:
                new += add_event(c, name, None, "ALERT", "gate check failed", "the gate-off check failed: %r" % e)
            try:
                new += idle_pass(c, name, cwd)
            except Exception as e:
                new += add_event(c, name, None, "ALERT", "idle check failed", "the idle check failed: %r" % e)
        # upkeep the project wants run every pass (queue feeders, rebalancers): their failures are events. They get
        # CCORCH_WORK for every active item, so a local planner (a rebalancer) leaves held work where it is
        env = dict(os.environ, CCORCH_WORK=work_env(name, ["*"]) if ledger_on(name) else "")
        # CCORCH_NO_MAINTAIN=1 pauses the feeders (e.g. a full disk on a site), the watch keeps running
        for cmd in ([] if os.environ.get("CCORCH_NO_MAINTAIN") else pr.get("maintain", [])):
            try:
                p_ = subprocess.run(cmd, shell=True, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, timeout=2400)
                rc, out = p_.returncode, strip_banner(p_.stdout.decode("utf-8", "replace"))
            except subprocess.TimeoutExpired:
                rc, out = 124, "timed out after 2400 s"
            log("  [%s maintain] %s" % (name, " ".join(out.split())[-300:]))
            if rc == JOB_NONE and "CCJ_NO_RESULT" in out:
                continue        # a command run as a site job (site run --recurring) whose job has not ended: no news
            if rc:
                # the same failure again (same command, same error signature) after an earlier event for it, with no
                # success since, opens nothing (one expired login is one event); a success clears
                if maint_signature(out).startswith("DISK "):
                    # a disk alarm is an ALERT under its own key: the ack of an ssh failure of the same
                    # command would otherwise mute the alarms of a full disk
                    maintain_repeat(c, name, cmd, out)
                    new += add_event(c, name, None, "ALERT", "DISK " + cmd[:115], "`%s` exited %d: %s" % (
                        cmd, rc, " ".join(out.split())[-300:]))
                elif not maintain_repeat(c, name, cmd, out):
                    new += add_event(c, name, None, "MAINTAIN", cmd[:120], "`%s` exited %d: %s" % (
                        cmd, rc, " ".join(out.split())[-300:]))
            else:
                _has_maint_state(c)
                c.execute("INSERT OR REPLACE INTO maint_state VALUES (?,?,?)", (name, cmd[:120], ""))   # success: next failure opens
                c.commit()
            refused = sorted(set(re.findall(r"refused (\S+):", out)))
            if refused:
                new += add_event(c, name, None, "REFUSED", cmd[:120], "`%s` was refused for %d sweep(s) outside the "
                                 "active work items or in a held one, e.g. %s" % (cmd, len(refused), refused[0]))
        active = _items(c, name, ("active",))
        outs = {}
        for it in active:
            if not it["check_cmd"]:
                continue
            if it["check_cmd"] not in outs:
                rc, out = _run_local(it["check_cmd"], cwd, 1800)
                js = next((l for l in reversed(out.splitlines()) if l.startswith("{")), None)
                try:
                    outs[it["check_cmd"]] = json.loads(js) if js else None
                except ValueError:
                    outs[it["check_cmd"]] = None
                if outs[it["check_cmd"]] is None:
                    new += add_event(c, name, it["id"], "CHECK", it["check_cmd"][:120], "check `%s` gave no JSON "
                                     "(exit %d): %s" % (it["check_cmd"], rc, " ".join(out.split())[-300:]))
                else:
                    for al in outs[it["check_cmd"]].get("alerts", []):
                        # keyed without its numbers: "... for 251 min" and "... for 275 min" are one condition, so an ack's mute
                        # holds (the same stall would otherwise come back minutes after its ack)
                        new += add_event(c, name, None, "ALERT", re.sub(r"\d+", "N", al)[:160], al)
            res = outs.get(it["check_cmd"])
            if not res:
                continue
            units = {u: v for u, v in (res.get("units") or {}).items() if any(fnmatch.fnmatchcase(u, g) for g in _globs(it))}
            exp = sum(v.get("expected", 0) for v in units.values())
            done = sum(min(v.get("done", 0), v.get("expected", 0)) for v in units.values())
            gap = sorted(u for u, v in units.items() if v.get("expected", 0) - v.get("done", 0) > v.get("active", 0))
            if res.get("partial"):
                # a site did not report: its results and queue are missing from the counts, so neither a gap nor a
                # milestone can be judged this pass (the site's own ALERT says so)
                log("  [%s] %s: partial check (%s), progress not updated" % (name, it["id"], res.get("partial")))
                continue
            old = json.loads(it["progress"]) if it["progress"] else {}
            prog = {"expected": exp, "done": done, "units": len(units), "gap": len(gap), "ts": int(time.time())}
            c.execute("UPDATE items SET progress=? WHERE project=? AND id=?", (json.dumps(prog), name, it["id"]))
            c.commit()
            log("  [%s] %s: %d/%d done over %d units%s" % (name, it["id"], done, exp, len(units),
                                                        ", %d with nothing running" % len(gap) if gap else ""))
            prog["gap_passes"] = (old.get("gap_passes", 0) + 1) if gap else 0
            c.execute("UPDATE items SET progress=? WHERE project=? AND id=?", (json.dumps(prog), name, it["id"]))
            c.commit()
            if gap and prog["gap_passes"] >= 2:
                # two passes in a row: a single pass catches work in flight between sites (a move's DAG not yet
                # visible). One key per item: a mute holds while the set of gaps changes
                new += add_event(c, name, it["id"], "GAP", "gap", "%d unit(s) miss results with nothing "
                                 "running or queued for them, e.g. %s" % (len(gap), gap[0]))
            if exp:
                f0, f1 = (old["done"] / old["expected"] if old.get("expected") else 0.0), done / exp
                for th in sorted(float(x) for x in (it["ready"] or "1").split(",") if x):
                    if f0 < th <= f1 or (th <= f1 and not old):
                        new += add_event(c, name, it["id"], "READY", "%g" % th, "%d/%d (%.0f%%) done: a result to "
                                         "analyse and show%s" % (done, exp, 100 * f1, (" (write-up in %s)" % it["notes"])
                                                                 if it["notes"] else ""))
        # runs launched for active items: overruns in the queue, run ends. A run already marked terminal by someone
        # else's `site poll` still gets its RUN event, once
        # held items too: a hold stops new work, not the runs already in flight ; polling only active items would leave held
        # items' runs RUNNING for days with no RUN_DONE
        ids = [i["id"] for i in active] + [i["id"] for i in _items(c, name, ("held",))]
        rx_cache = {}
        pend_groups = {}
        # a project without the ledger has no items: its runs (item NULL) are watched as one
        free = not ledger_on(name)
        if ids or free:
            rows = c.execute("SELECT id,site,sched_id,state,submitted,item FROM runs WHERE project=? AND (item IN (%s)%s) "
                             "AND (state NOT IN (%s) OR id || ':' || state NOT IN (SELECT key FROM events WHERE kind='RUN'))"
                             % (",".join("?" * len(ids)), " OR item IS NULL" if free else "", ",".join("?" * len(TERMINAL))),
                             [name] + ids + list(TERMINAL)).fetchall()
            for rid, site, sched_id, old, sub, item in rows:
                sc = site_of(site)
                if old in TERMINAL:
                    st = old
                else:
                    try:
                        st = _sched_state(sc, sched_id)
                    except Exception as e:
                        log("  [%s] %s: poll failed (%s)" % (name, rid, e)); continue
                    c.execute("UPDATE runs SET state=?, finished=COALESCE(finished,?) WHERE id=?",
                              (st, int(time.time()) if st in TERMINAL else None, rid))
                    c.commit()
                if st in ("REMOVED", "CANCELLED") or st.startswith("CANCELLED"):
                    # cancelled on purpose (by me, the user or a rebalance): recorded quietly, nothing to act on
                    if not c.execute("SELECT 1 FROM events WHERE kind='RUN' AND key=?", ("%s:%s" % (rid, st),)).fetchone():
                        c.execute("INSERT INTO events (ts,project,item,kind,key,msg,acked,ack_note,tell) VALUES "
                                  "(?,?,?,?,?,?,?,?,?)", (int(time.time()), name, item, "RUN", "%s:%s" % (rid, st),
                                  "%s ended %s" % (rid, st), int(time.time()), "cancelled on purpose", "routine"))
                        c.commit()
                elif st in TERMINAL and _runends_on(pr) and (rx_n := _rx().run_end(
                        sys.modules[__name__], c, name, pr, rid, sc, st, item, log, rx_cache)) is not None:
                    # run_ends: sorted from its log; finished cleanly or at its planned limit is acked here with
                    # the deciding line, a broken one is an open RUN event (an unreadable log falls through below)
                    new += rx_n
                elif st in TERMINAL or st == "HELD":
                    # a run of an item ending is always something to act on: a failure to fix, or a smoke test / a
                    # pretraining whose next step waits on it
                    new += add_event(c, name, item, "RUN", "%s:%s" % (rid, st), "%s ended %s: read `site logs %s` and take the item's "
                                     "next step" % (rid, st, rid))
                elif st == "PENDING" and (dead := _dead_chain(c, sc, site, sched_id)):
                    new += add_event(c, name, item, "RUN", "%s:DEADCHAIN" % rid, "%s is PENDING and will never start: %s. "
                                     "Read the parent's log (site logs), then resubmit it without the dead dependency "
                                     "or cancel it" % (rid, dead))
                elif st in ("PENDING", "IDLE", "SUBMITTED") and time.time() - (sub or 0) > _wait_limit(site):
                    # grouped: one event per (project, site, scheduler reason), see _overrun_groups
                    why = _why_waiting(sc, sched_id)
                    pend_groups.setdefault((site, _wait_reason(why)), []).append((rid, item, st, sub, why))
        new += _overrun_groups(c, name, pend_groups)
        if (rx_cache.get("clean_runs") or rx_cache.get("ended_runs")) and _runends_on(pr):
            # one RUN_DONE per entry per pass for the waited batches that closed this pass (muted while its owner works)
            rxm = _rx()
            new += rxm.run_done_events(sys.modules[__name__], c, name, rx_cache.get("clean_runs") or [],
                                       rxm.read_owners(sys.modules[__name__], pr), log,
                                       ended_now=rx_cache.get("ended_runs"))
        if _runends_on(pr):
            # a sweep recorded on an entry whose step waits on it ended: one RUN_DONE (sweeps never reach the run registry)
            try:
                new += _rx().sweep_done_events(sys.modules[__name__], c, name, pr, _rx().read_owners(
                    sys.modules[__name__], pr), log)
            except Exception as e:
                new += add_event(c, name, None, "ALERT", "sweep end check failed", "the sweep end check failed: %r" % e)
        try:
            new += summary_pass(c, name, log)
        except Exception as e:
            new += add_event(c, name, None, "ALERT", "summary pass failed", "the RUN_SUMMARY check failed: %r" % e)
        if _runends_on(pr):
            # run_ends: approved queues (layout read, failed tasks reported, workers resubmitted within their
            # limits) and the wall-time targets' 2x alert
            new += _rx().project_pass(sys.modules[__name__], c, name, pr, outs, log)
    c.commit()
    if beat:
        _beat(project)
    return new


def cmd_digest(a):
    """One screen for a user back after an absence: findings (READY acks), calls only they can make, routine handling
    as counts, items' progress against the last digest, and whether the watch is alive."""
    c = ldb()
    mark = os.path.join(HOME, "digest.%s.json" % a.project)
    try:
        last = json.load(open(mark))
    except (OSError, ValueError):
        last = {}
    now = time.time()
    since = now - 3600 * a.since if a.since else last.get("ts", now - 24 * 3600)
    fmt = lambda t: time.strftime("%m-%d %H:%M", time.localtime(t))
    print("%s since %s (%.1f h)" % (a.project, fmt(since), (now - since) / 3600))
    rows = c.execute("SELECT id,ts,item,kind,msg,acked,ack_note,tell FROM events WHERE (project=? OR project IS NULL) "
                     "AND (ts>=? OR acked>=? OR acked IS NULL) ORDER BY id", (a.project, since, since)).fetchall()
    need = [r for r in rows if r[7] == "needs-user" or r[5] is None]
    find = [r for r in rows if r[7] == "finding" and r[5] and r[5] >= since]
    rout = [r for r in rows if r[7] not in ("needs-user", "finding") and r[5] and r[5] >= since]
    print("\nNeeds you:" + ("" if need else " nothing"))
    for eid, ts, item, kind, msg, acked, note, tell in need:
        print("  E%d %s %s: %s" % (eid, item or "-", kind, (note if acked else "OPEN, not handled yet: " + msg)[:300]))
    print("\nFindings:" + ("" if find else " none"))
    for eid, ts, item, kind, msg, acked, note, tell in find:
        print("  %s %s: %s" % (fmt(acked), item or "-", (note or "")[:400]))
    by = {}
    for r in rout:
        by.setdefault(r[3], []).append(r[0])
    print("\nRoutine, handled: " + (", ".join("%s x%d" % (k, len(v)) for k, v in sorted(by.items())) or "none")
          + ("  (details: site events --all)" if by else ""))
    print("\nItems:")
    snap = {}
    for it in _items(c, a.project, ("active", "held")):
        pr = json.loads(it["progress"]) if it["progress"] else {}
        d, e = pr.get("done"), pr.get("expected")
        snap[it["id"]] = d
        was = (last.get("items") or {}).get(it["id"])
        delta = "" if d is None or was is None else " (+%d)" % (d - was) if d != was else " (no change)"
        print("  %-12s %-6s %s%s" % (it["id"], it["status"], "%s/%s" % (d, e) if e else "-", delta))
    st = stalled_decisions(c, a.project)
    print("\nStalled decisions (approved, nothing started, > %g h):" % stall_hours(a.project) + ("" if st else " none"))
    for r in st:
        print("  " + _stall_msg(*r).split(". Start it")[0])
    Ls = _launches(c, a.project)
    print("\nLaunches:" + ("" if Ls else " none"))
    for L in Ls:
        if L["status"] == "launched" and L["rc"] not in (None, 0):
            st = "FAILED after start (exit %s)" % L["rc"]
        else:
            st = {"queued": "queued", "launching": "launching", "launched": "launched", "failed": "FAILED"}.get(
                L["status"], L["status"])
        when = L["launched_at"] or L["checked"] or L["created"]
        print("  %-24s %-22s %-5s %s %s: %s" % (L["id"], L["item"], L["decision"], st,
                                               time.strftime("%m-%d %H:%M", time.localtime(when)),
                                               (L["msg"] or L["ready_out"] or "")[:160]))
    # the main session's own work calls (the note-only delegation hook, .claude/hooks/delegation_note.py)
    try:
        mw = os.path.join(os.path.expanduser(cfg_projects()[a.project]["local"]), ".claude", ".main_work.jsonl")
        calls = [json.loads(l) for l in open(mw) if l.strip()]
        calls = [x for x in calls if x.get("ts", 0) >= since]
    except (OSError, ValueError, KeyError):
        calls = None
    if calls is not None:
        kinds = {}
        for x in calls:
            kinds[x.get("kind")] = kinds.get(x.get("kind"), 0) + 1
        print("\nMain session work calls (delegation notes): %d%s" % (len(calls), "" if not calls else " (" + ", ".join(
            "%s %d" % kv for kv in sorted(kinds.items())) + ")"))
    try:
        age = (now - int(open(heartbeat_file(a.project)).read().strip())) / 60
    except (OSError, ValueError):
        age = None
    # every active entry's state from live sources (plan.py status), so a stall is visible on return
    try:
        rc, out = _run_local("python3 tools/plan.py status", os.path.expanduser(cfg_projects()[a.project]["local"]), 120)
        print("\nPlan status:\n" + ("\n".join("  " + l for l in out.splitlines()) if not rc else "  unreadable: " + out[-200:]))
    except Exception as e:                      # noqa: BLE001
        print("\nPlan status: unreadable (%s)" % type(e).__name__)
    print("\nWatch: supervisor last pass %s, waiter %s" % ("never" if age is None else "%.0f min ago" % age,
                                                         "armed" if _pid_alive(waiter_file(a.project)) else "NOT armed"))
    if not a.no_mark:
        json.dump({"ts": now, "items": snap}, open(mark, "w"))


def _proc_start(pid):
    """The process's start time (clock ticks since boot, /proc/<pid>/stat field 22): with the pid it identifies
    one process, so a reused pid does not pass for a live waiter."""
    try:
        return open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return "?"


def _pid_alive(path):
    try:
        pid, start = open(path).read().split()
        os.kill(int(pid), 0)
        return _proc_start(int(pid)) == start
    except (OSError, ValueError):
        return False


def cmd_guard(a):
    """For the hooks (~/.claude/hooks/ledger_guard.sh). --stop: exit 2 with the reason on stderr while the session's
    project has an open event, active items and no live supervisor, or no armed waiter. Never skipped for a stop that
    follows another block (stop_hook_active): that exception would silence a reminder for days under /goal. --session-start: print the decisions in force and the items, so they survive compaction."""
    pdir = os.path.realpath(a.project_dir or os.getcwd())
    proj = next((n for n, pr in cfg_projects().items()
                 if os.path.realpath(os.path.expanduser(pr["local"])) in (pdir,) or
                 pdir.startswith(os.path.realpath(os.path.expanduser(pr["local"])) + os.sep)), None)
    with open(os.path.join(HOME, "ledger_guard.log"), "a") as f:
        f.write("%s %s %s\n" % (time.strftime("%m-%d %H:%M:%S"), "stop" if a.stop else "start", proj))
    if not proj or not ledger_on(proj):
        return
    c = ldb()
    items = _items(c, proj, ("active", "held"))
    if a.session_start:
        print("Decisions in force for %s (site decisions --project %s), in the user's words:" % (proj, proj))
        for did, kind, at, quote, covers in c.execute(
                "SELECT id,kind,said_at,quote,covers FROM decisions WHERE project=? AND in_force=1 ORDER BY recorded",
                (proj,)):
            print("  %s %s (%s): \"%s\"%s" % (did, kind, (at or "")[:16], quote, "  covers: " + covers if covers else ""))
        print("Work items: " + "; ".join("%s %s" % (i["id"], i["status"]) for i in items) if items else "No work items.")
        Ls = _launches(c, proj, ("queued", "launching", "launched"))
        if Ls:
            print("Launches (the supervisor starts a queued one when its ready check passes; do not ask the user): "
                  + "; ".join("%s %s (%s)" % (L["id"], L["status"], L["item"]) for L in Ls))
        ev = open_events(c, proj)
        if ev:
            print("Open events (act, then `site ack`): " + "; ".join("E%d %s %s" % (e[0], e[4], e[5][:80]) for e in ev))
        return
    why = []
    # a project with its own plan check (plan_check = true) has its open events checked there, where an event on an
    # entry whose step agent is still working does not block (that agent acks it); blocking here too only bounces the
    # main session while the agent works
    ev = [] if cfg_projects().get(proj, {}).get("plan_check") else open_events(c, proj)
    if ev:
        why.append("open events:\n" + "\n".join("  E%d %s %s: %s" % (e[0], e[4], e[3] or "-", e[5]) for e in ev) +
                   "\nAct on each (a READY one: analyse, write up in its notes file, commit, show the user), then "
                   "`site ack E<n> --note \"what was done\"` (--needs-user WHAT if only the user can decide). A routine "
                   "one (fixed or explained, nothing for the user) needs no status message: one line at most.")
    if any(i["status"] == "active" for i in items):
        try:
            age = time.time() - int(open(heartbeat_file(proj)).read().strip())
        except (OSError, ValueError):
            age = None
        if age is None or age > 2 * SUPERVISE_INTERVAL + 1800:
            why.append("%s has active work items and the supervisor is not running (last pass %s): start it in the "
                       "background, `site supervise --project %s`" % (
                           proj, "never" if age is None else "%.0f min ago" % (age / 60), proj))
        # a project whose own Stop check reads its plan (projects.toml `plan_check = true`, plan_check.py) has
        # its idle work caught there, entry by entry; the item-level proxy here would double it
        idle = [] if cfg_projects().get(proj, {}).get("plan_check") else idle_items(c, proj)
        if idle:
            why.append("active items with nothing running and no recorded wait (an armed waiter is not work):\n" +
                       "\n".join("  %s: %s" % x for x in idle) +
                       "\nFor each: take its next step from the plan (submit, queue a launch, or do the CPU/analysis work "
                       "now), or `site item set %s <id> --waiting \"what it waits on\"` (a named run, the user's answer "
                       "to a question already sent), or `site item done %s <id>` once it is written up." % (proj, proj))
        if not _pid_alive(waiter_file(proj)):
            why.append("no waiter is armed: run `site events --wait --project %s` in the background (it wakes you on "
                       "the next event); this check cannot start a background task itself, so it stays a refusal "
                       "until the turn arms one" % proj)
    if why:
        sys.stderr.write("site ledger: this turn cannot end yet.\n" + "\n".join(why) + "\n")
        raise SystemExit(2)


def cmd_supervise(a):
    if a.launches_only or a.quick:
        # once, the cheap steps only: launches (and with --quick, stalled decisions and RUN_SUMMARY checks); no
        # upkeep, no item checks, no heartbeat (safe beside a running loop)
        c = ldb()
        n = 0
        for name, pr in cfg_projects().items():
            if a.project and name != a.project:
                continue
            n += launch_pass(c, name, pr)
            if a.quick and ledger_on(name) and not pr.get("plan_check"):
                for r in stalled_decisions(c, name):
                    n += add_event(c, name, None, "STALLED", "stalled:" + r[0], _stall_msg(*r))
            if a.quick:
                n += summary_pass(c, name)
        print("  %d new event(s)" % n)
        return
    code = [os.path.abspath(__file__), os.path.join(os.path.dirname(os.path.abspath(__file__)), "site_runends.py")]
    mt = lambda: [os.path.getmtime(f) if os.path.exists(f) else 0 for f in code]
    started = mt()
    while True:
        if not a.once and mt() != started:
            # a long-lived loop keeps running the code it started with, so a fix never goes live
            print("=== %s supervise: site code changed, reloading" % time.strftime("%m-%d %H:%M"), flush=True)
            os.execv(sys.executable, [sys.executable, code[0]] + sys.argv[1:])
        print("=== %s supervise" % time.strftime("%m-%d %H:%M"), flush=True)
        try:
            n = supervise_pass(a.project, log=lambda s: print(s, flush=True), beat=not a.once)
            print("  %d new event(s)" % n, flush=True)
        except Exception as e:                        # one bad pass never kills the loop
            print("  pass failed: %r" % e, flush=True)
            try:
                c = ldb(); add_event(c, None, None, "GUARD", "supervisor pass failed", "supervisor pass failed: %r" % e)
                c.commit()
            except Exception:
                pass
        if a.once:
            return
        time.sleep(a.interval)


# ------------------------------------------------------------------ cli
def main():
    p = argparse.ArgumentParser(prog="site")
    p.add_argument("--timeout", type=int, default=120)
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(fn=cmd_list)

    s = sub.add_parser("status"); s.add_argument("site"); s.set_defaults(fn=cmd_status)

    s = sub.add_parser("sync"); s.add_argument("site"); s.add_argument("project")
    s.add_argument("--branch"); s.add_argument("--allow-dirty", action="store_true")
    s.add_argument("--check", action="store_true", help="print what would run, change nothing")
    s.add_argument("--reset-after-rewrite", action="store_true",
                   help="the branch was history-rewritten (filter-branch dropping vendor/): reset the site checkout "
                        "to it, only if the site has no tracked changes and its head's tree equals a new commit's minus vendor/")
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser("submit"); s.add_argument("site"); s.add_argument("project")
    s.add_argument("job"); s.add_argument("--branch"); s.add_argument("--note")
    s.add_argument("--est-gpu-hours", type=float); s.add_argument("--yes", action="store_true")
    s.add_argument("--disk-gb", type=float, help="the whole batch's disk need in GB; refused when it does not fit "
                   "(need > free - 5 GB); warns under the 60 GB alarm floor")
    s.add_argument("--no-sync", action="store_true",
                   help="submit against whatever is already deployed (A/B at a fixed "
                        "commit, or local trunk has unrelated WIP)")
    s.add_argument("--allow-dirty", action="store_true")
    s.add_argument("--allow-scarce", action="store_true",
                   help="with site=auto: the user asked for a scarce site, let it be picked")
    s.add_argument("--hdr", action="append", metavar="--flag=value",
                   help="override a #SBATCH header value for this submission, e.g. --hdr --mem=8G")
    s.add_argument("--env", action="append", metavar="K=V",
                   help="extra environment for the job (repeatable); --export on SLURM, "
                        "environment= on Condor")
    s.add_argument("--check", action="store_true",
                   help="print the scheduler command (and .sub), submit nothing")
    s.add_argument("--item", help="the work item this job belongs to (required; `site items`)")
    s.add_argument("--allow-stale", action="store_true", help="submit although the site checkout lags the local trunk")
    s.add_argument("--expect", action="append", metavar="KEY=VALUE",
                   help="what the run's RUN_SUMMARY line must say (repeatable), checked by `site supervise`")
    s.add_argument("--allow-unfit", action="store_true",
                   help="submit although the last `site pick` found no site that fits this memory")
    s.set_defaults(fn=cmd_submit)          # `-- <args>` for the script: split in main()

    s = sub.add_parser("decide", help="record a decision of the user's, in their exact words")
    s.add_argument("project")
    s.add_argument("--kind", required=True, help="|".join(DECISION_KINDS))
    s.add_argument("--quote", required=True, help="the user's words, verbatim (checked against the transcripts)")
    s.add_argument("--covers", help="hold/release: item ids or globs; otherwise what it is about")
    s.add_argument("--supersedes", help="decision ids this one replaces")
    s.add_argument("--note"); s.set_defaults(fn=cmd_decide)

    s = sub.add_parser("undecide", help="delete decisions the user said should not be there, on their words")
    s.add_argument("project"); s.add_argument("ids", help="D<n>[,D<m>...]")
    s.add_argument("--quote", required=True, help="the user's words asking for it, verbatim (checked)")
    s.set_defaults(fn=cmd_undecide)

    s = sub.add_parser("decisions", help="the decisions in force")
    s.add_argument("--project"); s.add_argument("--all", action="store_true"); s.set_defaults(fn=cmd_decisions)

    s = sub.add_parser("item", help="add / set / done a work item")
    s.add_argument("action", choices=("add", "set", "done")); s.add_argument("project"); s.add_argument("id")
    s.add_argument("--decision", help="add: the decision approving it")
    s.add_argument("--title"); s.add_argument("--scope", help="what runs, how many, how long")
    s.add_argument("--est-gpu-hours", type=float)
    s.add_argument("--match", help="comma-separated globs naming its units (sweeps, runs)")
    s.add_argument("--check", help="local command (in the project checkout) printing a JSON line "
                                   "{\"units\": {name: {expected, done, active}}, \"alerts\": [...]}")
    s.add_argument("--ready", help="fractions done at which a result is ready to show (default 0.5,1)")
    s.add_argument("--notes", help="file (relative to the checkout) where its results are written up")
    s.add_argument("--waiting", help="set: what this item, with nothing running, waits on: a named run of another item, "
                   "the user's answer to a question sent; \"\" clears it. Lifted by any new run or launch of the item")
    s.set_defaults(fn=cmd_item)

    s = sub.add_parser("items", help="work items (active and held; --all for done)")
    s.add_argument("--project"); s.add_argument("--all", action="store_true")
    s.add_argument("-v", "--verbose", action="store_true"); s.set_defaults(fn=cmd_items)

    s = sub.add_parser("event", help="open one event (ALERT, NOTE...) for a project: --kind --msg [--key --item]")
    s.add_argument("--project", required=True); s.add_argument("--kind", required=True, type=str.upper)
    s.add_argument("--msg", required=True); s.add_argument("--key", help="dedupe key: one open event per key")
    s.add_argument("--item"); s.add_argument("--acked-note", help="open the event already acked, with this note")
    s.set_defaults(fn=cmd_event)

    s = sub.add_parser("events", help="open events (--wait: block until a new one, for a background waiter)")
    s.add_argument("--project"); s.add_argument("--all", action="store_true")
    s.add_argument("--limit", type=int, default=30); s.add_argument("--wait", action="store_true")
    s.add_argument("--new-only", action="store_true", help="--wait: ignore events already open")
    s.add_argument("--debounce", type=int, default=None, metavar="SEC",
                   help="--wait: after a routine event (RUN_DONE, DONE, READY, HANDBACK, RUN, OVERRUN) keep collecting for SEC from "
                        "the first (default 600; 0: return at once; at most 15 min); any other kind returns at once")
    s.set_defaults(fn=cmd_events)

    s = sub.add_parser("ack", help="close events, saying what was done")
    s.add_argument("events", nargs="+"); s.add_argument("--note")
    s.add_argument("--read", metavar="WHAT", help="RUN: what was read instead of `site logs` (a result file, a "
                   "sweep summary); recorded in the note")
    s.add_argument("--no-writeup", metavar="REASON", help="READY: close without a write-up (recorded)")
    s.add_argument("--mute-hours", type=float, help="keep the same event quiet this long (default 2 h; READY/RUN 0)")
    s.add_argument("--needs-user", metavar="WHAT", help="the event left a call only the user can make: listed first in "
                   "`site digest` until they answer (a READY ack is a finding, anything else routine)")
    s.add_argument("--override", metavar="WHY", help="--needs-user although a decision in force answers it (logged)")
    s.set_defaults(fn=cmd_ack)

    s = sub.add_parser("launch", help="queued launches: approved work the supervisor starts once its ready check "
                       "passes (add / list / show / rm)")
    s.add_argument("action", choices=("add", "list", "show", "rm"))
    s.add_argument("project", nargs="?"); s.add_argument("id", nargs="?")
    s.add_argument("--decision", help="add: the user's decision in force (approve/release/scope)")
    s.add_argument("--item", help="add: the active work item it starts")
    s.add_argument("--ready", help="add: local shell command (in the checkout); exit 0 = ready")
    s.add_argument("--run", help="add: the launch command (in the checkout), started detached, output to "
                   "~/.local/share/ccorch/launch/<project>/<id>.log; exit 75 = not started, stays queued")
    s.add_argument("--note"); s.add_argument("--all", action="store_true", help="list: every status")
    s.add_argument("--expect", action="append", metavar="KEY=VALUE", help="add: passed to every run it submits")
    s.add_argument("--project", dest="project_opt", help="list: same as the positional project")
    s.set_defaults(fn=cmd_launch)

    s = sub.add_parser("queue", help="approved queues whose workers the supervisor resubmits within their limits "
                       "while the queue's layout is current (add / list / rm); needs run_ends.enabled")
    s.add_argument("action", choices=("add", "list", "rm"))
    s.add_argument("project", nargs="?"); s.add_argument("id", nargs="?", help="the queue's name ($SCRATCH/lhe_queue/<id>)")
    s.add_argument("--decision", help="add: the user's decision in force that approved it")
    s.add_argument("--item", help="add: the active work item its workers belong to")
    s.add_argument("--site"); s.add_argument("--job", help="add: the worker script (scripts/job_lhe_parts.sh)")
    s.add_argument("--max-workers", type=int, help="add: workers pending or running at most")
    s.add_argument("--wall", type=float, help="add: each worker's wall limit, hours (passed as --time)")
    s.add_argument("--total-hours", type=float, help="add: worker-hours the supervisor may submit in all")
    s.add_argument("--until", help="add: ISO time after which nothing is resubmitted")
    s.set_defaults(fn=lambda a: _rx().cmd_queue(sys.modules[__name__], a))

    s = sub.add_parser("stalled", help="dry run of the supervisor's STALLED rule: approved decisions with nothing "
                       "started under them")
    s.add_argument("--project", required=True); s.add_argument("--hours", type=float, help="default: stall_hours")
    s.set_defaults(fn=cmd_stalled)

    s = sub.add_parser("digest", help="what happened since the user last looked: findings, calls for them, routine "
                       "handling as counts, item progress")
    s.add_argument("--project", required=True)
    s.add_argument("--since", type=float, metavar="HOURS", help="default: since the last digest")
    s.add_argument("--no-mark", action="store_true", help="do not move the 'last digest' mark")
    s.set_defaults(fn=cmd_digest)

    s = sub.add_parser("supervise", help="watch every active work item; record events")
    s.add_argument("--project"); s.add_argument("--once", action="store_true")
    s.add_argument("--launches-only", action="store_true", help="one pass of the launch queue only (no upkeep/checks)")
    s.add_argument("--quick", action="store_true", help="one pass of launches, stalled decisions and RUN_SUMMARY "
                   "checks (no upkeep, no item checks)")
    s.add_argument("--interval", type=int, default=SUPERVISE_INTERVAL); s.set_defaults(fn=cmd_supervise)

    s = sub.add_parser("guard", help="for the hooks: --stop blocks a turn's end on open events / dead supervisor / "
                                     "no waiter; --session-start prints decisions and items")
    s.add_argument("--stop", action="store_true"); s.add_argument("--session-start", action="store_true")
    s.add_argument("--project-dir"); s.set_defaults(fn=cmd_guard)

    s = sub.add_parser("selftest", help="are the guards themselves working")
    s.add_argument("--project"); s.set_defaults(fn=cmd_selftest)

    s = sub.add_parser("pick", help="which site should run this project's next job")
    s.add_argument("project"); s.add_argument("--allow-scarce", action="store_true")
    s.add_argument("--only", nargs="*", help="restrict to these sites")
    s.add_argument("--jobs", "--n", "-n", dest="jobs", type=int, default=1,
                   help="how many jobs the batch has (a sweep's trials count each)")
    s.add_argument("--groups", type=int, help="jobs come in groups that must share a site (sweeps); default: each job alone")
    s.add_argument("--gpus", type=int, help="GPUs per job (default 1)")
    s.add_argument("--mem", help="memory per job, e.g. 8G (default: the project's per-site cluster block)")
    s.add_argument("--cpus", type=int, help="CPUs per job (default: project block or 4)")
    s.add_argument("--hours", type=float, help="expected run time per job (default: my median here)")
    s.add_argument("--gpu-min-mem", dest="gpu_min_mem",
                   help="minimum GPU memory per job, e.g. 24G: HTCondor slots with smaller GPUs are not counted")
    s.add_argument("--no-record", dest="no_record", action="store_true",
                   help="print the plan without recording it as the placement quota (a re-check, not a submission plan)")
    s.add_argument("--json", action="store_true"); s.set_defaults(fn=cmd_pick)

    s = sub.add_parser("poll"); s.add_argument("runs", nargs="*"); s.set_defaults(fn=cmd_poll)

    s = sub.add_parser("runs"); s.add_argument("--project"); s.add_argument("--site")
    s.add_argument("--state"); s.add_argument("--limit", type=int, default=25)
    s.add_argument("--id", help="one run by its exact id, at any age (for scripts; exit 1 when it is not registered)")
    s.set_defaults(fn=cmd_runs)

    s = sub.add_parser("logs"); s.add_argument("run"); s.add_argument("-n", type=int, default=40)
    s.set_defaults(fn=cmd_logs)

    s = sub.add_parser("fetch"); s.add_argument("run")
    s.add_argument("--what", default="tier0")
    s.add_argument("--dir", help="restrict to this directory (relative to the checkout), "
                                 "e.g. the run's own output dir")
    s.set_defaults(fn=cmd_fetch)

    s = sub.add_parser("where"); s.add_argument("what"); s.set_defaults(fn=cmd_where)

    s = sub.add_parser("env"); s.add_argument("site"); s.add_argument("project")
    s.add_argument("--rebuild", action="store_true", help="delete and recreate the .venv")
    s.add_argument("--force-shared", action="store_true",
                   help="allow the recipe to change packages already in a SHARED env")
    s.add_argument("--check", action="store_true", help="print the remote script, run nothing")
    s.set_defaults(fn=cmd_env)

    s = sub.add_parser("run", help="one command on the site's login node, in the "
                       "checkout with sites/activate.sh sourced (sweep generators, "
                       "sweep_manager submit, CPU dry-runs)")
    s.add_argument("site"); s.add_argument("project")
    s.add_argument("cmd", nargs=argparse.REMAINDER, help="after --: the command")
    s.add_argument("--quote", action="store_true", help="shell-quote each argument")
    s.add_argument("--check", action="store_true", help="print the remote command only")
    s.add_argument("--item", action="append", help="work item(s) this command works for (repeatable; '*' = all "
                                                   "active): required when it starts work")
    s.add_argument("--allow-stale", action="store_true", help="with --item: run although the site checkout lags the local trunk")
    s.add_argument("--job", action="store_true", help="run it as a CPU job on the site's cpu partition: a call reads "
                   "the last job's finished output once, else submits one (exit 75 = nothing to read yet)")
    s.add_argument("--recurring", action="store_true", help="--job that also submits the next run when it reads one "
                   "(the supervisor's maintain commands)")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("copy", help="copy project files from one site to another, site to site (never through this laptop)")
    s.add_argument("project"); s.add_argument("src"); s.add_argument("dst")
    s.add_argument("paths", nargs="+", help="relative to the project checkout on the source site (or absolute)")
    s.add_argument("--to", help="destination directory (default: the same relative path)")
    s.add_argument("--overwrite", action="store_true", help="replace files already at the destination")
    s.add_argument("--check", action="store_true", help="show what would be copied, copy nothing")
    s.add_argument("--from-file", help="local list of paths (one per line) relative to the single path given, "
                   "which is then a root directory: exactly those files are copied (tar -T)")
    s.add_argument("--item", action="append", help="work item(s) it is for (required; '*' = all active)")
    s.set_defaults(fn=cmd_copy)

    s = sub.add_parser("reconnect", help="close a site's dead ssh master and open a fresh one (not for 2FA sites)")
    s.add_argument("site"); s.add_argument("--gpu", action="store_true"); s.set_defaults(fn=cmd_reconnect)

    s = sub.add_parser("shell"); s.add_argument("site")
    s.add_argument("--gpu", action="store_true"); s.set_defaults(fn=cmd_shell)

    # Everything after a bare `--` belongs to the job script / remote command,
    # whatever the verb, so options may sit anywhere before it.
    argv = sys.argv[1:]
    tail = []
    if "--" in argv:
        k = argv.index("--")
        argv, tail = argv[:k], argv[k + 1:]
    a = p.parse_args(argv)
    a.args = tail
    if hasattr(a, "cmd") and not a.cmd:
        a.cmd = tail
    elif getattr(a, "fn", None) is cmd_run and isinstance(a.cmd, list) and "--" in sys.argv[1:]:
        a.cmd = a.cmd + ["--"] + tail     # options after <project> (REMAINDER took them): cmd_run reads them
    a.fn(a)


if __name__ == "__main__":
    main()
